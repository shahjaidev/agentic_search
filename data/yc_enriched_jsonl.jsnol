{"id": 23, "name": "BookSolid", "slug": "booksolid", "former_names": "[]", "small_logo_thumb_url": "/company/thumb/missing.png", "website": "http://booksolid.com", "all_locations": "", "long_description": "", "one_liner": "BookSolid is the opentable for tour operators.", "team_size": 0, "industry": "B2B", "subindustry": "B2B -> Retail", "launched_at": 1322045711, "tags": "[\"Marketplace\", \"Travel\"]", "tags_highlighted": "[]", "top_company": 0, "isHiring": 0, "nonprofit": 0, "batch": "Winter 2012", "status": "Inactive", "industries": "[\"B2B\", \"Retail\"]", "regions": "[\"Unspecified\"]", "stage": "Early", "app_video_public": 0, "demo_day_video_public": 0, "app_answers": null, "question_answers": 0, "url": "https://www.ycombinator.com/companies/booksolid", "api": "https://yc-oss.github.io/api/batches/winter-2012/booksolid.json", "founders_summary": "The founding team information for BookSolid is not readily available in the provided data or through initial searches.", "founders_sources": "[\"https://www.ycombinator.com/companies/booksolid\"]", "founders_raw": "{\"founders_summary\": \"The founding team information for BookSolid is not readily available in the provided data or through initial searches.\", \"sources\": [\"https://www.ycombinator.com/companies/booksolid\"], \"confidence\": \"low\", \"notes\": \"The provided JSON data does not contain founder information, and a quick search did not reveal specific details about the founding team. The company is listed as 'Inactive' and launched in Winter 2012.\"}", "product_summary": "BookSolid is a platform designed for tour operators, functioning similarly to OpenTable for restaurants. It aims to streamline booking processes within the travel industry. The company was part of the Winter 2012 Y Combinator batch and is currently marked as inactive. Its industry is categorized as B2B, with a sub-industry of B2B -> Retail, and it operates in the Marketplace and Travel sectors.", "product_sources": "[\"https://www.ycomb