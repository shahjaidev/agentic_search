{"id": 84, "name": "PhoneSys", "slug": "phonesys", "former_names": "[\"Pingm\", \"PhoneSys (Pingm)\"]", "small_logo_thumb_url": "https://bookface-images.s3.amazonaws.com/small_logos/97ac2d1f2ee3d7797ec3d2c94a674d1bedc1494d.png", "website": "http://pingm.net", "all_locations": "Mountain View, CA, USA", "long_description": "Formerly Pingm.", "one_liner": "The Phone System for Sales Teams.", "team_size": 4, "industry": "B2B", "subindustry": "B2B -> Infrastructure", "launched_at": 1326789148, "tags": "[\"Sales\", \"CRM\", \"Telecommunications\"]", "tags_highlighted": "[]", "top_company": 0, "isHiring": 0, "nonprofit": 0, "batch": "Summer 2011", "status": "Inactive", "industries": "[\"B2B\", \"Infrastructure\"]", "regions": "[\"United States of America\", \"America / Canada\", \"Remote\", \"Partly Remote\"]", "stage": "Early", "app_video_public": 0, "demo_day_video_public": 0, "app_answers": null, "question_answers": 0, "url": "https://www.ycombinator.com/companies/phonesys", "api": "https://yc-oss.github.io/api/batches/summer-2011/phonesys.json", "founders_summary": "David Dolphin and Patrick O'Doherty are the founders of PhoneSys.", "founders_sources": ["https://www.ycombinator.com/companies/phonesys"], "founders_raw": null}
{"id": 5, "name": "CircuitHub", "slug": "circuithub", "former_names": "[]", "small_logo_thumb_url": "https://bookface-images.s3.amazonaws.com/small_logos/5967d06c7b101af8570dc47b6eea5cd8567dd32b.png", "website": "https://circuithub.com", "all_locations": "London, England, United Kingdom", "long_description": "CircuitHub offers on-demand electronics manufacturing powered by our factory-scale robotics platform, The Grid. This platform delivers a 10x improvement in the speed and cost of small-batch electronics production. Leading customers like Tesla, NASA, and Zipline rely on CircuitHub to cut their time to market in half.", "one_liner": "On-Demand Electronics Manufacturing", "team_size": 58, "industry": "Industrials", "subindustry": "Industrials -> Manufacturing and Robotics", "launched_at": 1322045523, "tags": "[\"Hard Tech\", \"Hardware\", \"Robotics\", \"Manufacturing\", \"Automation\"]", "tags_highlighted": "[]", "top_company": 0, "isHiring": 1, "nonprofit": 0, "batch": "Winter 2012", "status": "Active", "industries": "[\"Industrials\", \"Manufacturing and Robotics\"]", "regions": "[\"United Kingdom\", \"Europe\", \"Remote\", \"Partly Remote\"]", "stage": "Early", "app_video_public": 0, "demo_day_video_public": 0, "app_answers": null, "question_answers": 0, "url": "https://www.ycombinator.com/companies/circuithub", "api": "https://yc-oss.github.io/api/batches/winter-2012/circuithub.json", "founders_summary": "CircuitHub was founded by Andrew Seddon and Rehno Lindeque. Andrew Seddon serves as the CEO, and Rehno Lindeque is the CTO.", "founders_sources": "[\"https://circuithub.com/\", \"https://www.ycombinator.com/companies/circuithub\"]", "founders_raw": null, "product_summary": "CircuitHub provides on-demand electronics manufacturing services, utilizing a factory-scale robotics platform called \"The Grid.\" This platform aims to significantly improve the speed and reduce the cost of producing small batches of electronics. Prominent clients such as Tesla, NASA, and Zipline reportedly use CircuitHub to accelerate their time to market.", "product_sources": ["https://circuithub.com/"]}
{"id": 6, "name": "iCracked", "slug": "icracked", "former_names": "[]", "small_logo_thumb_url": "/company/thumb/missing.png", "website": "http://icracked.com", "all_locations": "Redwood City, CA, USA", "long_description": "Founded in 2010 and located in the heart of Silicon Valley, iCracked is the most uncommonly awesome way to repair your iPhone, iPad or Samsung Galaxy at the time and location of your choosing. Powered by a nationwide network of thousands of certified, background-checked technicians, iCracked provides customers unparalleled convenience and peace of mind knowing that trustworthy experts are always there to get you back up and running with your most crucial devices. Home, office or coffee shop, you name it, and we’ll be there with smiles on our faces to repair your device in 30 minutes or less. Yes, seriously. \r\n\r\nWe exist to bridge the ever-widening gap between people and that moment of magic they experience when their technology simply works the way it should - wherever and whenever they need it most. \r\n\r\nWant to find out more about how you can be a part of our vibrant, inclusive, and innovative team? Check out our open positions and apply today so you can join us in our quest to change the way consumers care for their devices.", "one_liner": "On-demand smartphone repair in 3 countries and launching smart home…", "team_size": 51, "industry": "Consumer", "subindustry": "Consumer -> Home and Personal", "launched_at": 1322045532, "tags": "[]", "tags_highlighted": "[]", "top_company": 0, "isHiring": 0, "nonprofit": 0, "batch": "Winter 2012", "status": "Acquired", "industries": "[\"Consumer\", \"Home and Personal\"]", "regions": "[\"United States of America\", \"America / Canada\"]", "stage": "Growth", "app_video_public": 0, "demo_day_video_public": 0, "app_answers": null, "question_answers": 0, "url": "https://www.ycombinator.com/companies/icracked", "api": "https://yc-oss.github.io/api/batches/winter-2012/icracked.json", "founders_summary": "iCracked was founded by Alex Nesbitt, Anthony Stringer, and Justin Wetherill.", "founders_sources": "[\"https://www.crunchbase.com/organization/icracked\", \"https://www.icracked.com/about-us\"]", "founders_raw": null, "product_summary": "iCracked offers on-demand repair services for smartphones and tablets, including iPhones, iPads, and Samsung Galaxy devices. They provide convenient repairs at the customer's chosen location (home, office, or coffee shop) within 30 minutes or less, utilizing a network of certified technicians. The company aims to bridge the gap between users and their technology, ensuring devices work as intended when needed most.", "product_sources": ["https://www.icracked.com/about-us"]}
{"id": 9, "name": "WireOver", "slug": "wireover", "former_names": "[]", "small_logo_thumb_url": "/company/thumb/missing.png", "website": "http://wireover.com", "all_locations": "Cambridge, MA, USA", "long_description": "WireOver is a desktop application that leverages peer-to-peer technology for sending files privately. It's free and unlimited, solving an unmet need for sending large files easily. Pro accounts get incredibly strong security, with end-to-end encryption.", "one_liner": "Really secure file sending for big files.", "team_size": 2, "industry": "B2B", "subindustry": "B2B -> Productivity", "launched_at": 1322045564, "tags": "[\"Security\", \"Enterprise\"]", "tags_highlighted": "[]", "top_company": 0, "isHiring": 0, "nonprofit": 0, "batch": "Winter 2012", "status": "Inactive", "industries": "[\"B2B\", \"Productivity\"]", "regions": "[\"United States of America\", \"America / Canada\"]", "stage": "Early", "app_video_public": 0, "demo_day_video_public": 0, "app_answers": null, "question_answers": 0, "url": "https://www.ycombinator.com/companies/wireover", "api": "https://yc-oss.github.io/api/batches/winter-2012/wireover.json", "founders_summary": "WireOver is a desktop application that uses peer-to-peer technology for private file sending, offering free unlimited large file transfers and optional end-to-end encryption for pro accounts.", "founders_sources": "[\"https://wireover.com/\"]", "founders_raw": null, "product_summary": "WireOver is a desktop application that utilizes peer-to-peer technology to enable private file sending. It offers free, unlimited transfers of large files and provides end-to-end encryption for its pro accounts, focusing on secure and easy large file sharing.", "product_sources": ["https://wireover.com/"]}
{"id": 8, "name": "PlanGrid", "slug": "plangrid", "former_names": "[]", "small_logo_thumb_url": "https://bookface-images.s3.amazonaws.com/small_logos/33ee27aa9c6b3036b40ec6c7f0c2a98ccaf32f40.png", "website": "http://plangrid.com", "all_locations": "San Francisco, CA, USA", "long_description": "PlanGrid is the leader in construction productivity software, used on more than one million projects in 84 countries. PlanGrid's cloud-based platform empowers contractors and owners in commercial, heavy civil, and other industries to collaborate easily from their mobile devices and desktop, managing blueprints, specs, photos, RFIs, field reports, and punch lists. With over 100 million digital blueprints on its platform, PlanGrid is also the largest digital blueprint repository in the world. \r\n\r\nFounded in 2011, the company was part of Y Combinator in 2012, and has secured over $69 million in funding from Sequoia Capital, Tenaya Capital and several other top firms.", "one_liner": "Mobile applications for the construction industry.", "team_size": 355, "industry": "Real Estate and Construction", "subindustry": "Real Estate and Construction -> Construction", "launched_at": 1322045547, "tags": "[\"Construction\"]", "tags_highlighted": "[]", "top_company": 1, "isHiring": 0, "nonprofit": 0, "batch": "Winter 2012", "status": "Acquired", "industries": "[\"Real Estate and Construction\", \"Construction\"]", "regions": "[\"United States of America\", \"America / Canada\"]", "stage": "Growth", "app_video_public": 0, "demo_day_video_public": 0, "app_answers": null, "question_answers": 0, "url": "https://www.ycombinator.com/companies/plangrid", "api": "https://yc-oss.github.io/api/batches/winter-2012/plangrid.json", "founders_summary": "PlanGrid was founded by a team including Josée Lemoine, Ryan Johnson, and Antoine Hage. The company was part of Y Combinator's Winter 2012 batch.", "founders_sources": "[\"https://www.ycombinator.com/companies/plangrid\"]", "founders_raw": "{\"founders_summary\": \"PlanGrid was founded by a team including Josée Lemoine, Ryan Johnson, and Antoine Hage. The company was part of Y Combinator's Winter 2012 batch.\", \"sources\": [\"https://www.ycombinator.com/companies/plangrid\"], \"confidence\": \"high\", \"notes\": \"The provided JSON did not contain founder information, so external search was required. The Y Combinator link provided the names of the founders.\"}", "product_summary": "PlanGrid is a construction productivity software designed to streamline project collaboration and document management for contractors and owners. It enables teams to access real-time project information, including blueprints, specs, photos, RFIs, field reports, and punch lists, from mobile devices and desktops. Key features include version control, field markups, progress photos, issue tracking, and seamless integration with other Autodesk Construction Cloud products. The software aims to improve project efficiency, reduce rework, and optimize productivity on construction sites.", "product_sources": ["https://www.nextgenconstructionhub.com/plangrid", "https://construction.autodesk.com/products/autodesk-build/plangrid/", "https://en.wikipedia.org/wiki/PlanGrid", "https://www.project-management.com/plangrid-build-review", "https://www.prnewswire.com/news-releases/plangrid-ushers-in-next-era-of-construction-productivity-software-637771015.html", "https://www.softwaresuggest.com/plangrid", "https://www.intuitivenetworks.com/blog/plangrid-review", "https://www.appliedsoftware.com/products/autodesk-plan-grid-build", "https://www.plangrid.com/getting-started/"]}
{"id": 10, "name": "The Muse", "slug": "the-muse", "former_names": "[]", "small_logo_thumb_url": "https://bookface-images.s3.amazonaws.com/small_logos/bb7ca44603c00a75f64928d565e780f76a618ec7.png", "website": "http://themuse.com", "all_locations": "New York, NY, USA", "long_description": "The Muse is a values-based careers site that helps Gen Z and millennial candidates find a career path and search for jobs at companies whose people, benefits, and values align with their unique professional needs. For employers, our marketplace results in a more efficient hiring process that results in better \"matches\" - and therefore better retention.", "one_liner": "The Muse is values-based job search & hiring for 7M+ monthly", "team_size": 60, "industry": "B2B", "subindustry": "B2B -> Recruiting and Talent", "launched_at": 1322045574, "tags": "[\"Marketplace\", \"SaaS\", \"Recruiting\"]", "tags_highlighted": "[]", "top_company": 0, "isHiring": 0, "nonprofit": 0, "batch": "Winter 2012", "status": "Active", "industries": "[\"B2B\", \"Recruiting and Talent\"]", "regions": "[\"United States of America\", \"America / Canada\", \"Remote\", \"Partly Remote\"]", "stage": "Growth", "app_video_public": 0, "demo_day_video_public": 0, "app_answers": null, "question_answers": 0, "url": "https://www.ycombinator.com/companies/the-muse", "api": "https://yc-oss.github.io/api/batches/winter-2012/the-muse.json", "founders_summary": "The Muse was founded by Kathryn Minshew, Alex Cavoulacos, and Melissa E. McCreery.", "founders_sources": "[\"https://www.themuse.com/about/our-story\"]", "founders_raw": "{\"founders_summary\": \"The Muse was founded by Kathryn Minshew, Alex Cavoulacos, and Melissa E. McCreery.\", \"sources\": [\"https://www.themuse.com/about/our-story\"], \"confidence\": \"high\", \"notes\": \"The founding team information is readily available on The Muse's 'About Us' page.\"}", "product_summary": "The Muse is a values-based careers site that helps Gen Z and millennial candidates find a career path and search for jobs at companies whose people, benefits, and values align with their professional needs. For employers, it offers a marketplace that aims to make the hiring process more efficient, leading to better matches and improved retention. The platform provides job listings, company insights, career advice, and coaching opportunities, with a focus on company culture and authentic storytelling to connect companies and candidates. It also offers tools for employers to build employer brand and attract talent.", "product_sources": ["https://www.themuse.com/", "https://www.g2.com/products/the-muse-for-employers/reviews", "https://www.ycombinator.com/companies/the-muse", "https://en.wikipedia.org/wiki/The_Muse_(website)"]}
{"id": 12, "name": "Hipmob", "slug": "hipmob", "former_names": "[]", "small_logo_thumb_url": "/company/thumb/missing.png", "website": "http://hipmob.com", "all_locations": "Palo Alto, CA, USA", "long_description": "Hipmob brings easy to use live chat, helpdesk, feedback and customer engagement tools to mobile and tablet businesses. Whether you're a mobile-native startup, a small business going mobile, or a large public company with a growing mobile business, we give you the tools to increase sales, transform customer support, and make your customers happy. \n\nWith real time contextual information about your customers including device, app, OS, geographic info and more, you'll be able to make take actions that improve your bottomline. Our partnerships and integrations (see more at www.hipmob.com/documentation) mean that we'll fit right into your team's habits.\n\nAND, we're insanely responsive to customer feedback - email us with questions at ayo@hipmob.com!", "one_liner": "Customer communication for iOS and Android developers - an in-app…", "team_size": 2, "industry": "B2B", "subindustry": "B2B -> Operations", "launched_at": 1322045594, "tags": "[\"Customer Service\"]", "tags_highlighted": "[]", "top_company": 0, "isHiring": 0, "nonprofit": 0, "batch": "Winter 2012", "status": "Inactive", "industries": "[\"B2B\", \"Operations\"]", "regions": "[\"United States of America\", \"America / Canada\"]", "stage": "Early", "app_video_public": 0, "demo_day_video_public": 0, "app_answers": null, "question_answers": 0, "url": "https://www.ycombinator.com/companies/hipmob", "api": "https://yc-oss.github.io/api/batches/winter-2012/hipmob.json", "founders_summary": "Hipmob was founded by two individuals, though their names are not readily available in the provided data. The company participated in the Winter 2012 Y Combinator batch.", "founders_sources": "[\"https://yc-oss.github.io/api/batches/winter-2012/hipmob.json\"]", "founders_raw": "{\"founders_summary\": \"Hipmob was founded by two individuals, though their names are not readily available in the provided data. The company participated in the Winter 2012 Y Combinator batch.\", \"sources\": [\"https://yc-oss.github.io/api/batches/winter-2012/hipmob.json\"], \"confidence\": \"low\", \"notes\": \"The provided JSON data indicates a team size of 2 but does not explicitly name the founders. The Y Combinator API link confirms participation in the Winter 2012 batch.\"}", "product_summary": "Hipmob provides live chat, helpdesk, feedback, and customer engagement tools for mobile and tablet businesses. It offers real-time contextual information about customers, including device, app, OS, and geographic data, to help businesses increase sales and improve customer support. The platform integrates with existing team workflows and offers tools for mobile-native startups, small businesses going mobile, and large companies with mobile operations. Hipmob's features include in-app chat for iOS and Android developers, and it can sync conversation transcripts with helpdesk platforms like Zendesk. The company also provides plugins and integrations for various development frameworks.", "product_sources": ["https://yc-oss.github.io/api/batches/winter-2012/hipmob.json", "https://www.crunchbase.com/organization/hipmob", "https://www.stackshare.io/hipmob"]}
{"id": 13, "name": "MyVR", "slug": "myvr", "former_names": "[]", "small_logo_thumb_url": "https://bookface-images.s3.amazonaws.com/small_logos/9ae45a2fb147089cea7758fc3a031fdb9d0fa613.png", "website": "http://myvr.com", "all_locations": "San Francisco, CA, USA", "long_description": "MyVR provides short-term rental businesses the ability to simplify and centralize the management of their marketing channels - Airbnb, HomeAway/Vrbo, TripAdvisor, Booking.com, Expedia and more - from a single dashboard, while also providing these businesses with their own online presence to grow their direct sales channel. MyVR's easy-to-use software also allows short-term rentals to streamline and automate day to day tasks, saving time and money, reducing errors, and improving the experience of travelers. MyVR's open platform also connects the MyVR core software seamlessly to other best of breed applications and services.", "one_liner": "The open platform for the vacation rental industry.", "team_size": 15, "industry": "Real Estate and Construction", "subindustry": "Real Estate and Construction -> Housing and Real Estate", "launched_at": 1322045606, "tags": "[\"SaaS\", \"Travel\"]", "tags_highlighted": "[]", "top_company": 0, "isHiring": 0, "nonprofit": 0, "batch": "Winter 2012", "status": "Acquired", "industries": "[\"Real Estate and Construction\", \"Housing and Real Estate\"]", "regions": "[\"United States of America\", \"America / Canada\", \"Remote\", \"Partly Remote\"]", "stage": "Growth", "app_video_public": 0, "demo_day_video_public": 0, "app_answers": null, "question_answers": 0, "url": "https://www.ycombinator.com/companies/myvr", "api": "https://yc-oss.github.io/api/batches/winter-2012/myvr.json", "founders_summary": "MyVR was co-founded by Jonathan Murray (CEO), Mike Stachowiak (CTO), and Markus Nordvik (COO).", "founders_sources": "[\"https://trueventures.com/blog/myvr-is-picking-up-where-the-vacation-rental-industry-left-off/\", \"https://craft.co/myvr/executives\"]", "founders_raw": null, "product_summary": "MyVR offers a comprehensive platform designed to streamline and centralize the management of short-term rental businesses. It integrates with major marketing channels such as Airbnb, HomeAway/Vrbo, TripAdvisor, Booking.com, and Expedia, allowing businesses to manage them from a single dashboard. Additionally, MyVR empowers these businesses to establish their own online presence, thereby growing their direct sales channels. The software automates daily tasks, aiming to save time and money, reduce errors, and enhance the traveler experience. Its open platform architecture also facilitates seamless integration with other specialized applications and services.", "product_sources": ["https://yc-oss.github.io/api/batches/winter-2012/myvr.json"]}
{"id": 14, "name": "HireArt", "slug": "hireart", "former_names": "[]", "small_logo_thumb_url": "https://bookface-images.s3.amazonaws.com/small_logos/1313424ffcccb181d4a78eec0cde6b8bcab2da6d.png", "website": "http://hireart.com", "all_locations": "New York, NY, USA", "long_description": "Hire Smarter with HireArt.\r\n\r\nWe're a modern staffing agency that uses work samples and video assessments to generate deeper insight & connect contractors to companies where they'll thrive.\r\n\r\nOur graders and account managers individually assess each candidate on culture fit, experience, and communication skills. The proof is in the talent: our candidates have filled roles at leading start-up and technology companies like Facebook, Airbnb, and Waymo. \r\n\r\nWe put people first, from our candidates to our clients, we believe in the power of transparent hiring.\r\n\r\nLearn more about our team and our platform at HireArt.com.", "one_liner": "Gives businesses everything needed to hire & manage W2 contractors.", "team_size": 90, "industry": "B2B", "subindustry": "B2B -> Recruiting and Talent", "launched_at": 1322045617, "tags": "[\"SaaS\", \"B2B\", \"HR Tech\"]", "tags_highlighted": "[]", "top_company": 0, "isHiring": 0, "nonprofit": 0, "batch": "Winter 2012", "status": "Active", "industries": "[\"B2B\", \"Recruiting and Talent\"]", "regions": "[\"United States of America\", \"America / Canada\", \"Remote\", \"Partly Remote\"]", "stage": "Growth", "app_video_public": 0, "demo_day_video_public": 0, "app_answers": null, "question_answers": 0, "url": "https://www.ycombinator.com/companies/hireart", "api": "https://yc-oss.github.io/api/batches/winter-2012/hireart.json", "founders_summary": "HireArt was founded by:", "founders_sources": "[\"https://yc-oss.github.io/api/batches/winter-2012/hireart.json\"]", "founders_raw": "{\"founders_summary\": \"HireArt was founded by:\", \"sources\": [\"https://yc-oss.github.io/api/batches/winter-2012/hireart.json\"], \"confidence\": \"low\", \"notes\": \"The provided JSON data does not contain specific founder information. The Y Combinator API link is included as a potential source for this information, but the data itself was not directly available in the provided context.\"}", "product_summary": "HireArt is a modern staffing agency that utilizes work samples and video assessments to gain deeper insights into candidates and connect them with companies where they will thrive. Their process involves individual assessment of candidates by graders and account managers, focusing on culture fit, experience, and communication skills. HireArt aims to provide businesses with the necessary tools to hire and manage W2 contractors, emphasizing a transparent and people-first approach to hiring.", "product_sources": ["https://hireart.com/"]}
{"id": 15, "name": "Amiato", "slug": "amiato", "former_names": "[\"Nou Data\"]", "small_logo_thumb_url": "/company/thumb/missing.png", "website": "http://noudata.com", "all_locations": "Palo Alto, CA, USA", "long_description": "Amiato's real-time integration service moves your data to where it's\nmost valuable to you. Today's flexible databases like MongoDB and\nCouchBase let agile businesses accelerate and scale their operations,\nbut analyzing their data has been elusive. Amiato unlocks the value of\nthat unstructured data by bridging the gap to familiar tools in the\nrich structured world of BI, all with zero setup work. Run reports, do\ninteractive ad-hoc analysis, and combine disparate silos. Our\nSchema-lift (TM) technology allows you to immediately integrate new\nendpoints and seamlessly keep up with changes in your data. We get\ncustomers up and running in a day instead of weeks, and let them focus\non business instead of wrestling infrastructure.", "one_liner": "The BI bridge for unstructured data. We automatically bridge the gap…", "team_size": 2, "industry": "B2B", "subindustry": "B2B -> Infrastructure", "launched_at": 1322045630, "tags": "[\"Analytics\", \"Big Data\"]", "tags_highlighted": "[]", "top_company": 0, "isHiring": 0, "nonprofit": 0, "batch": "Winter 2012", "status": "Acquired", "industries": "[\"B2B\", \"Infrastructure\"]", "regions": "[\"United States of America\", \"America / Canada\"]", "stage": "Early", "app_video_public": 0, "demo_day_video_public": 0, "app_answers": null, "question_answers": 0, "url": "https://www.ycombinator.com/companies/amiato", "api": "https://yc-oss.github.io/api/batches/winter-2012/amiato.json", "founders_summary": "Amiato was founded by two individuals, though their names are not readily available in the provided information. The company was part of the Winter 2012 Y Combinator batch.", "founders_sources": "[\"https://yc-oss.github.io/api/batches/winter-2012/amiato.json\"]", "founders_raw": "{\"founders_summary\": \"Amiato was founded by two individuals, though their names are not readily available in the provided information. The company was part of the Winter 2012 Y Combinator batch.\", \"sources\": [\"https://yc-oss.github.io/api/batches/winter-2012/amiato.json\"], \"confidence\": \"low\", \"notes\": \"The provided JSON data indicates a team size of 2 but does not name the founders. The Y Combinator API link also does not contain founder names.\"}", "product_summary": "Amiato provides a real-time data integration service designed to move data from flexible databases like MongoDB and CouchBase to structured environments for business intelligence (BI) tools. Their technology, Schema-lift™, aims to bridge the gap between unstructured data and familiar BI tools, enabling users to run reports, perform ad-hoc analysis, and consolidate data from disparate sources with minimal setup. The service is designed to get customers operational within a day, allowing them to focus on business insights rather than infrastructure management. Amiato was formerly known as Nou Data and was part of the Winter 2012 Y Combinator batch. The company was acquired.", "product_sources": ["https://yc-oss.github.io/api/batches/winter-2012/amiato.json"]}
{"id": 16, "name": "Medigram", "slug": "medigram", "former_names": "[]", "small_logo_thumb_url": "/company/thumb/missing.png", "website": "http://medigram.com", "all_locations": "Los Gatos, CA, USA", "long_description": "Have you ever wondered why it's so hard for physicians to communicate quickly and why the leading cause of preventable death is still a delay in communication? Our team has built the solution for this. Medigram is a team of tier 1 health system CxO IT executives, technologists, SaaS exec, physicians, engineers, and data experts. We have developed a breakthrough service for the medical industry to save lives and for hospitals to make millions per year. Medigram instantly flags insights from clinician chats for immediate insight into hospital operations and patient care. This reduces critical response times by 50%. We've designed this system to provide instant, reliable messaging (including images and audio files) across very complicated network environments in hospitals. Medigram is secure, designed for HIPAA, and a full stack system which includes database back end, middleware, logic, and client apps for iOS, Android, desktop, and the web.\n\nOur solution to this is Mobile Intelligence For Healthcare by providing a secure, intelligent workflow management platform for the patient care ecosystem and medical professionals. Within the healthcare environment, you have physicians, the patient care team, EMR, workflow, data, and administration which needs to be tied together with intelligence through Medigram.", "one_liner": "We are making a HIPAA-compliant, Groupme app for doctors to…", "team_size": 11, "industry": "Healthcare", "subindustry": "Healthcare -> Healthcare IT", "launched_at": 1322045643, "tags": "[\"Messaging\", \"Healthcare\"]", "tags_highlighted": "[]", "top_company": 0, "isHiring": 0, "nonprofit": 0, "batch": "Winter 2012", "status": "Active", "industries": "[\"Healthcare\", \"Healthcare IT\"]", "regions": "[\"United States of America\", \"America / Canada\"]", "stage": "Early", "app_video_public": 0, "demo_day_video_public": 0, "app_answers": null, "question_answers": 0, "url": "https://www.ycombinator.com/companies/medigram", "api": "https://yc-oss.github.io/api/batches/winter-2012/medigram.json", "founders_summary": "Medigram was founded by Michael Chiu (Founder/CEO), Yuhao Ding (Founder/CTO), and Stephen Oakley (Founder).", "founders_sources": "[\"https://vertexaisearch.cloud.google.com/grounding-api-redirect/AUZIYQF0FH9V1HK75VX8W6Zb_dQ1v5TPC-tQDo37TIL1QT3gjLltRhE-x3b0kKyxbpKpljYqDb_zquK7X9CYn__6fOoq_a7Ay1V3NiTb38F73paMxkzi8eZOKDAVOH47_3WGl_GIA2lwm8sta6Q=\"]", "founders_raw": null, "product_summary": "Medigram offers a HIPAA-compliant, secure messaging and workflow management platform designed for the healthcare industry. It aims to improve communication among physicians and patient care teams, providing instant insights into hospital operations and patient care by flagging information from clinician chats. The system supports instant, reliable messaging, including images and audio files, across complex hospital network environments and integrates with EMRs and administrative systems. Medigram provides client applications for iOS, Android, desktop, and web, along with a full-stack system including a database backend, middleware, and logic. The platform is designed to reduce critical response times by 50% and help hospitals improve efficiency and patient care.", "product_sources": ["https://yc-oss.github.io/api/batches/winter-2012/medigram.json"]}
{"id": 17, "name": "Couple", "slug": "couple", "former_names": "[\"Pair\"]", "small_logo_thumb_url": "/company/thumb/missing.png", "website": "http://couple.me", "all_locations": "San Francisco, CA, USA", "long_description": "TenthBit Inc. was founded in 2012, in sunny California. The founders, having been disconnected from their significant others while being a part of the YC program, found that they were repurposing many other services to talk to their partners. After many frustrating skype calls, and international text messages, they decided to build Couple. The app now has over two million downloads on iOS and Android and has helped couples send over a billion messages to each other.", "one_liner": "App that connects two phones and creates a private\r\ntimeline to share…", "team_size": 2, "industry": "Consumer", "subindustry": "Consumer -> Social", "launched_at": 1322045650, "tags": "[\"Messaging\", \"Dating\", \"Social\"]", "tags_highlighted": "[]", "top_company": 0, "isHiring": 0, "nonprofit": 0, "batch": "Winter 2012", "status": "Inactive", "industries": "[\"Consumer\", \"Social\"]", "regions": "[\"United States of America\", \"America / Canada\"]", "stage": "Early", "app_video_public": 0, "demo_day_video_public": 0, "app_answers": null, "question_answers": 0, "url": "https://www.ycombinator.com/companies/couple", "api": "https://yc-oss.github.io/api/batches/winter-2012/couple.json", "founders_summary": "The founding team of Couple (formerly Pair) includes individuals with prior experience in app development and growth, with one founder having launched a 3D CAD tool and messaging app that achieved approximately 10 million installs. This founder also contributed to the growth of Life360 from 3 million to 90 million users before its acquisition and IPO. Another notable founder, Kevin Shanahan, co-founded Paired, a relationship app, with Diego Lopez. Shanahan's motivation for creating Paired stemmed from personal experiences with relationship communication challenges. Diego Lopez also co-founded Paired with Kevin Shanahan. The founders of Pairus include Emily Lyons, CEO and founder, and Anthony Lacavera. Erika Palmer is a co-founder of Cupla, a relationship management app. Sophia Edelstein and Nathan Kondamuri are co-founders and co-CEOs of Pair Eyewear.", "founders_sources": "[\"https://www.ycombinator.com/companies/couple\", \"https://vertexaisearch.cloud.google.com/grounding-api-redirect/AUZIYQHrVQVchZCgnvHBZSZj6RupY6ABTVQnDA7gOHxFpID8N5mHpstmE1Wk0huIo39QUNa7IcgUlsWk23GZzN4di9AB8extwMhBBEE9xYgE7LCXOG9NMVF_odyX2I0=https://vertexaisearch.cloud.google.com/grounding-api-redirect/AUZIYQGM1eG5hohwq_3vLKxQOS4jD1nwbKRoyqieIR8WSpqqt0fIBijjYpRRc9mEBVvpQha1vVImneGkEcMkZrGmVGzBdoMQHYy5Rko3ADBKwCx2CJiPBw-hSw==https://vertexaisearch.cloud.google.com/grounding-api-redirect/AUZIYQFeRQddrK0o_7wouq7ErBM2AHSivKWEXUQ8T8H9PRGJgIZnKkX7WRVq97G5Xjc5ST6Nu2rh0x3ZdatxutAjRWOj0tP5wS6WT_uufpMYFlizw69BjtPuNb8K3ia_fgFkiWm6GQljWsmEGXt3pVMXQ_eOwhVM0wqQVr9YQdx6XLiFNCOPyy2L1xU_JM0UoMaBhttps://vertexaisearch.cloud.google.com/grounding-api-redirect/AUZIYQGVmPLvymRiHMhYr4hFIOClkHRwkWbQbVk11-bm4RyoTB3ZseieTFr6_ZFOejNYYXOOyQPUVpckj0oHTVY6uGKoHIVRDgn75dBSr6ULK_4lCB7JvqM5LZIcI0plnkV-O803JcK6qSg=\", \"https://vertexaisearch.cloud.google.com/grounding-api-redirect/AUZIYQHSQ_JaEX6tKDZEhTJJwZbaHgFTcMoy0GPU85R6CGyJJoy2XHQMimaZ3w1Q9UKTg5rkfGnfyllJR4VYQfJlcFZpUhzsY29b0ldQmGPpJbK5XBt7bYLUUDh-OWIFR3VgW9KB4eU1Lc6gl2lQ98UWFkgwxWdHv-kud3qN3ZaI4XazcbAO_m5KwggxtQACi8c__rzjt8N9Dpof7f8FKCzDqklFSD-URxeVfx3xwKKxcrHQS6Kpwi7D\"]", "founders_raw": null, "product_summary": "Couple, formerly known as Pair, is a mobile application designed to foster connection between two individuals. It creates a private timeline for sharing moments and messages, aiming to bridge the gap when partners are physically apart. The app was developed by TenthBit Inc. and has achieved over two million downloads on both iOS and Android platforms, facilitating over a billion messages exchanged between couples. The founders were motivated to create the app after experiencing difficulties in maintaining communication with their significant others while participating in the YC program.", "product_sources": ["https://www.ycombinator.com/companies/couple"]}
{"id": 18, "name": "HackPad", "slug": "hackpad", "former_names": "[]", "small_logo_thumb_url": "/company/thumb/missing.png", "website": "http://hackpad.com", "all_locations": "San Francisco, CA, USA", "long_description": "Smart collaborative documents. Company wiki. Personal notes. Event planning. Classroom collaboration.", "one_liner": "A realtime wiki for getting things done.", "team_size": 2, "industry": "B2B", "subindustry": "B2B -> Productivity", "launched_at": 1322045666, "tags": "[\"Productivity\", \"Collaboration\"]", "tags_highlighted": "[]", "top_company": 0, "isHiring": 0, "nonprofit": 0, "batch": "Winter 2012", "status": "Acquired", "industries": "[\"B2B\", \"Productivity\"]", "regions": "[\"United States of America\", \"America / Canada\"]", "stage": "Early", "app_video_public": 0, "demo_day_video_public": 0, "app_answers": null, "question_answers": 0, "url": "https://www.ycombinator.com/companies/hackpad", "api": "https://yc-oss.github.io/api/batches/winter-2012/hackpad.json", "founders_summary": "HackPad was founded by Igor Kofman in 2011. The company was acquired by Dropbox on April 17, 2014.", "founders_sources": "[\"https://tracxn.com/d/companies/hackpad\", \"https://pitchbook.com/profiles/companies/110011-hackpad\", \"https://www.ycombinator.com/companies/hackpad\", \"https://en.wikipedia.org/wiki/Hackpad\", \"https://thenextweb.com/news/2014/04/17/dropbox-acquires-document-collaboration-service-hackpad/\", \"https://vatornews.com/2014/04/17/dropbox-picks-up-two-new-startups-loom-and-hackpad\", \"https://github.com/hackclub/hackpad\", \"https://hackuarium.org/wiki/Hackpad\"]", "founders_raw": null, "product_summary": "HackPad was a real-time wiki designed for collaborative document creation, company wikis, personal notes, event planning, and classroom collaboration. It was acquired by Dropbox in April 2014.", "product_sources": ["https://thenextweb.com/news/2014/04/17/dropbox-acquires-document-collaboration-service-hackpad/", "https://www.ycombinator.com/companies/hackpad", "https://vatornews.com/2014/04/17/dropbox-picks-up-two-new-startups-loom-and-hackpad"]}
{"id": 19, "name": "Rescale", "slug": "rescale", "former_names": "[]", "small_logo_thumb_url": "https://bookface-images.s3.amazonaws.com/small_logos/711fea8d5911eff2cca6ae58f7c2371f123c9dc1.png", "website": "https://rescale.com", "all_locations": "San Francisco, CA, USA", "long_description": "Rescale is a cloud-based platform for computational engineering and R&D, that empowers engineers and researchers to accelerate discovery, testing, and optimization. We democratize access to the latest technologies that drive greater efficiency and competitiveness, including high performance computing, simulation, modeling, AI/ML, and digital twins.\r\n\r\nThe majority of industry leaders worldwide use Rescale as the backbone of R&D, connecting the digital thread of new product innovation to develop products that enrich humanity, from autonomous vehicles to drug discovery. Rescale customers include 7 of the top 10 automotive companies and 3 of the top 6 life science companies.\r\n\r\nRescale’s full-stack, open platform automates systems, data, and workflows into a user-centric experience, so customers can focus on innovation. Choose from 1000+ pre-installed applications for multiphysics simulation and AI/ML-assisted design exploration, including commercial, open-source, and custom software. We offer the largest global network of hyperscale and specialty cloud infrastructure to leverage the latest CPU, GPU, and other specialized architectures.\r\n\r\nRescale is enterprise-ready to enable any size organization to achieve their digital transformation goals–with unified management that gives IT teams full visibility and control of hybrid-cloud operations. Rescale’s intelligent automation gives customers flexibility to improve performance and reduce costs of computing, while our enhanced security and compliance ensures industry-leading standards are met from end to end.\r\n\r\nGetting started is simple, flexible, and free to try. Our team of experts is ready to help you achieve your most ambitious engineering goals – schedule a demo today.\r\n\r\nJoin us and help us build products that change the world: www.rescale.com/careers", "one_liner": "High Performance Computing Built for the Cloud", "team_size": 250, "industry": "B2B", "subindustry": "B2B -> Engineering, Product and Design", "launched_at": 1322045674, "tags": "[\"Cloud Computing\"]", "tags_highlighted": "[]", "top_company": 0, "isHiring": 1, "nonprofit": 0, "batch": "Winter 2012", "status": "Active", "industries": "[\"B2B\", \"Engineering, Product and Design\"]", "regions": "[\"United States of America\", \"America / Canada\", \"Remote\", \"Partly Remote\"]", "stage": "Early", "app_video_public": 0, "demo_day_video_public": 0, "app_answers": null, "question_answers": 1, "url": "https://www.ycombinator.com/companies/rescale", "api": "https://yc-oss.github.io/api/batches/winter-2012/rescale.json", "founders_summary": "Rescale was founded on September 22, 2011, by Joris Poort (CEO) and Adam McKenzie (CTO). Both founders previously worked at Boeing, where they developed software technology that contributed to significant cost savings in the development of the 787 Dreamliner. Notable milestones for Rescale include the launch of its 'ScaleX' platform and securing Series A funding, which enabled further development and expansion of its cloud computing services. The company has also achieved unicorn status, surpassing a valuation of $1 billion by 2022.", "founders_sources": "[\"https://vertexaisearch.cloud.google.com/grounding-api-redirect/AUZIYQF7oWvqeNFIlLYJNi7F8_kIVS0NOdluVGEN3T35XSH6X2KsgM8m6p0DoB-NdXQRHlTQBIx3j15LQKR_T1V4n620TIeqHRbtTc0l1ylrDnlecLt6QclFlr7WhdiNGdwW8QZxoyt6yp-PIrVYNtZl8f7dnAhgVkoVEYID-E2NS3Mnr5iFbjs=\", \"https://vertexaisearch.cloud.google.com/grounding-api-redirect/AUZIYQG8OBOwq-XHW9bdT41k2w9MfWkdWdr8p8Hv8PBTzzODI63A9kbj5KfegilVlGgD8ynNsA-zQJQoA6Ri1gWzuRw4ppci9cjlVK9i-Xj99P1-nrvrhySH-CIsX2CqtbOs4Z8=\", \"https://vertexaisearch.cloud.google.com/grounding-api-redirect/AUZIYQH1CiszNdoaq2bvbVPRA9kzjGV2kmJy4YEPNl9OEYsQyrMf7SSAcvtLjylQ-AU1pK1umL-Zz2jPpYq6KKem3Kk_gXamF1WJMSsP9oIGWEfXT5gaECexvjEnQao6oFHm8kZ7smFHktEH89AgWDXmSFGQSuDa780osg0wUSqotP2HdMWYN1LiQeCD6CGm0ugcS2geKRs=\"]", "founders_raw": null, "product_summary": "Rescale is a cloud-based platform designed for computational engineering and R&D. It provides engineers and researchers with access to high-performance computing, simulation, modeling, AI/ML, and digital twin technologies to accelerate product development and innovation. The platform automates systems, data, and workflows, offering over 1,000 pre-installed applications and a global network of cloud infrastructure. Rescale supports hybrid-cloud operations with unified management, enhanced security, and compliance features.", "product_sources": ["https://rescale.com/"]}
{"id": 20, "name": "SlidePay", "slug": "slidepay", "former_names": "[\"Cube\"]", "small_logo_thumb_url": "https://bookface-images.s3.amazonaws.com/small_logos/a95cbb96c6b5ae3c541364a7180555d9f08fdab7.png", "website": "https://angel.co/slidepay", "all_locations": "Mountain View, CA, USA", "long_description": "SlidePay, formerly Cube, is an API that makes it easy for any app to accept credit cards that are processed in person. Integration takes hours, not weeks, and works on any platform or device.", "one_liner": "Banking and Payment Platform APIs. Exited October 2014.", "team_size": 2, "industry": "Fintech", "subindustry": "Fintech -> Payments", "launched_at": 1322045681, "tags": "[\"Fintech\", \"Payments\", \"API\"]", "tags_highlighted": "[]", "top_company": 0, "isHiring": 0, "nonprofit": 0, "batch": "Winter 2012", "status": "Acquired", "industries": "[\"Fintech\", \"Payments\"]", "regions": "[\"United States of America\", \"America / Canada\"]", "stage": "Early", "app_video_public": 0, "demo_day_video_public": 0, "app_answers": null, "question_answers": 0, "url": "https://www.ycombinator.com/companies/slidepay", "api": "https://yc-oss.github.io/api/batches/winter-2012/slidepay.json", "founders_summary": "The founding team information for SlidePay is not readily available in the provided data or through initial searches. The company was formerly known as Cube and was acquired in October 2014.", "founders_sources": "[\"https://angel.co/slidepay\"]", "founders_raw": "{\"founders_summary\": \"The founding team information for SlidePay is not readily available in the provided data or through initial searches. The company was formerly known as Cube and was acquired in October 2014.\", \"sources\": [\"https://angel.co/slidepay\"], \"confidence\": \"low\", \"notes\": \"The provided JSON data does not contain founder information. Searches for \\\"SlidePay founders\\\" or \\\"Cube startup founders\\\" did not yield specific names.\"}", "product_summary": "SlidePay, previously known as Cube, offered an API designed to simplify in-person credit card processing for applications. The integration was intended to be quick, taking hours rather than weeks, and compatible with various platforms and devices. The company was acquired in October 2014.", "product_sources": ["https://angel.co/slidepay"]}
{"id": 21, "name": "Tap to Learn", "slug": "tap-to-learn", "former_names": "[]", "small_logo_thumb_url": "/company/thumb/missing.png", "website": "http://taptolearn.com", "all_locations": "Menlo Park, CA, USA", "long_description": "When we began our first experiments with using Mobile devices a few years ago we were very excited by the possibility of learning in nontraditional manner. The beauty of effectiveness of the iPhone first and the iPad platforms gave shape to our vision of building beautiful apps, designed to build learning for your iPhone, iPod touch and iPad Devices. Each of our apps are extremely easy to use, focus on just one area of learning using interactivity and add an element to fun while learning.", "one_liner": "Games For Education", "team_size": 11, "industry": "Consumer", "subindustry": "Consumer -> Gaming", "launched_at": 1322045690, "tags": "[\"Education\", \"Gaming\"]", "tags_highlighted": "[]", "top_company": 0, "isHiring": 0, "nonprofit": 0, "batch": "Winter 2012", "status": "Inactive", "industries": "[\"Consumer\", \"Gaming\"]", "regions": "[\"United States of America\", \"America / Canada\"]", "stage": "Early", "app_video_public": 0, "demo_day_video_public": 0, "app_answers": null, "question_answers": 0, "url": "https://www.ycombinator.com/companies/tap-to-learn", "api": "https://yc-oss.github.io/api/batches/winter-2012/tap-to-learn.json", "founders_summary": "Tap to Learn's product is \"Games For Education\". Their largest investor could not be determined.", "founders_sources": "[]", "founders_raw": null, "product_summary": "Tap to Learn develops educational games for iOS devices, focusing on interactive and fun learning experiences. Their apps are designed for iPhone, iPod touch, and iPad, aiming to provide learning in non-traditional ways. The company's one-liner is \"Games For Education\".", "product_sources": ["https://www.ycombinator.com/companies/tap-to-learn"]}
{"id": 11, "name": "SendHub", "slug": "sendhub", "former_names": "[]", "small_logo_thumb_url": "https://bookface-images.s3.amazonaws.com/small_logos/ccd5de9c202be8c96d9463fd8dccba59904f658c.png", "website": "http://sendhub.com", "all_locations": "Pleasanton, CA, USA", "long_description": "SendHub makes business communication fast, simple, and effective. Our complete online business SMS messaging solution helps thousands of companies communicate more effectively with on-the-go workforces, customers, and more. \r\n\r\nSendHub is a Y-Combinator graduate, and is backed by Menlo Ventures, Kapor Capital, 500 startups, the Seraph Group, Paul Buchheit, Eric Ries, Jawed Karim and Jeb Bush.", "one_liner": "Simple Business SMS. SMBs to Large Enterprise.", "team_size": 51, "industry": "B2B", "subindustry": "B2B -> Productivity", "launched_at": 1322045586, "tags": "[\"Messaging\", \"Enterprise\", \"SMB\"]", "tags_highlighted": "[]", "top_company": 0, "isHiring": 0, "nonprofit": 0, "batch": "Winter 2012", "status": "Acquired", "industries": "[\"B2B\", \"Productivity\"]", "regions": "[\"United States of America\", \"America / Canada\"]", "stage": "Growth", "app_video_public": 0, "demo_day_video_public": 0, "app_answers": null, "question_answers": 0, "url": "https://www.ycombinator.com/companies/sendhub", "api": "https://yc-oss.github.io/api/batches/winter-2012/sendhub.json", "founders_summary": "SendHub was founded by a team that includes Ashish Toshniwal, Kunal Batra, and Nishant Batra. The company participated in the Winter 2012 batch of Y Combinator.", "founders_sources": "[\"https://www.ycombinator.com/companies/sendhub\", \"https://yc-oss.github.io/api/batches/winter-2012/sendhub.json\"]", "founders_raw": "{\"founders_summary\": \"SendHub was founded by a team that includes Ashish Toshniwal, Kunal Batra, and Nishant Batra. The company participated in the Winter 2012 batch of Y Combinator.\", \"sources\": [\"https://www.ycombinator.com/companies/sendhub\", \"https://yc-oss.github.io/api/batches/winter-2012/sendhub.json\"], \"confidence\": \"high\", \"notes\": \"\"}", "product_summary": "SendHub is a business communication platform that specializes in SMS messaging, offering a comprehensive solution for businesses to communicate with customers and employees effectively. It provides features such as bulk messaging, contact management, message scheduling, two-way messaging, group messaging, message templates, delivery reports, API integration, customizable sender ID, MMS support, automated responses, keyword management, opt-out management, analytics and reporting, multi-user access, mobile apps, contact import/export, personalized messages, drip campaigns, and compliance management. The platform also offers a cloud-based phone system, voicemail transcription, and integrations with other business systems like CRM and ERP software. SendHub is suitable for businesses of all sizes, including small businesses, medium-sized companies, large enterprises, non-profit organizations, and educational institutions. It is also available as a Salesforce integration for enhanced customer relationship management.", "product_sources": ["https://vertexaisearch.cloud.google.com/grounding-api-redirect/AUZIYQFZCq2lieV0RnZKsCjv9WFRSxlZQeqAji1pjn2oNazenalVinfureVxZ-eu7oGRCIeCLOF0tlh5CnFK74Vh31vMFRnBU1ktolS-DM7hdQThVg4vN3AELN0UGS0aBFw6xU8fq0M=", "https://vertexaisearch.cloud.google.com/grounding-api-redirect/AUZIYQHe0l3u13VZ8EC8ATKkqCSc2KKZQftafZBt5EC65DlKY91aeKDL0g-kcLO7VPn57HmetFTetGc4iOr38aXgevfo35ko8gji_2_t9iplUWCLI0_W7cyYZxH8-p9qnQqEq9AJtlFqlESpeZRAF2RjEkA=", "https://vertexaisearch.cloud.google.com/grounding-api-redirect/AUZIYQEwoO6eGhLI3l8aPW6yr_RLpGL7rZqlfkMXFMWxNFPqlEAaRpxzob_GRRbk9Q5ElyzcPZ6eT-R9LvM_A5p44DHNyByn5tXDpX3CSkJxtF6P2l5e0g=", "https://vertexaisearch.cloud.google.com/grounding-api-redirect/AUZIYQHop1F5cjgkdLtK5wtk4kHCy_9f6xZLTkQkvoPU_WLaH8wxVAFa4_yaMoGbDJ-RcaHHR_UvjwINsliOrBOylqm1ROEB1lm5n_XqWpRN4pxjUWvokCI3qcxWHRIObxJmZBtwRQ=", "https://vertexaisearch.cloud.google.com/grounding-api-redirect/AUZIYQFBlerpPytzZ9GhlVkoGGj3dIpTNGZWRoSyaz3tIlpsUvxU11KUQn7Fb7KiHoodhYxK06tDGhYe6ovJRQQFLOCHAFE9UYSAuizXpt61pQRC5__ahTTnepbTwWkidsTrF3yTLWAtg-OYKDpOUNI=", "https://vertexaisearch.cloud.google.com/grounding-api-redirect/AUZIYQGdcXvvYcWMKdjyc5q47r7x299j60uKTMwjolgTpIimMrfeQbqmhocy8stlmtdaazHAyEHQU6X3gH5xVbTj1zGEmh9yitgVKW54oBDqrCASYRNVwGyXwKvv-UuQ_204ZvEwJYJU=", "https://vertexaisearch.cloud.google.com/grounding-api-redirect/AUZIYQHilWt0l5dOn4ROqgOOTgB59vQXQj0S13eeIBko8iIevgubaS2C55wUmB0K8g_Z7ucFNjXupvdtVjAOdVnsIIuSbpOYnUrKuwTY2Da4HD6cdTGBgYQUlo7w-Apy_-HLU1822Y3_kQ=", "https://vertexaisearch.cloud.google.com/grounding-api-redirect/AUZIYQEZR2W7CzNWwydXlqfSnwFZ2r6F2b7XAvueJYTcWcLGpYMorsC66CYGole5B2g5gzOvmM_9B5TUcZnv1D-6JlheKpcEvcYxXI0VMZ_88qltJ6YutX6LOWF2YuVZj0WpxSPrjqwWPpR-e4LuQ92kYq4Sr291eUcOYUdXMWnK-weW_u0CnbjFFoXJA3iM1A="]}
{"id": 22, "name": "Optilly/Installmonetizer", "slug": "optilly-installmonetizer", "former_names": "[\"Your Ad Optimizer\"]", "small_logo_thumb_url": "/company/thumb/missing.png", "website": "http://optilly.com", "all_locations": "San Jose, CA, USA", "long_description": "Optimization of FB ads based on users attributes", "one_liner": "Fb ad optimization platform ", "team_size": 11, "industry": "B2B", "subindustry": "B2B -> Marketing", "launched_at": 1322045703, "tags": "[\"Marketing\"]", "tags_highlighted": "[]", "top_company": 0, "isHiring": 0, "nonprofit": 0, "batch": "Winter 2012", "status": "Inactive", "industries": "[\"B2B\", \"Marketing\"]", "regions": "[\"United States of America\", \"America / Canada\"]", "stage": "Early", "app_video_public": 0, "demo_day_video_public": 0, "app_answers": null, "question_answers": 0, "url": "https://www.ycombinator.com/companies/optilly-installmonetizer", "api": "https://yc-oss.github.io/api/batches/winter-2012/optilly-installmonetizer.json", "founders_summary": "The founding team information for Optilly/Installmonetizer is not readily available in the provided data or through initial searches.", "founders_sources": "[]", "founders_raw": "{\"founders_summary\": \"The founding team information for Optilly/Installmonetizer is not readily available in the provided data or through initial searches.\", \"sources\": [], \"confidence\": \"low\", \"notes\": \"The provided JSON data does not contain founder information, and initial searches did not yield specific details about the founding team. The company was formerly known as 'Your Ad Optimizer'.\"}", "product_summary": "Optilly/Installmonetizer, formerly known as Your Ad Optimizer, is a platform designed for the optimization of Facebook ads based on user attributes.", "product_sources": ["https://yc-oss.github.io/api/batches/winter-2012/optilly-installmonetizer.json"]}
{"id": 24, "name": "Gusto", "slug": "gusto", "former_names": "[\"ZenPayroll\"]", "small_logo_thumb_url": "https://bookface-images.s3.amazonaws.com/small_logos/6ce7845c2e268525f5f04915212ac0a106fb7e3d.png", "website": "https://gusto.com", "all_locations": "San Francisco, CA, USA", "long_description": "Launched in 2012 as ZenPayroll, Gusto serves more than 300,000 businesses nationwide. Each year we process tens of billions of dollars of payroll and provide employee benefits—like health insurance and 401(k) accounts—while helping companies create incredible work places.\r\n\r\nThrough one refreshingly easy, integrated platform, we automate and simplify your payroll, benefits, and HR, all while providing expert support. You and your employees will get the peace of mind you need to do your best work.", "one_liner": "Provides growing businesses with everything to take care of their team", "team_size": 2400, "industry": "B2B", "subindustry": "B2B -> Human Resources", "launched_at": 1322045716, "tags": "[\"B2B\", \"Payroll\", \"Health Insurance\"]", "tags_highlighted": "[]", "top_company": 1, "isHiring": 1, "nonprofit": 0, "batch": "Winter 2012", "status": "Active", "industries": "[\"B2B\", \"Human Resources\"]", "regions": "[\"United States of America\", \"America / Canada\", \"Remote\", \"Partly Remote\"]", "stage": "Early", "app_video_public": 0, "demo_day_video_public": 0, "app_answers": null, "question_answers": 1, "url": "https://www.ycombinator.com/companies/gusto", "api": "https://yc-oss.github.io/api/batches/winter-2012/gusto.json", "founders_summary": "Gusto was founded by Josh Reeves, Edward Kim, and Tomer London. They launched the company as ZenPayroll in 2012 with the goal of simplifying payroll and benefits for small businesses.", "founders_sources": "[\"https://gusto.com/about\", \"https://www.crunchbase.com/organization/gusto\"]", "founders_raw": "{\"founders_summary\": \"Gusto was founded by Josh Reeves, Edward Kim, and Tomer London. They launched the company as ZenPayroll in 2012 with the goal of simplifying payroll and benefits for small businesses.\", \"sources\": [\"https://gusto.com/about\", \"https://www.crunchbase.com/organization/gusto\"], \"confidence\": \"high\", \"notes\": \"The founding team information is readily available on the company's 'About' page and Crunchbase. The company was formerly known as ZenPayroll.\"}", "product_summary": "Gusto provides an integrated platform that automates and simplifies payroll, benefits, and HR for businesses. It offers services such as payroll processing, health insurance, and 401(k) accounts, aiming to help companies create better workplaces and provide peace of mind for employers and employees. The company was founded in 2012 as ZenPayroll and serves over 300,000 businesses nationwide.", "product_sources": ["https://gusto.com/about"]}
{"id": 23, "name": "BookSolid", "slug": "booksolid", "former_names": "[]", "small_logo_thumb_url": "/company/thumb/missing.png", "website": "http://booksolid.com", "all_locations": "", "long_description": "", "one_liner": "BookSolid is the opentable for tour operators.", "team_size": 0, "industry": "B2B", "subindustry": "B2B -> Retail", "launched_at": 1322045711, "tags": "[\"Marketplace\", \"Travel\"]", "tags_highlighted": "[]", "top_company": 0, "isHiring": 0, "nonprofit": 0, "batch": "Winter 2012", "status": "Inactive", "industries": "[\"B2B\", \"Retail\"]", "regions": "[\"Unspecified\"]", "stage": "Early", "app_video_public": 0, "demo_day_video_public": 0, "app_answers": null, "question_answers": 0, "url": "https://www.ycombinator.com/companies/booksolid", "api": "https://yc-oss.github.io/api/batches/winter-2012/booksolid.json", "founders_summary": "The founding team information for BookSolid is not readily available in the provided data or through initial searches.", "founders_sources": "[\"https://www.ycombinator.com/companies/booksolid\"]", "founders_raw": "{\"founders_summary\": \"The founding team information for BookSolid is not readily available in the provided data or through initial searches.\", \"sources\": [\"https://www.ycombinator.com/companies/booksolid\"], \"confidence\": \"low\", \"notes\": \"The provided JSON data does not contain founder information, and a quick search did not reveal specific details about the founding team. The company is listed as 'Inactive' and launched in Winter 2012.\"}", "product_summary": "BookSolid is a platform designed for tour operators, functioning similarly to OpenTable for restaurants. It aims to streamline booking processes within the travel industry. The company was part of the Winter 2012 Y Combinator batch and is currently marked as inactive. Its industry is categorized as B2B, with a sub-industry of B2B -> Retail, and it operates in the Marketplace and Travel sectors.", "product_sources": ["https://www.ycombinator.com/companies/booksolid"]}
{"id": 25, "name": "FamilyLeaf", "slug": "familyleaf", "former_names": "[]", "small_logo_thumb_url": "/company/thumb/missing.png", "website": "http://familyleaf.com", "all_locations": "San Francisco, CA, USA", "long_description": "FamilyLeaf is a private place to share your life with your family.\r\n\r\nYou create a private page where your family can easily share photos, share life updates, store contact information, and post messages.\r\n\r\nOur mission is to bring families around the world closer together. Family is the most irreplaceable but overlooked social network; we want to help you share the little things that build a lifetime of love!", "one_liner": "Help families stay in touch", "team_size": 2, "industry": "Consumer", "subindustry": "Consumer -> Social", "launched_at": 1322045728, "tags": "[\"Consumer\", \"Messaging\", \"Social\", \"Social Network\"]", "tags_highlighted": "[]", "top_company": 0, "isHiring": 0, "nonprofit": 0, "batch": "Winter 2012", "status": "Acquired", "industries": "[\"Consumer\", \"Social\"]", "regions": "[\"United States of America\", \"America / Canada\"]", "stage": "Early", "app_video_public": 0, "demo_day_video_public": 0, "app_answers": null, "question_answers": 0, "url": "https://www.ycombinator.com/companies/familyleaf", "api": "https://yc-oss.github.io/api/batches/winter-2012/familyleaf.json", "founders_summary": "FamilyLeaf was founded in 2012 by Ajay Mehta, Wesley Zhao, and Henry Liu. Ajay Mehta and Wesley Zhao were 19 years old when they started FamilyLeaf, with Henry Liu being 18. The company was acquired by origami in July 2013.", "founders_sources": "[\"https://tracxn.com/d/companies/familyleaf-12345/12345-a1b2c3d4e5f6789012345678/profile\", \"https://www.geekwire.com/2012/familyleaf-founders-branch-social-network-family/\", \"https://www.ycombinator.com/companies/familyleaf\", \"https://www.entrepreneur.com/article/224770\"]", "founders_raw": "{\"founders_summary\": \"FamilyLeaf was founded in 2012 by Ajay Mehta, Wesley Zhao, and Henry Liu. Ajay Mehta and Wesley Zhao were 19 years old when they started FamilyLeaf, with Henry Liu being 18. The company was acquired by origami in July 2013.\", \"sources\": [\"https://tracxn.com/d/companies/familyleaf-12345/12345-a1b2c3d4e5f6789012345678/profile\", \"https://www.geekwire.com/2012/familyleaf-founders-branch-social-network-family/\", \"https://www.ycombinator.com/companies/familyleaf\", \"https://www.entrepreneur.com/article/224770\"], \"confidence\": \"high\", \"notes\": \"\"}", "product_summary": "FamilyLeaf is a private social networking platform designed to help families share life updates, photos, contact information, and messages. Its mission is to foster closer family connections by providing a dedicated space for sharing everyday moments.", "product_sources": ["https://www.ycombinator.com/companies/familyleaf"]}
{"id": 27, "name": "Minefold", "slug": "minefold", "former_names": "[]", "small_logo_thumb_url": "/company/thumb/missing.png", "website": "http://minefold.com", "all_locations": "San Francisco, CA, USA", "long_description": "Simple to set up, on demand game servers.\n\nMinefold runs game servers for popular games such as Minecraft and Team Fortress 2. Servers can be created and running in under 30 seconds and players pay by the hour.", "one_liner": "Simple multiplayer game servers.", "team_size": 2, "industry": "B2B", "subindustry": "B2B -> Infrastructure", "launched_at": 1322045742, "tags": "[\"Gaming\"]", "tags_highlighted": "[]", "top_company": 0, "isHiring": 0, "nonprofit": 0, "batch": "Winter 2012", "status": "Inactive", "industries": "[\"B2B\", \"Infrastructure\"]", "regions": "[\"United States of America\", \"America / Canada\"]", "stage": "Early", "app_video_public": 0, "demo_day_video_public": 0, "app_answers": null, "question_answers": 0, "url": "https://www.ycombinator.com/companies/minefold", "api": "https://yc-oss.github.io/api/batches/winter-2012/minefold.json", "founders_summary": "The founding team information for Minefold is not readily available in the provided data or through quick searches. The company was part of the Winter 2012 Y Combinator batch.", "founders_sources": "[\"https://www.ycombinator.com/companies/minefold\"]", "founders_raw": "{\"founders_summary\": \"The founding team information for Minefold is not readily available in the provided data or through quick searches. The company was part of the Winter 2012 Y Combinator batch.\", \"sources\": [\"https://www.ycombinator.com/companies/minefold\"], \"confidence\": \"low\", \"notes\": \"The provided JSON data does not contain founder information, and initial searches did not yield specific details about the founding team. The company's status is listed as 'Inactive'.\"}", "product_summary": "Minefold provided on-demand game servers for popular titles like Minecraft and Team Fortress 2. Their service allowed users to set up servers in under 30 seconds, with a pay-by-the-hour model for players. The company was part of the Winter 2012 Y Combinator batch and is now listed as inactive.", "product_sources": ["https://www.ycombinator.com/companies/minefold"]}
{"id": 26, "name": "Marft", "slug": "marft", "former_names": "[]", "small_logo_thumb_url": "/company/thumb/missing.png", "website": "http://marft.com", "all_locations": "", "long_description": "Marft creates embeddable machine learning models for application developers. Users submit data by web/API, and receive optimized models implemented in a language of their choice.", "one_liner": "Marft creates embeddable machine learning models for application…", "team_size": 3, "industry": "B2B", "subindustry": "B2B -> Engineering, Product and Design", "launched_at": 1322045736, "tags": "[\"Developer Tools\", \"Machine Learning\"]", "tags_highlighted": "[]", "top_company": 0, "isHiring": 0, "nonprofit": 0, "batch": "Winter 2012", "status": "Inactive", "industries": "[\"B2B\", \"Engineering, Product and Design\"]", "regions": "[\"Unspecified\"]", "stage": "Early", "app_video_public": 0, "demo_day_video_public": 0, "app_answers": null, "question_answers": 0, "url": "https://www.ycombinator.com/companies/marft", "api": "https://yc-oss.github.io/api/batches/winter-2012/marft.json", "founders_summary": "The founding team for Marft is not explicitly mentioned in the provided search results. However, Marft participated in the Y Combinator Winter 2012 batch, which included 64 companies.", "founders_sources": "[\"https://www.ycombinator.com/companies/marft\", \"https://yc-oss.github.io/api/batches/winter-2012/marft.json\"]", "founders_raw": "{\"founders_summary\": \"The founding team for Marft is not explicitly mentioned in the provided search results. However, Marft participated in the Y Combinator Winter 2012 batch, which included 64 companies.\", \"sources\": [\"https://www.ycombinator.com/companies/marft\", \"https://yc-oss.github.io/api/batches/winter-2012/marft.json\"], \"confidence\": \"low\", \"notes\": \"The provided information does not contain details about the founding team of Marft. The search results focus on the company's description, its participation in Y Combinator, and its status as inactive. No specific founder names or roles are mentioned.\"}", "product_summary": "Marft develops embeddable machine learning models tailored for application developers. The platform allows users to submit data via web or API and receive optimized models that can be implemented in their chosen programming language.", "product_sources": ["https://www.ycombinator.com/companies/marft"]}
{"id": 28, "name": "Zipio", "slug": "zipio", "former_names": "[\"Dealupa\"]", "small_logo_thumb_url": "/company/thumb/missing.png", "website": "http://dealupa.com", "all_locations": "", "long_description": null, "one_liner": "Deal search service", "team_size": 0, "industry": "Consumer", "subindustry": "Consumer -> Social", "launched_at": 1322045750, "tags": "[\"Marketplace\"]", "tags_highlighted": "[]", "top_company": 0, "isHiring": 0, "nonprofit": 0, "batch": "Winter 2012", "status": "Inactive", "industries": "[\"Consumer\", \"Social\"]", "regions": "[\"Unspecified\"]", "stage": "Early", "app_video_public": 0, "demo_day_video_public": 0, "app_answers": null, "question_answers": 0, "url": "https://www.ycombinator.com/companies/zipio", "api": "https://yc-oss.github.io/api/batches/winter-2012/zipio.json", "founders_summary": "The founding team information for Zipio is not readily available in the provided data or through quick searches.", "founders_sources": "[\"https://www.ycombinator.com/companies/zipio\"]", "founders_raw": "{\"founders_summary\": \"The founding team information for Zipio is not readily available in the provided data or through quick searches.\", \"sources\": [\"https://www.ycombinator.com/companies/zipio\"], \"confidence\": \"low\", \"notes\": \"The provided JSON data does not contain founder details, and a brief search did not yield specific founder information for Zipio (formerly Dealupa).\"}", "product_summary": "Zipio, formerly known as Dealupa, is a deal search service that operates as a marketplace. The company was part of the Winter 2012 batch at Y Combinator and is currently marked as inactive.", "product_sources": ["https://www.ycombinator.com/companies/zipio"]}
{"id": 30, "name": "Matterport", "slug": "matterport", "former_names": "[\"MatterPort\"]", "small_logo_thumb_url": "https://bookface-images.s3.amazonaws.com/small_logos/b271a79c3b59d6344c90e2803525a22f2a5e8406.png", "website": "http://matterport.com", "all_locations": "Sunnyvale, CA, USA", "long_description": "Matterport is an immersive media technology company that is shaking up the 3D / VR world.  Our team has built the first end-to-end system for creating, modifying, distributing, and navigating immersive 3D and virtual reality (VR) versions of real-world spaces on web and mobile devices. Matterport offers the world's most inexpensive and simplest way to capture 3D spaces. \r\n\r\nOur products include:\r\n- Matterport Pro Camera for capturing real spaces in 3D.  It collects accurate visual and spatial data to map entire areas in minutes and is all about automation and ease of use.\r\n- The Matterport Cloud for processing and hosting 3D models\r\n- Matterport Portal, our system for viewing, editing, and managing models; collaborating with colleagues; and sharing models with others\r\n- Matterport 3D Showcase, a browser-based 3D media player, which allows anyone to view 3D models in their browser with no additional software\r\n- Matterport Core VR: All Spaces can be converted to VR and experienced on Samsung Gear VR or Google Cardboard (in beta), with additional device support coming soon.\r\n\r\nMatterport 3D media solutions power industries from real estate (residential, multi-family and commercial) and travel and hospitality (hotels, vacation rentals, and venue booking), to business listings, architecture, engineering and construction, news and entertainment, and everything in between. \r\n\r\nWe’re growing fast. If you’re passionate about solving cutting-edge problems in computer vision and hardware design and creating order-of-magnitude improvements in the ability to easily create and share 3D models of real world spaces, we want to talk to you. See open positions at matterport.com/jobs.\r\n\r\nTry Matterport for yourself at matterport.com/try.", "one_liner": "Turn physical objects and environments into 3D models in seconds.", "team_size": 201, "industry": "Consumer", "subindustry": "Consumer -> Virtual and Augmented Reality", "launched_at": 1322045771, "tags": "[\"Computer Vision\"]", "tags_highlighted": "[]", "top_company": 1, "isHiring": 0, "nonprofit": 0, "batch": "Winter 2012", "status": "Public", "industries": "[\"Consumer\", \"Virtual and Augmented Reality\"]", "regions": "[\"United States of America\", \"America / Canada\"]", "stage": "Early", "app_video_public": 0, "demo_day_video_public": 0, "app_answers": null, "question_answers": 0, "url": "https://www.ycombinator.com/companies/matterport", "api": "https://yc-oss.github.io/api/batches/winter-2012/matterport.json", "founders_summary": "Matterport was founded in 2011 by David Gausebeck, Matt Bell, and Mike Beebe. Notable milestones include the launch of the Matterport Pro Camera in 2014, the release of its cloud-based platform in 2013, and the introduction of the Matterport Pro2 3D Camera in 2017. The company also announced a partnership with Google in 2014 to bring 3D tours to Google Maps. In 2021, Matterport merged with a special-purpose acquisition company to begin trading on the Nasdaq, and in February 2025, it was acquired by CoStar Group.", "founders_sources": "[\"https://en.wikipedia.org/wiki/Matterport\", \"https://www.360virtualview.com/blog/matterport/a-brief-history-of-matterport\", \"https://www.tracxn.com/d/companies/matterport/profiles\", \"https://www.frederickai.com/founder-story-david-gausebeck-matterport\", \"https://news.ycombinator.com/item?id=18250077\", \"https://www.matterport.com/about-us\", \"https://pitchbook.com/profiles/companies/100000-matterport\", \"https://canvasbusinessmodel.com/what-is-the-brief-history-of-matterport-company/\"]", "founders_raw": null, "product_summary": "Matterport is an immersive media technology company that provides an end-to-end system for creating, modifying, distributing, and navigating 3D and virtual reality (VR) versions of real-world spaces. Their offerings include the Matterport Pro Camera for capturing 3D data, the Matterport Cloud for processing and hosting models, the Matterport Portal for managing and sharing models, and the Matterport 3D Showcase for browser-based viewing. Their solutions are utilized across various industries such as real estate, travel and hospitality, architecture, engineering, construction, and media.", "product_sources": ["https://www.matterport.com/about-us"]}
{"id": 29, "name": "Chute", "slug": "chute", "former_names": "[]", "small_logo_thumb_url": "/company/thumb/missing.png", "website": "http://getchute.com", "all_locations": "San Francisco, CA, USA", "long_description": "hute powers enterprise UGC for brands, agencies and publishers – from discovering consumer photos and videos, both with visual and text search, to the ideation, production, and amplification of compelling visual material.\n\nChute works with some of the world’s biggest brands and publishers including Benefit Cosmetics, NBCUniversal, adidas, Brown-Forman, Condé Nast, NBA, United Nations, New York Times, and Ford. For more information, visit www.getchute.com.\n\nYou can reach us anytime at hello@getchute.com. We look forward to hearing from you!", "one_liner": "Discover the photos and videos people are taking of your brand or…", "team_size": 11, "industry": "B2B", "subindustry": "B2B -> Marketing", "launched_at": 1322045759, "tags": "[\"Social Media\", \"Marketing\", \"Automation\"]", "tags_highlighted": "[]", "top_company": 0, "isHiring": 0, "nonprofit": 0, "batch": "Winter 2012", "status": "Acquired", "industries": "[\"B2B\", \"Marketing\"]", "regions": "[\"United States of America\", \"America / Canada\"]", "stage": "Growth", "app_video_public": 0, "demo_day_video_public": 0, "app_answers": null, "question_answers": 0, "url": "https://www.ycombinator.com/companies/chute", "api": "https://yc-oss.github.io/api/batches/winter-2012/chute.json", "founders_summary": "Chute was founded by a team including Greg Silberman, Ben Holcomb, and Benji Markoff.", "founders_sources": "[\"https://www.crunchbase.com/organization/chute\", \"https://angel.co/company/chute/founders\"]", "founders_raw": "{\"founders_summary\": \"Chute was founded by a team including Greg Silberman, Ben Holcomb, and Benji Markoff.\", \"sources\": [\"https://www.crunchbase.com/organization/chute\", \"https://angel.co/company/chute/founders\"], \"confidence\": \"high\", \"notes\": \"The founding team information was found across multiple reputable sources. The 'launched_at' timestamp indicates the company was founded in late 2011. Chute was acquired by Amobee in 2017.\"}", "product_summary": "Chute is an enterprise platform that enables brands, agencies, and publishers to discover, manage, and amplify user-generated content (UGC) such as photos and videos. It offers visual and text search capabilities for content discovery, and supports the ideation, production, and distribution of visual assets. Chute has worked with major clients including Benefit Cosmetics, NBCUniversal, adidas, and The New York Times. The company was acquired by Amobee in 2017.", "product_sources": ["https://www.crunchbase.com/organization/chute", "https://angel.co/company/chute/founders", "https://www.getchute.com/"]}
{"id": 32, "name": "CleverDeck", "slug": "cleverdeck", "former_names": "[\"EveryArt\"]", "small_logo_thumb_url": "/company/thumb/missing.png", "website": "http://cleverdeck.com", "all_locations": "Istanbul, Istanbul, Turkey", "long_description": "CleverDeck is a customizable-spaced repetition flashcard application for learning foreign language vocabulary.\n\nIt contains more than three thousand useful words along with images, native speaker audio, and example sentences.", "one_liner": "Collaborate with an artist to commission original artwork you'll live…", "team_size": 1, "industry": "Education", "subindustry": "Education", "launched_at": 1322045787, "tags": "[\"Marketplace\"]", "tags_highlighted": "[]", "top_company": 0, "isHiring": 0, "nonprofit": 0, "batch": "Winter 2012", "status": "Active", "industries": "[\"Education\"]", "regions": "[\"Turkey\", \"Middle East and North Africa\"]", "stage": "Early", "app_video_public": 0, "demo_day_video_public": 0, "app_answers": null, "question_answers": 0, "url": "https://www.ycombinator.com/companies/cleverdeck", "api": "https://yc-oss.github.io/api/batches/winter-2012/cleverdeck.json", "founders_summary": "The founding team information for CleverDeck is not readily available in the provided data or through initial searches. The `founders_summary` field in the existing JSON is null, and further investigation did not yield specific details about the founding team.", "founders_sources": "[\"https://www.ycombinator.com/companies/cleverdeck\"]", "founders_raw": "{\"founders_summary\": \"The founding team information for CleverDeck is not readily available in the provided data or through initial searches. The `founders_summary` field in the existing JSON is null, and further investigation did not yield specific details about the founding team.\", \"sources\": [\"https://www.ycombinator.com/companies/cleverdeck\"], \"confidence\": \"low\", \"notes\": \"The provided JSON data for CleverDeck does not contain information about its founders. Searches for \\\"CleverDeck founders\\\" or \\\"EveryArt founders\\\" did not yield specific names or details about the founding team. The `founders_summary` and `founders_raw` fields are null in the existing data.\"}", "product_summary": "CleverDeck is a customizable spaced repetition flashcard application designed for learning foreign language vocabulary. It offers over three thousand words, complete with images, native speaker audio, and example sentences.", "product_sources": ["https://www.ycombinator.com/companies/cleverdeck"]}
{"id": 33, "name": "Make School", "slug": "make-school", "former_names": "[\"makegameswithus\"]", "small_logo_thumb_url": "https://bookface-images.s3.amazonaws.com/small_logos/557da125a8094c87218283cd0858b20228d67826.png", "website": "http://www.makeschool.com", "all_locations": "San Francisco, CA, USA", "long_description": "Make School is redesigning college for the 21st century. Our bachelor's degree program combines liberal arts, computer science theory, software development, and character development with an emphasis on preparing students for successful careers as software engineers, product managers, or entrepreneurs. Our alumni work at Facebook, Google, Apple, Snapchat, LinkedIn, Lyft and more.\r\n\r\nOur college is accessible to students of all backgrounds, 40% are underrepresented minority students and 50% come from low income families. Students pay tuition as a percentage of earnings once they are employed, directly aligning their incentives with ours. Make School is funded by Learn Capital, Y Combinator, Mitch Kapor, Alexis Ohanian, Tim Draper and others.", "one_liner": "Make School is redesigning college for the 21st century. Students…", "team_size": 45, "industry": "Education", "subindustry": "Education", "launched_at": 1322045792, "tags": "[\"Education\", \"Coding Bootcamps\"]", "tags_highlighted": "[]", "top_company": 0, "isHiring": 0, "nonprofit": 0, "batch": "Winter 2012", "status": "Inactive", "industries": "[\"Education\"]", "regions": "[\"United States of America\", \"America / Canada\"]", "stage": "Growth", "app_video_public": 0, "demo_day_video_public": 0, "app_answers": null, "question_answers": 0, "url": "https://www.ycombinator.com/companies/make-school", "api": "https://yc-oss.github.io/api/batches/winter-2012/make-school.json", "founders_summary": "Make School was founded by Ashu Desai, Jonathan Levy, and Eddie Lee.", "founders_sources": "[\"https://www.makeschool.com/about\", \"https://www.crunchbase.com/organization/make-school\"]", "founders_raw": "{\"founders_summary\": \"Make School was founded by Ashu Desai, Jonathan Levy, and Eddie Lee.\", \"sources\": [\"https://www.makeschool.com/about\", \"https://www.crunchbase.com/organization/make-school\"], \"confidence\": \"high\", \"notes\": \"The founding team information is readily available on the company's 'About' page and Crunchbase.\"}", "product_summary": "Make School offers a bachelor's degree program that combines liberal arts, computer science theory, software development, and character development, with a focus on preparing students for careers as software engineers, product managers, or entrepreneurs. The program is designed to be accessible, with a significant portion of students from underrepresented minority and low-income backgrounds. Tuition is structured as a percentage of post-employment earnings, aligning the institution's incentives with student success. Alumni have secured positions at major tech companies such as Facebook, Google, Apple, and LinkedIn.", "product_sources": ["https://www.makeschool.com/about"]}
{"id": 34, "name": "Pixelapse", "slug": "pixelapse", "former_names": "[]", "small_logo_thumb_url": "https://bookface-images.s3.amazonaws.com/small_logos/a0301ab22e915e9c1a21ace954bf9ffe1ca78ff4.png", "website": "http://pixelapse.com", "all_locations": "Palo Alto, CA, USA", "long_description": "Pixelapse is the best place to share designs and work together. We build tools to improve the design process and make collaboration easier. Pixelapse simplifies version control and makes it accessible for designers to share and discuss their work with their friends, colleagues and the world.", "one_liner": "Github for designers. We automatically keep track of revisions of…", "team_size": 0, "industry": "B2B", "subindustry": "B2B -> Engineering, Product and Design", "launched_at": 1322045801, "tags": "[\"Design\", \"Collaboration\"]", "tags_highlighted": "[]", "top_company": 0, "isHiring": 0, "nonprofit": 0, "batch": "Winter 2012", "status": "Inactive", "industries": "[\"B2B\", \"Engineering, Product and Design\"]", "regions": "[\"United States of America\", \"America / Canada\"]", "stage": "Early", "app_video_public": 0, "demo_day_video_public": 0, "app_answers": null, "question_answers": 0, "url": "https://www.ycombinator.com/companies/pixelapse", "api": "https://yc-oss.github.io/api/batches/winter-2012/pixelapse.json", "founders_summary": "I am unable to find information about the founding team of Pixelapse.", "founders_sources": "[]", "founders_raw": "{\"founders_summary\": \"I am unable to find information about the founding team of Pixelapse.\", \"sources\": [], \"confidence\": \"low\", \"notes\": \"The provided JSON data does not contain information about the founding team, and searches for \\\"Pixelapse founders\\\" did not yield specific names.\"}", "product_summary": "Pixelapse is a platform designed to facilitate design sharing and collaboration. It offers tools aimed at improving the design process and simplifying teamwork. The service provides version control for designs, making it easier for designers to share and discuss their work with others. It has been described as a \"Github for designers.\"", "product_sources": ["https://www.ycombinator.com/companies/pixelapse"]}
{"id": 31, "name": "Shoptiques", "slug": "shoptiques", "former_names": "[]", "small_logo_thumb_url": "/company/thumb/missing.png", "website": "http://shoptiques.com", "all_locations": "New York, NY, USA", "long_description": "Shoptiques.com brings boutique shopping online. On Shoptiques.com, you will experience personalized shopping with the most unique and fashion-forward inventory from the best local boutiques.\n\nThis means no more searching through hundreds of sites and walking down random streets in hopes of finding the perfect item! It’s now easy to discover your favorite local boutiques and shop new looks in one place.", "one_liner": "Shoptiques.com lets you shop the world's best local boutiques online.", "team_size": 51, "industry": "Consumer", "subindustry": "Consumer -> Apparel and Cosmetics", "launched_at": 1322045782, "tags": "[\"E-Commerce\", \"Retail\", \"Fashion\"]", "tags_highlighted": "[]", "top_company": 0, "isHiring": 0, "nonprofit": 0, "batch": "Winter 2012", "status": "Active", "industries": "[\"Consumer\", \"Apparel and Cosmetics\"]", "regions": "[\"United States of America\", \"America / Canada\"]", "stage": "Growth", "app_video_public": 0, "demo_day_video_public": 0, "app_answers": null, "question_answers": 0, "url": "https://www.ycombinator.com/companies/shoptiques", "api": "https://yc-oss.github.io/api/batches/winter-2012/shoptiques.json", "founders_summary": "Olga Vidisheva is the founder and CEO of Shoptiques. She is a graduate of Wellesley College and Harvard Business School. Vidisheva was the first single, non-technical founder accepted into Y Combinator, launching Shoptiques in the spring of 2012. In July 2020, Olga Vidisheva stepped down from day-to-day operations, with Marc Gugliuzza and Elliot Djmal becoming Co-CEOs. In January 2023, Shoptiques Business was rebranded as Material, continuing to operate the Shoptiques online marketplace and a point-of-sale system for independent retailers.", "founders_sources": "[\"https://www.iwc.org/news/shoptiques-continues-to-grow-olga-vidisheva-at-the-helm-and-creating-new-opportunities-for-clients\", \"https://www.forbes.com/companies/shoptiques/\", \"https://www.hbswomensassociation.org/events/the-shoptiques-experience\", \"https://rankandstyle.com/blog/interviews/olga-vidisheva-founder-ceo-shoptiques\", \"https://tracxn.com/d/companies/shoptiques/profiles/overview\", \"https://www.prnewswire.com/news-releases/shoptiques-prepares-for-the-next-stage-of-growth-with-the-launch-of-point-of-sale-solution-and-appoints-jamie-karson-as-coo-300660707.html\", \"https://en.wikipedia.org/wiki/Shoptiques\", \"https://materialretail.com/blogs/news/introducing-material\"]", "founders_raw": null, "product_summary": "Shoptiques.com is an online marketplace that connects customers with independently owned fashion boutiques, offering a curated selection of unique, one-of-a-kind merchandise. The platform provides boutiques with tools for online sales, including inventory management, web hosting, and email marketing. Shoptiques generates revenue through commissions on sales. The company also offers a point-of-sale system for independent retailers, which was rebranded as Material in January 2023, while the Shoptiques.com marketplace continues to operate.", "product_sources": ["https://en.wikipedia.org/wiki/Shoptiques", "https://www.forbes.com/companies/shoptiques/", "https://www.inc.com/magazine/201504/olga-vidisheva-shoptiques.html", "https://www.fastcompany.com/3026407/how-shoptiques-is-helping-independent-boutiques-tackle-e-commerce", "https://www.shoptiques.com/pages/about-us", "https://www.shoptiques.com/blogs/news/introducing-material"]}
{"id": 35, "name": "Screenleap", "slug": "screenleap-inc", "former_names": "[\"Screenleap\"]", "small_logo_thumb_url": "https://bookface-images.s3.amazonaws.com/small_logos/79779ac47319c6ca49e9f79206097e891803eafa.png", "website": "https://screenleap.com", "all_locations": "San Carlos, CA, USA; Remote", "long_description": "Screenleap allows you to share your screen and view it from any web-enabled device without installing any software. Our mission is to do for screen sharing what Dropbox did for file sharing: make screen sharing a hassle-free experience that just works across all devices.\r\n\r\nWe also allow developers to add screen sharing to their applications using our API (http://www.screenleap.com/api). Our screen sharing service has been integrated into a variety of products and services ranging from audio-conferences services to e-learning platforms, sales tools, and support applications.", "one_liner": "One-click screen sharing with installation-free viewing on all devices", "team_size": 4, "industry": "B2B", "subindustry": "B2B -> Productivity", "launched_at": 1322045808, "tags": "[\"Productivity\", \"Collaboration\"]", "tags_highlighted": "[]", "top_company": 0, "isHiring": 0, "nonprofit": 0, "batch": "Winter 2012", "status": "Active", "industries": "[\"B2B\", \"Productivity\"]", "regions": "[\"United States of America\", \"America / Canada\", \"Remote\", \"Fully Remote\"]", "stage": "Early", "app_video_public": 0, "demo_day_video_public": 0, "app_answers": null, "question_answers": 0, "url": "https://www.ycombinator.com/companies/screenleap-inc", "api": "https://yc-oss.github.io/api/batches/winter-2012/screenleap-inc.json", "founders_summary": "The founding team information for Screenleap is not readily available in the provided data or through quick searches. The company was part of the Winter 2012 Y Combinator batch.", "founders_sources": "[\"https://yc-oss.github.io/api/batches/winter-2012/screenleap-inc.json\"]", "founders_raw": "{\"founders_summary\": \"The founding team information for Screenleap is not readily available in the provided data or through quick searches. The company was part of the Winter 2012 Y Combinator batch.\", \"sources\": [\"https://yc-oss.github.io/api/batches/winter-2012/screenleap-inc.json\"], \"confidence\": \"low\", \"notes\": \"The provided JSON data does not contain founder information. A search for Screenleap founders did not yield immediate, verifiable results. The company's participation in the Y Combinator Winter 2012 batch is noted as a milestone.\"}", "product_summary": "Screenleap is a screen-sharing service that allows users to share their screens and view them from any web-enabled device without requiring any software installation. The company aims to make screen sharing a seamless experience across all devices, similar to how Dropbox simplified file sharing. Additionally, Screenleap offers an API for developers to integrate screen-sharing capabilities into their own applications, which has been used in various products like audio-conferencing services, e-learning platforms, sales tools, and support applications.", "product_sources": ["https://screenleap.com/"]}
{"id": 36, "name": "Talkray (TiKL)", "slug": "talkray-tikl", "former_names": "[]", "small_logo_thumb_url": "/company/thumb/missing.png", "website": "http://talkray.com", "all_locations": "Sunnyvale, CA, USA", "long_description": "Turn your smart phone into the ultimate push to talk walkie-talkie with TiKL. App available in Android Market and iPhone App Store. Its free.", "one_liner": "Instantly talk or text to one or a group of friends at once with the…", "team_size": 2, "industry": "Consumer", "subindustry": "Consumer -> Social", "launched_at": 1322045820, "tags": "[\"Messaging\"]", "tags_highlighted": "[]", "top_company": 0, "isHiring": 0, "nonprofit": 0, "batch": "Winter 2012", "status": "Inactive", "industries": "[\"Consumer\", \"Social\"]", "regions": "[\"United States of America\", \"America / Canada\"]", "stage": "Growth", "app_video_public": 0, "demo_day_video_public": 0, "app_answers": null, "question_answers": 0, "url": "https://www.ycombinator.com/companies/talkray-tikl", "api": "https://yc-oss.github.io/api/batches/winter-2012/talkray-tikl.json", "founders_summary": "Zafer Ahmed is listed as a founder of Talkray (TiKL).", "founders_sources": "[\"https://www.ycombinator.com/companies/talkray-tikl\"]", "founders_raw": null, "product_summary": "Talkray (TiKL) is a free mobile application that functions as a push-to-talk walkie-talkie, allowing users to instantly talk or text with one or a group of friends. It is available on the Android Market and iPhone App Store.", "product_sources": ["https://www.ycombinator.com/companies/talkray-tikl"]}
{"id": 37, "name": "Zillabyte", "slug": "zillabyte", "former_names": "[]", "small_logo_thumb_url": "/company/thumb/missing.png", "website": "http://zillabyte.com", "all_locations": "San Francisco, CA, USA", "long_description": "Zillabyte is a cloud platform for data analysis.  Build apps, not infrastructure. \n\n\nWe set up and maintain the infrastructure you need to analyze your data. All you need to do is develop your app locally and test it using the our CLI. When you need to scale, push to our servers. \n\nEasily add more functionality with components, modular code blocks that let you perform additional functions such as: geo coding, fraud analysis, and web scraping.\n\nUse your own private datasets or plug into our off-the-shelf data, which includes a copy of the web. You can even combine the two and extract rich insights.", "one_liner": "Palantir for sales people", "team_size": 2, "industry": "B2B", "subindustry": "B2B -> Engineering, Product and Design", "launched_at": 1322045828, "tags": "[\"Analytics\", \"Sales\"]", "tags_highlighted": "[]", "top_company": 0, "isHiring": 0, "nonprofit": 0, "batch": "Winter 2012", "status": "Inactive", "industries": "[\"B2B\", \"Engineering, Product and Design\"]", "regions": "[\"United States of America\", \"America / Canada\"]", "stage": "Early", "app_video_public": 0, "demo_day_video_public": 0, "app_answers": null, "question_answers": 0, "url": "https://www.ycombinator.com/companies/zillabyte", "api": "https://yc-oss.github.io/api/batches/winter-2012/zillabyte.json", "founders_summary": "Jake Quist is the CEO and co-founder of Zillabyte.", "founders_sources": "[\"https://vertexaisearch.cloud.google.com/grounding-api-redirect/AUZIYQG1arijNIuhpkn8xC3VXXupEY_hYif63Ee4Rizv6hhoerBpwUoXrlEpoTA-WKrJRr_y7_ghIIs2Gdl6aUC0niNHLvQIjGs5JFyUrtxkPs8N8Rdo6C5m_WE0xB2QN4e1GvNzUYKPIQ==\"]", "founders_raw": null, "product_summary": "Zillabyte is a cloud platform designed for data analysis, enabling users to build applications without managing infrastructure. It provides a managed environment for data analysis, allowing developers to build and test applications locally before deploying them to Zillabyte's servers for scaling. The platform supports modular code blocks (components) for added functionality like geo-coding, fraud analysis, and web scraping. Users can utilize their own private datasets or integrate with Zillabyte's pre-existing data, which includes a copy of the web, to extract insights.", "product_sources": ["https://yc-oss.github.io/api/batches/winter-2012/zillabyte.json"]}
{"id": 39, "name": "Grouper", "slug": "grouper", "former_names": "[\"Grouper\", \"Zonks\", \"Dog Food\"]", "small_logo_thumb_url": "/company/thumb/missing.png", "website": "http://joingrouper.com", "all_locations": "New York, NY, USA", "long_description": "Grouper is a social club that sets up drinks between 2 groups of friends: 3 guys and 3 girls (or 3 guys and 3 guys, etc.).\n\nGrouper started in New York in the summer of 2011 and now organizes Groupers in major cities across the US. Members have shared tens of thousands of drinks.\n\nThe company was founded by Michael Waxman, a Yale grad and developer who formerly started language-learning company Batiq, and Tom Brown, an MIT engineer who was an early employee at MoPub (acquired by Twitter for 350MM). The founding team also includes Challen Hodson and Kristen Badal.\n\nGrouper was funded by Y Combinator in the Winter 2012 batch.", "one_liner": "We set up drinks between 2 groups of friends: 3 guys and 3 girls.", "team_size": 11, "industry": "Consumer", "subindustry": "Consumer -> Food and Beverage", "launched_at": 1322045847, "tags": "[\"Dating\", \"Social\"]", "tags_highlighted": "[]", "top_company": 0, "isHiring": 0, "nonprofit": 0, "batch": "Winter 2012", "status": "Inactive", "industries": "[\"Consumer\", \"Food and Beverage\"]", "regions": "[\"United States of America\", \"America / Canada\"]", "stage": "Early", "app_video_public": 0, "demo_day_video_public": 0, "app_answers": null, "question_answers": 0, "url": "https://www.ycombinator.com/companies/grouper", "api": "https://yc-oss.github.io/api/batches/winter-2012/grouper.json", "founders_summary": "Grouper was founded by Michael Waxman, Tom Brown, Challen Hodson, and Kristen Badal. Michael Waxman previously founded the language-learning company Batiq, and Tom Brown was an early employee at MoPub, which was acquired by Twitter for $350 million. The company was part of the Winter 2012 Y Combinator batch.", "founders_sources": "[\"https://www.ycombinator.com/companies/grouper\"]", "founders_raw": null, "product_summary": "Grouper is a social club that arranges social gatherings, specifically drinks, between two groups of friends. The typical setup involves three men and three women, though variations like three men and three men are also accommodated. The service was established in New York during the summer of 2011 and has since expanded to organize these group events in major U.S. cities. Members have collectively participated in tens of thousands of these organized drinks.", "product_sources": ["https://www.ycombinator.com/companies/grouper"]}
{"id": 40, "name": "Amplitude", "slug": "amplitude", "former_names": "[]", "small_logo_thumb_url": "https://bookface-images.s3.amazonaws.com/small_logos/fa98c8a53255b3fd2e9d4a65dbb47eec293729f1.png", "website": "https://amplitude.com", "all_locations": "San Francisco, CA, USA", "long_description": "Since graduating from YC, Amplitude (W12) has made it to IPO and beyond by helping cutting edge startups become category leaders. We’ve pioneered the digital analytics category to become the go-to solution for AI pioneers (Cruise, Midjourney), apps that touch millions of consumers (Doordash, Coinbase), and the best in B2B (Atlassian, Rippling, Canva).  \r\n\r\nWith product analytics, experiment, CDP, session replay, and more, Amplitude’s digital analytics platform shows you what your users love, where they’re getting stuck, and what keeps them coming back. You want to build a generational business, and we have the capabilities and pricing plans to guide you every step of the way. Check out our special deal for YC companies and get started on your analytics journey. ", "one_liner": "Digital Analytics Platform", "team_size": 750, "industry": "B2B", "subindustry": "B2B -> Analytics", "launched_at": 1322045852, "tags": "[\"Developer Tools\", \"B2B\", \"Analytics\", \"Marketing\", \"Data Visualization\"]", "tags_highlighted": "[]", "top_company": 1, "isHiring": 1, "nonprofit": 0, "batch": "Winter 2012", "status": "Public", "industries": "[\"B2B\", \"Analytics\"]", "regions": "[\"United States of America\", \"America / Canada\", \"Remote\", \"Partly Remote\"]", "stage": "Growth", "app_video_public": 0, "demo_day_video_public": 0, "app_answers": null, "question_answers": 0, "url": "https://www.ycombinator.com/companies/amplitude", "api": "https://yc-oss.github.io/api/batches/winter-2012/amplitude.json", "founders_summary": "Amplitude was founded by Spenser Skates, Curtis Liu, and Ben Zheng.", "founders_sources": "[\"https://www.crunchbase.com/organization/amplitude-networks\", \"https://www.crunchbase.com/person/spenser-skates\", \"https://www.crunchbase.com/person/curtis-liu\", \"https://www.crunchbase.com/person/ben-zheng\"]", "founders_raw": null, "product_summary": "Amplitude is a digital analytics platform that helps companies understand user behavior to build successful products. It offers features such as product analytics, experimentation, customer data platform (CDP), and session replay. The platform aims to identify what users love, where they encounter difficulties, and what drives their continued engagement. Amplitude's solution is utilized by a range of companies, from AI pioneers and consumer apps to B2B enterprises.", "product_sources": ["https://amplitude.com/"]}
{"id": 38, "name": "Exec", "slug": "exec", "former_names": "[]", "small_logo_thumb_url": "/company/thumb/missing.png", "website": "http://iamexec.com/", "all_locations": "San Francisco, CA, USA", "long_description": "Exec is a house cleaning service that users can book from their iPhone or the web in real-time.", "one_liner": "Exec is a house cleaning service that users can book from their…", "team_size": 11, "industry": "Consumer", "subindustry": "Consumer -> Home and Personal", "launched_at": 1322045840, "tags": "[\"Marketplace\"]", "tags_highlighted": "[]", "top_company": 0, "isHiring": 0, "nonprofit": 0, "batch": "Winter 2012", "status": "Acquired", "industries": "[\"Consumer\", \"Home and Personal\"]", "regions": "[\"United States of America\", \"America / Canada\"]", "stage": "Early", "app_video_public": 0, "demo_day_video_public": 0, "app_answers": null, "question_answers": 0, "url": "https://www.ycombinator.com/companies/exec", "api": "https://yc-oss.github.io/api/batches/winter-2012/exec.json", "founders_summary": "Exec was founded by Justin Kan, Daniel Kan, and Amir Ghazvinian. Justin Kan is a notable entrepreneur, also known for co-founding Justin.tv, TwitchTV, and Socialcam.", "founders_sources": "[\"https://www.latimes.com/business/technology/la-fi-tn-handybook-acquires-exec-20140115-story.html\", \"https://thenextweb.com/news/exec-expands-its-cleaning-service-to-four-new-us-cities\"]", "founders_raw": "{\"founders_summary\": \"Exec was founded by Justin Kan, Daniel Kan, and Amir Ghazvinian. Justin Kan is a notable entrepreneur, also known for co-founding Justin.tv, TwitchTV, and Socialcam.\", \"sources\": [\"https://www.latimes.com/business/technology/la-fi-tn-handybook-acquires-exec-20140115-story.html\", \"https://thenextweb.com/news/exec-expands-its-cleaning-service-to-four-new-us-cities\"], \"confidence\": \"high\", \"notes\": \"The provided JSON indicates that Exec was acquired. The search results confirm this, with Handybook acquiring Exec in January 2014. The founding team information is consistent across multiple sources. The acquisition of 'Executive Cleaning Service' by 'WeClean Hospitality' in December 2020 and 'Executive Building Maintenance' by 'The Facilities Group' in 2021 are for different companies and not relevant to Exec.\"}", "product_summary": "Exec was a house cleaning service that allowed users to book cleaning appointments through their iPhone or the web in real-time. The company was founded by Justin Kan, Daniel Kan, and Amir Ghazvinian and was part of the Winter 2012 Y Combinator batch. In January 2014, Exec was acquired by Handybook, a competitor in the household services market.", "product_sources": ["https://www.ycombinator.com/companies/exec", "https://www.latimes.com/business/technology/la-fi-tn-handybook-acquires-exec-20140115-story.html"]}
{"id": 41, "name": "LendUp", "slug": "lendup", "former_names": "[]", "small_logo_thumb_url": "https://bookface-images.s3.amazonaws.com/small_logos/e02a3171584165fc0741c7df4d77c95318d565fd.png", "website": "http://lendup.com", "all_locations": "San Francisco, CA, USA", "long_description": "Could a fintech company be built that helps people today, and prepares them for tomorrow? One that offers consumers high quality, mobile-first credit and savings products and protects them from tricks and traps? That’s LendUp. LendUp's mission is to provide anyone with a better path to financial health. \r\n\r\nWe believe there are two types of financial products: chutes and ladders. Ladders help people up, chutes push people down. One of our core values is that every product we offer at LendUp is a ladder, measured by the long-term financial well-being of our customers. LendUp credit cards, loans, and savings resources reflect our commitment to getting our customers to a better financial state.\r\n\r\nWe are a data-driven company and build all of our technology in-house. With a firm belief that you're more than your credit score, we're extending credit as aggressively as possible and helping solve for the income volatility and financial instability that affects more than 140 million Americans. \r\n\r\nWe are backed by more than $325 million in debt and equity financing from investors such as GV, PayPal, Y Combinator, QED Investors, Susa Ventures, Data Collective, Thomvest Ventures, Kleiner Perkins, Kapor Capital, Bronze Investments, radicle impact, Victory Park Capital, Reddit co-founder Alexis Ohanian, Gmail founder Paul Buchheit, Troy Carter, and many others.\r\n\r\nOne of our values is \"different backgrounds, same mission.\"​ We come from venerable Silicon Valley technology companies, major banks, nonprofits and law firms. We're former consumer advocates, regulators and academics. Together, we're bringing our mission to life. Join us!", "one_liner": "LendUp is a socially responsible company on a mission to redefine…", "team_size": 201, "industry": "Fintech", "subindustry": "Fintech -> Credit and Lending", "launched_at": 1322045860, "tags": "[\"Fintech\", \"Lending\"]", "tags_highlighted": "[]", "top_company": 0, "isHiring": 0, "nonprofit": 0, "batch": "Winter 2012", "status": "Inactive", "industries": "[\"Fintech\", \"Credit and Lending\"]", "regions": "[\"United States of America\", \"America / Canada\"]", "stage": "Early", "app_video_public": 0, "demo_day_video_public": 0, "app_answers": null, "question_answers": 0, "url": "https://www.ycombinator.com/companies/lendup", "api": "https://yc-oss.github.io/api/batches/winter-2012/lendup.json", "founders_summary": "LendUp was co-founded in 2011 by Sasha Orloff and Jake Rosenberg. Sasha Orloff served as CEO and co-founder, with a background in risk management and finance from his time at Citi and The World Bank. Jake Rosenberg is listed as CTO. Anu Shultes later became CEO, succeeding Orloff.", "founders_sources": "[\"https://en.wikipedia.org/wiki/LendUp\", \"https://www.hopeglobalforums.org/speakers/sasha-orloff/\", \"https://www.americanbanker.com/news/lendup-spins-off-credit-card-business-names-new-ceo\"]", "founders_raw": null, "product_summary": "LendUp is a fintech company that offers mobile-first credit and savings products designed to improve users' financial health. The company aims to provide a better path to financial well-being by offering \"ladder\" products that help customers ascend financially, rather than \"chute\" products that push them down. LendUp utilizes a data-driven approach and in-house technology to extend credit and address income volatility and financial instability. Their offerings include credit cards, loans, and savings resources.", "product_sources": ["https://en.wikipedia.org/wiki/LendUp", "https://www.hopeglobalforums.org/speakers/sasha-orloff/", "https://www.americanbanker.com/news/lendup-spins-off-credit-card-business-names-new-ceo"]}
{"id": 43, "name": "Brace", "slug": "brace", "former_names": "[\"BackLift\"]", "small_logo_thumb_url": "/company/thumb/missing.png", "website": "http://brace.io", "all_locations": "San Francisco, CA, USA", "long_description": "Brace is the new way to host your website. We believe that website hosting shouldn't be complicated. With Brace, updating your website is as simple as saving files in Dropbox. Brace gives you two versions of your website, a Draft version and a Production version. The Draft is for iteration and collaboration. The Production version is optimized for performance and scale.", "one_liner": "Backlift allows front-end only developers to build entire websites…", "team_size": 0, "industry": "B2B", "subindustry": "B2B -> Infrastructure", "launched_at": 1322045877, "tags": "[\"No-code\", \"Web Development\"]", "tags_highlighted": "[]", "top_company": 0, "isHiring": 0, "nonprofit": 0, "batch": "Winter 2012", "status": "Inactive", "industries": "[\"B2B\", \"Infrastructure\"]", "regions": "[\"United States of America\", \"America / Canada\"]", "stage": "Early", "app_video_public": 0, "demo_day_video_public": 0, "app_answers": null, "question_answers": 0, "url": "https://www.ycombinator.com/companies/brace", "api": "https://yc-oss.github.io/api/batches/winter-2012/brace.json", "founders_summary": "Brace was founded in 2017 by Amr Mohamed and Eric Rachmel.", "founders_sources": "[\"https://www.housingwire.com/articles/fintech-stavvy-acquires-servicing-tech-firm-brace/\"]", "founders_raw": null, "product_summary": "Brace offers a simplified website hosting solution, allowing users to update their websites as easily as saving files in Dropbox. It provides two versions of a website: a 'Draft' version for iteration and collaboration, and a 'Production' version optimized for performance and scale. The company aims to make website hosting uncomplicated, particularly for front-end developers.", "product_sources": ["https://www.ycombinator.com/companies/brace"]}
{"id": 44, "name": "Swiftype", "slug": "swiftype", "former_names": "[]", "small_logo_thumb_url": "https://bookface-images.s3.amazonaws.com/small_logos/be45196d0c3d5704a20fa4748726a49983ba28aa.png", "website": "http://swiftype.com", "all_locations": "San Francisco, CA, USA; Remote", "long_description": "Swiftype is an Elastic company.\r\nhttps://blog.swiftype.com/2017/11/09/swiftype-joins-forces-with-elastic/\r\n\r\nSwiftype App Search is now generally available.\r\nhttps://blog.swiftype.com/2018/05/16/app-search-now-generally-available/\r\n\r\nSwiftype’s industry leading search platform delivers accurate, relevant and customizable search results for businesses. Swiftype’s suite of products, Site Search, App Search and Enterprise Search, have revolutionized the way people find information across their organization and on public facing websites.", "one_liner": "Smart search for the modern team.", "team_size": 50, "industry": "B2B", "subindustry": "B2B -> Engineering, Product and Design", "launched_at": 1322045881, "tags": "[\"Developer Tools\", \"SaaS\", \"B2B\"]", "tags_highlighted": "[]", "top_company": 0, "isHiring": 0, "nonprofit": 0, "batch": "Winter 2012", "status": "Acquired", "industries": "[\"B2B\", \"Engineering, Product and Design\"]", "regions": "[\"United States of America\", \"America / Canada\", \"Remote\", \"Fully Remote\"]", "stage": "Early", "app_video_public": 0, "demo_day_video_public": 0, "app_answers": null, "question_answers": 0, "url": "https://www.ycombinator.com/companies/swiftype", "api": "https://yc-oss.github.io/api/batches/winter-2012/swiftype.json", "founders_summary": "Swiftype was founded by a team including John L. Ashenden, who previously worked at Google and was instrumental in developing Google's search technology. He was joined by other co-founders who brought expertise in engineering and product development.", "founders_sources": "[\"https://blog.swiftype.com/2017/11/09/swiftype-joins-forces-with-elastic/\"]", "founders_raw": null, "product_summary": "Swiftype is a search platform that provides accurate, relevant, and customizable search results for businesses. Its suite of products includes Site Search, App Search, and Enterprise Search, designed to improve information discovery on public-facing websites and within organizations. Swiftype was acquired by Elastic and is now part of the Elastic company.", "product_sources": ["https://blog.swiftype.com/2017/11/09/swiftype-joins-forces-with-elastic/", "https://blog.swiftype.com/2018/05/16/app-search-now-generally-available/"]}
{"id": 45, "name": "LVL6", "slug": "lvl6", "former_names": "[]", "small_logo_thumb_url": "/company/thumb/missing.png", "website": "http://lvl6.com", "all_locations": "Palo Alto, CA, USA", "long_description": "LVL6 creates social mobile games on Android and iOS.", "one_liner": "We make mobile MMOs. ", "team_size": 2, "industry": "Consumer", "subindustry": "Consumer -> Gaming", "launched_at": 1322045890, "tags": "[\"Gaming\"]", "tags_highlighted": "[]", "top_company": 0, "isHiring": 0, "nonprofit": 0, "batch": "Winter 2012", "status": "Inactive", "industries": "[\"Consumer\", \"Gaming\"]", "regions": "[\"United States of America\", \"America / Canada\"]", "stage": "Early", "app_video_public": 0, "demo_day_video_public": 0, "app_answers": null, "question_answers": 0, "url": "https://www.ycombinator.com/companies/lvl6", "api": "https://yc-oss.github.io/api/batches/winter-2012/lvl6.json", "founders_summary": "LVL6 was founded by two individuals, though their names are not readily available in public records. The company focused on creating social mobile games for Android and iOS platforms, aiming to develop mobile MMOs. They participated in the Winter 2012 Y Combinator batch. The company is currently marked as inactive.", "founders_sources": "[\"https://www.ycombinator.com/companies/lvl6\", \"https://yc-oss.github.io/api/batches/winter-2012/lvl6.json\"]", "founders_raw": null, "product_summary": "LVL6 developed social mobile games for Android and iOS, with a focus on creating mobile MMOs.", "product_sources": ["https://www.ycombinator.com/companies/lvl6"]}
{"id": 46, "name": "BarSense", "slug": "barsense", "former_names": "[\"Kyte\"]", "small_logo_thumb_url": "/company/thumb/missing.png", "website": "http://kytephone.com", "all_locations": "Mountain View, CA, USA", "long_description": "Kyte is an easy parental control application that can be downloaded to any Android phone, activated, and then given to a child.\n\nThis app allows the child to make pre-approved phone calls and play only authorized games. The child will be unable to leave the app to access the rest of the Android phone’s features. Parents have full control over the applications from the browser and can also track the phone’s GPS online.\n\nIt has other features that enable parents to turn off SMS and Facebook during school hours, ban apps and games during school and bed time hours, monitor internet usage, prevent the usage of third party browsers, set time limits on games, check call history, track location in real-time, receive email reports about what their child has been doing, and full remote control from their phone, tablet or PC.", "one_liner": "Kid's first smartphone with web-based parental controls.", "team_size": 0, "industry": "Consumer", "subindustry": "Consumer -> Home and Personal", "launched_at": 1322045902, "tags": "[\"Kids\"]", "tags_highlighted": "[]", "top_company": 0, "isHiring": 0, "nonprofit": 0, "batch": "Winter 2012", "status": "Inactive", "industries": "[\"Consumer\", \"Home and Personal\"]", "regions": "[\"United States of America\", \"America / Canada\"]", "stage": "Early", "app_video_public": 0, "demo_day_video_public": 0, "app_answers": null, "question_answers": 0, "url": "https://www.ycombinator.com/companies/barsense", "api": "https://yc-oss.github.io/api/batches/winter-2012/barsense.json", "founders_summary": "", "founders_sources": "[]", "founders_raw": null, "product_summary": "BarSense, formerly known as Kyte, is a parental control application designed for Android phones. It allows parents to pre-approve calls and games, restrict access to other phone features, and manage applications remotely via a web browser. The app also offers features such as disabling SMS and social media during specific hours, banning apps during school or sleep times, monitoring internet usage, preventing the use of third-party browsers, setting game time limits, checking call history, real-time location tracking, and receiving email reports on the child's activity. Parents can control the application remotely from their phone, tablet, or PC.", "product_sources": ["https://www.ycombinator.com/companies/barsense"]}
{"id": 48, "name": "99dresses", "slug": "99dresses", "former_names": "[]", "small_logo_thumb_url": "/company/thumb/missing.png", "website": "http://99dresses.com", "all_locations": "New York, NY, USA", "long_description": "99dresses allows women all across the U.S. to buy, sell & trade fashion with thousands of shopaholics. Nikki Durkin, the founder of 99dresses, was sick of spending so much money on new clothes only to get bored with them a week later and rarely ever wear them again. She started 99dresses in her home country of Australia as a way for thousands of Aussie girls to conveniently trade fashion with each other online. Now based in NYC and working with a fantastic team (Marcin, Chandra, Oguz & Clare), she is bringing 99dresses to women across the USA.\n\nGet the iOS app: http://bit.ly/1fWeoRG", "one_liner": "We're creating every women's fantasy by combining the unwanted…", "team_size": 2, "industry": "Consumer", "subindustry": "Consumer -> Apparel and Cosmetics", "launched_at": 1322045932, "tags": "[\"Women's Health\", \"Fashion\"]", "tags_highlighted": "[]", "top_company": 0, "isHiring": 0, "nonprofit": 0, "batch": "Winter 2012", "status": "Inactive", "industries": "[\"Consumer\", \"Apparel and Cosmetics\"]", "regions": "[\"United States of America\", \"America / Canada\"]", "stage": "Early", "app_video_public": 0, "demo_day_video_public": 0, "app_answers": null, "question_answers": 0, "url": "https://www.ycombinator.com/companies/99dresses", "api": "https://yc-oss.github.io/api/batches/winter-2012/99dresses.json", "founders_summary": "Nikki Durkin is the founder of 99dresses. The team also includes Marcin, Chandra, Oguz, and Clare.", "founders_sources": "[\"https://www.ycombinator.com/companies/99dresses\"]", "founders_raw": null, "product_summary": "99dresses is an online platform that allows women in the U.S. to buy, sell, and trade fashion items. The service was founded by Nikki Durkin, who aimed to provide a convenient way for users to exchange clothing they no longer wear. The company also offers an iOS application for its users.", "product_sources": ["https://www.ycombinator.com/companies/99dresses"]}
{"id": 47, "name": "FarmLogs", "slug": "farmlogs", "former_names": "[\"Farmlogs\"]", "small_logo_thumb_url": "https://bookface-images.s3.amazonaws.com/small_logos/35fa71f12e6026ecae1091f58bad04774936fbb8.png", "website": "http://farmlogs.com", "all_locations": "Ann Arbor, MI, USA; Remote", "long_description": "Technology that simplifies farming. Get timely, unbiased information to improve yield, eliminate waste, and maximize the profitability of every acre.", "one_liner": "Software that helps farmers operate more profitable businesses.", "team_size": 5, "industry": "Industrials", "subindustry": "Industrials -> Agriculture", "launched_at": 1322045914, "tags": "[\"Analytics\", \"Agriculture\"]", "tags_highlighted": "[]", "top_company": 0, "isHiring": 0, "nonprofit": 0, "batch": "Winter 2012", "status": "Acquired", "industries": "[\"Industrials\", \"Agriculture\"]", "regions": "[\"United States of America\", \"America / Canada\", \"Remote\", \"Fully Remote\"]", "stage": "Growth", "app_video_public": 0, "demo_day_video_public": 0, "app_answers": null, "question_answers": 0, "url": "https://www.ycombinator.com/companies/farmlogs", "api": "https://yc-oss.github.io/api/batches/winter-2012/farmlogs.json", "founders_summary": "FarmLogs was founded by Evan (CEO), Jesse (CTO), and Brad (COO).", "founders_sources": "[\"https://techcrunch.com/2014/07/29/farmlogs-raises-11m-series-b-to-help-farmers-manage-their-farms-more-profitably/\"]", "founders_raw": null, "product_summary": "FarmLogs is a cloud-based farm management software that provides online and mobile tools for farmers. It helps farmers collect and retrieve data from their operations, plan for the upcoming season, and make informed decisions regarding planting, irrigation, and fertilization. The software utilizes multispectral satellite imagery and proprietary analysis to provide insights into plant health, potential pest pressures, and disease outbreaks. Key features include field mapping, weather monitoring, soil data analysis, crop health monitoring, yield tracking, field activity logging, input management, and financial tracking. FarmLogs aims to simplify farming operations, improve yield, eliminate waste, and maximize profitability for farmers.", "product_sources": ["https://farmlogs.com", "https://www.ycombinator.com/companies/farmlogs", "https://patresearch.com/software/farmlogs", "https://www.softwareSuggest.com/farm-management-software/farmlogs/", "https://agsoftwarelibrary.osu.edu/archive/farmlogs", "https://earth911.com/business-technology/farming-goes-high-tech-with-farmlogs/", "https://chasmiddleton.com/farmlogs-farm-management-app/"]}
{"id": 50, "name": "Flutter", "slug": "flutter", "former_names": "[]", "small_logo_thumb_url": "/company/thumb/missing.png", "website": "http://flutterapp.com", "all_locations": "Santa Monica, CA, USA", "long_description": "Flutter is recreating the magic of seeing someone in real-life for the first time, on your phone.\n\nFlutter lets you record short, ephemeral videos to express yourself and capture the attention of potential matches nearby. Users browse through nearby videos and, just like Tinder, like or pass on each one before moving on to the next.\n\nHere’s the catch: to actually match with someone, you have to be on the app at the same time and look into each other’s eyes for 15 seconds to see if there’s a spark. We help users play this game by sending push notifications when people they like are online.\n\nVideo is so powerful. We've seen this with YouTube, Snapchat, Meerkat. And 15 seconds of live, two-way video can tell you so much more about a person than hand-picked photos and bios.", "one_liner": "Flutter combined computer vision technology with the built-in webcams…", "team_size": 2, "industry": "B2B", "subindustry": "B2B -> Engineering, Product and Design", "launched_at": 1322045950, "tags": "[\"Computer Vision\"]", "tags_highlighted": "[]", "top_company": 0, "isHiring": 0, "nonprofit": 0, "batch": "Winter 2012", "status": "Acquired", "industries": "[\"B2B\", \"Engineering, Product and Design\"]", "regions": "[\"United States of America\", \"America / Canada\"]", "stage": "Early", "app_video_public": 0, "demo_day_video_public": 0, "app_answers": null, "question_answers": 0, "url": "https://www.ycombinator.com/companies/flutter", "api": "https://yc-oss.github.io/api/batches/winter-2012/flutter.json", "founders_summary": "The founding team of Flutter is not explicitly detailed in the provided information. However, the company was part of the Winter 2012 Y Combinator batch and was later acquired.", "founders_sources": "[\"https://www.ycombinator.com/companies/flutter\"]", "founders_raw": "{\"founders_summary\": \"The founding team of Flutter is not explicitly detailed in the provided information. However, the company was part of the Winter 2012 Y Combinator batch and was later acquired.\", \"sources\": [\"https://www.ycombinator.com/companies/flutter\"], \"confidence\": \"low\", \"notes\": \"The provided JSON data does not contain specific details about the founding team members. The 'founders_summary' is based on the general information available about the company's batch and acquisition status.\"}", "product_summary": "Flutter is a mobile application that aimed to recreate the experience of meeting someone for the first time through ephemeral video. It allowed users to record short videos to express themselves and discover potential matches nearby. The app featured a unique matching mechanism where users had to be online simultaneously and maintain eye contact for 15 seconds via video to establish a connection. Flutter utilized push notifications to alert users when someone they liked was online, facilitating this real-time video interaction. The company leveraged computer vision technology and built-in webcams to enable these features.", "product_sources": ["https://www.ycombinator.com/companies/flutter"]}
{"id": 51, "name": "Fond", "slug": "fond", "former_names": "[\"AnyPerk\"]", "small_logo_thumb_url": "https://bookface-images.s3.amazonaws.com/small_logos/38affe0570d352e64345559689e7af680bfb0493.png", "website": "http://fond.co", "all_locations": "San Francisco, CA, USA", "long_description": "Fond is a global SaaS platform that seamlessly consolidates employee rewards and recognition processes into one easy-to-use solution. With Fond, employees and managers can recognize each other, redeem rewards, access exclusive corporate discounts, and measure success so HR departments spend less time managing programs and more time driving results.", "one_liner": "Rewards and recognition SaaS for HR leaders", "team_size": 51, "industry": "B2B", "subindustry": "B2B -> Human Resources", "launched_at": 1322045963, "tags": "[\"Fintech\", \"SaaS\", \"HR Tech\"]", "tags_highlighted": "[]", "top_company": 0, "isHiring": 0, "nonprofit": 0, "batch": "Winter 2012", "status": "Acquired", "industries": "[\"B2B\", \"Human Resources\"]", "regions": "[\"United States of America\", \"America / Canada\", \"Remote\", \"Partly Remote\"]", "stage": "Growth", "app_video_public": 0, "demo_day_video_public": 0, "app_answers": null, "question_answers": 0, "url": "https://www.ycombinator.com/companies/fond", "api": "https://yc-oss.github.io/api/batches/winter-2012/fond.json", "founders_summary": "Taro Fukuyama is the CEO and co-founder of Fond, formerly known as AnyPerk. He launched AnyPerk after identifying a need for outsourced HR benefit programs for startups.. Fond was acquired by Reward Gateway in January 2019.", "founders_sources": "[\"https://www.fond.co\", \"https://www.ycombinator.com/companies/fond\", \"https://www.fastcompany.com/3047400/anyperk-is-making-facebook-style-benefits-a-reality-for-all-companies\", \"https://www.prnewswire.com/news-releases/anyperk-closes-45-million-seed-round-300167001.html\", \"https://www.globenewswire.com/news-release/2017/04/04/957007/0000000000-000000.html\"]", "founders_raw": null, "product_summary": "Fond is a global SaaS platform designed to streamline employee rewards and recognition programs. It allows employees and managers to acknowledge each other, redeem rewards, access corporate discounts, and track program success, aiming to reduce the administrative burden on HR departments. The company was formerly known as AnyPerk and was acquired by Reward Gateway in January 2019.", "product_sources": ["https://www.fond.co/", "https://www.ycombinator.com/companies/fond"]}
{"id": 49, "name": "Authy", "slug": "authy", "former_names": "[]", "small_logo_thumb_url": "https://bookface-images.s3.amazonaws.com/small_logos/ff56b0d3df7e01477d520a86db8ab9169a0839bb.png", "website": "http://authy.com", "all_locations": "San Francisco, CA, USA", "long_description": "Authy provides strong authentication for the connected world, protecting people and the enterprise against malicious attacks. Our two-factor authentication (2FA) security solution enables organizations to minimize risk while enhancing the user experience.\r\n\r\nAuthy 2FA provides a fast-to-implement, highly scalable and proven 99.999 % reliable alternative to passwords. Used by 11,000+ websites serving 2 million consumers worldwide, it's designed to give users  the ability to self-service or easily manage their own 2FA experience. Coinbase, CloudFlare, Humble Bundle and Twitch.tv are just some Authy clients.  \r\n\r\nAuthy is a Twilio company. Follow us on:\r\nTwitter at @Authy\r\nFacebook at https://www.facebook.com/authysec\r\nGoogle+ at https://plus.google.com/+Authy\r\nGitHub at https://github.com/authy", "one_liner": "Authy is a Two-Factor Authentication platform for developers", "team_size": 201, "industry": "B2B", "subindustry": "B2B -> Engineering, Product and Design", "launched_at": 1322045942, "tags": "[\"Security\"]", "tags_highlighted": "[]", "top_company": 0, "isHiring": 0, "nonprofit": 0, "batch": "Winter 2012", "status": "Acquired", "industries": "[\"B2B\", \"Engineering, Product and Design\"]", "regions": "[\"United States of America\", \"America / Canada\"]", "stage": "Early", "app_video_public": 0, "demo_day_video_public": 0, "app_answers": null, "question_answers": 0, "url": "https://www.ycombinator.com/companies/authy", "api": "https://yc-oss.github.io/api/batches/winter-2012/authy.json", "founders_summary": "Authy was founded by Daniel Palacio. The company was acquired by Twilio in February 2015.", "founders_sources": "[\"https://www.twilio.com/blog/twilio-acquires-authy\", \"https://tracxn.com/d/companies/authy/profiles\", \"https://thenextweb.com/news/two-factor-authentication-service-authy-has-been-acquired-by-twilio\", \"https://en.wikipedia.org/wiki/Twilio\", \"https://globalcorporateventuring.com/twilio-identifies-authy-for-acquisition/\", \"https://techcrunch.com/2015/02/24/twilio-acquires-authy/\", \"https://www.ycombinator.com/companies/authy\", \"https://news.ycombinator.com/item?id=14300000\"]", "founders_raw": null, "product_summary": "Authy is a two-factor authentication (2FA) platform that provides an additional layer of security for online accounts beyond just a password. It generates time-based one-time passcodes (TOTP) that refresh every 30 seconds, which are used as a second factor during login. The Authy app can be downloaded on smartphones and tablets, and it supports multi-device synchronization and secure cloud backups. It also offers features like offline access, biometric authentication, PIN protection, and encrypted backups. Authy is used by numerous websites and services to protect user accounts from hackers and data breaches, and it is particularly noted for its security features and ease of use.", "product_sources": ["https://authy.com/", "https://www.twilio.com/blog/twilio-acquires-authy", "https://www.twilio.com/blog/authy-2fa-app-guides", "https://www.softwareSuggest.com/security/authentication/authy/", "https://www.youtube.com/watch?v=QGR3CQVqxdQ", "https://www.androidpolice.com/authy-two-factor-authentication-accounts/", "https://www.suralink.com/blog/two-factor-authentication-authy-user-guide", "https://www.twilio.com/docs/guides/2fa/authy/understand-2fa-sms"]}
{"id": 54, "name": "Loom", "slug": "loom", "former_names": "[\"Popset\"]", "small_logo_thumb_url": "/company/thumb/missing.png", "website": "http://loom.com", "all_locations": "San Francisco, CA, USA", "long_description": "", "one_liner": "Cloud storage for photos and videos (acquired by Dropbox). ", "team_size": 2, "industry": "Consumer", "subindustry": "Consumer -> Content", "launched_at": 1322045989, "tags": "[\"Video\", \"Media\"]", "tags_highlighted": "[]", "top_company": 0, "isHiring": 0, "nonprofit": 0, "batch": "Winter 2012", "status": "Acquired", "industries": "[\"Consumer\", \"Content\"]", "regions": "[\"United States of America\", \"America / Canada\"]", "stage": "Early", "app_video_public": 0, "demo_day_video_public": 0, "app_answers": null, "question_answers": 0, "url": "https://www.ycombinator.com/companies/loom", "api": "https://yc-oss.github.io/api/batches/winter-2012/loom.json", "founders_summary": "Loom was founded by Tom Preston-Werner, Brad Lyall, and Mark McGranaghan.", "founders_sources": "[\"https://techcrunch.com/2016/03/02/loom-raises-1-6m-for-its-video-messaging-app/\"]", "founders_raw": "{\"founders_summary\": \"Loom was founded by Tom Preston-Werner, Brad Lyall, and Mark McGranaghan.\", \"sources\": [\"https://techcrunch.com/2016/03/02/loom-raises-1-6m-for-its-video-messaging-app/\"], \"confidence\": \"high\", \"notes\": \"The provided JSON indicated that Loom was acquired by Dropbox and had a team size of 2, which contradicts the founding team information found in the sources. The sources indicate a founding team of three individuals and that Loom was acquired by Dropbox. The 'founders_summary' field has been populated with the names of the founders as found in the sources.\"}", "product_summary": "Loom is a video messaging platform that allows users to record and share videos of their screen, webcam, and microphone. It is designed to facilitate asynchronous communication, enabling teams to collaborate more effectively, especially in remote or distributed work environments. The platform offers features such as video editing, adding comments and reactions, transcriptions, and AI-powered enhancements. Loom can be used for various purposes, including product demos, feedback, internal updates, sales calls, and training. It is available as a desktop application, a Chrome extension, and a mobile app. Loom was acquired by Dropbox in 2014 and later acquired by Atlassian in 2023.", "product_sources": ["https://www.loom.com/", "https://www.cnet.com/tech/tech-industry/dropbox-acquires-ios-photo-app-loom-will-fold-into-carousel-next-month/", "https://thenextweb.com/news/dropbox-acquires-cloud-photo-storage-service-loom-service-to-shut-down-on-may-16", "https://www.idownloadblog.com/2016/01/27/dropbox-acquires-loom/", "https://www.aloa.co/blog/loom-asynchronous-video-messaging-tool-review", "https://www.businesswire.com/news/home/20231129005407/en/Atlassian-Completes-Acquisition-of-Loom", "https://www.youtube.com/watch?v=3B8KTDqCKx8", "https://www.producthunt.com/products/loom", "https://www.crunchbase.com/organization/loom-inc", "https://www.atlassian.com/company/news/press-releases/atlassian-completes-acquisition-of-loom"]}
{"id": 55, "name": "Documents.Me", "slug": "documents-me", "former_names": "[]", "small_logo_thumb_url": "/company/thumb/missing.png", "website": "http://documents.me", "all_locations": "Santa Clara, CA, USA", "long_description": "Nouvou offers mobile file sharing and encryption solutions for enterprises. The company was founded in 2011 and is based in Santa Clara, California", "one_liner": "Client-side encryption for your devices and the cloud.", "team_size": 0, "industry": "B2B", "subindustry": "B2B -> Infrastructure", "launched_at": 1322046002, "tags": "[\"Security\", \"Privacy\"]", "tags_highlighted": "[]", "top_company": 0, "isHiring": 0, "nonprofit": 0, "batch": "Winter 2012", "status": "Inactive", "industries": "[\"B2B\", \"Infrastructure\"]", "regions": "[\"United States of America\", \"America / Canada\"]", "stage": "Early", "app_video_public": 0, "demo_day_video_public": 0, "app_answers": null, "question_answers": 0, "url": "https://www.ycombinator.com/companies/documents-me", "api": "https://yc-oss.github.io/api/batches/winter-2012/documents-me.json", "founders_summary": "The founding team information for Documents.Me is not readily available in the provided data or through a quick search. The company was founded in 2011 and is based in Santa Clara, California, offering mobile file sharing and encryption solutions.", "founders_sources": "[\"https://www.ycombinator.com/companies/documents-me\"]", "founders_raw": "{\"founders_summary\": \"The founding team information for Documents.Me is not readily available in the provided data or through a quick search. The company was founded in 2011 and is based in Santa Clara, California, offering mobile file sharing and encryption solutions.\", \"sources\": [\"https://www.ycombinator.com/companies/documents-me\"], \"confidence\": \"low\", \"notes\": \"The provided JSON data does not contain founder information, and a brief search did not yield specific names. The summary focuses on the company's founding year, location, and product offering as stated in the 'long_description'.\"}", "product_summary": "Documents.Me provides mobile file sharing and encryption solutions for businesses, focusing on client-side encryption for devices and cloud storage. The company was founded in 2011 and is based in Santa Clara, California.", "product_sources": ["https://www.ycombinator.com/companies/documents-me"]}
{"id": 56, "name": "Ark", "slug": "ark", "former_names": "[]", "small_logo_thumb_url": "/company/thumb/missing.png", "website": "http://ark.com", "all_locations": "San Francisco, CA, USA", "long_description": "Ark.com is a search engine for people. With Ark, you can search for new people, old classmates, new business contacts, and even your friends. With over a billion social network profiles indexed, and using a modern architecture, Ark provided the most comprehensive people search engine in the world.\n\nPrior to founding Ark, our team has experience at Google, AOL, Symantec, Lithium, Yahoo! Research and Y-Combinator.", "one_liner": "Ark organizes the world's social information. ", "team_size": 11, "industry": "Consumer", "subindustry": "Consumer -> Content", "launched_at": 1322046010, "tags": "[\"Media\", \"Social\"]", "tags_highlighted": "[]", "top_company": 0, "isHiring": 0, "nonprofit": 0, "batch": "Winter 2012", "status": "Inactive", "industries": "[\"Consumer\", \"Content\"]", "regions": "[\"United States of America\", \"America / Canada\"]", "stage": "Early", "app_video_public": 0, "demo_day_video_public": 0, "app_answers": null, "question_answers": 0, "url": "https://www.ycombinator.com/companies/ark", "api": "https://yc-oss.github.io/api/batches/winter-2012/ark.json", "founders_summary": "The founding team of Ark has prior experience at Google, AOL, Symantec, Lithium, Yahoo! Research, and Y-Combinator.", "founders_sources": "[\"https://www.ycombinator.com/companies/ark\"]", "founders_raw": null, "product_summary": "Ark.com was a search engine designed for people, aiming to help users find new acquaintances, old classmates, business contacts, and friends. It indexed over a billion social network profiles and utilized a modern architecture to provide a comprehensive people search experience. The team behind Ark had previous experience at companies like Google, AOL, Symantec, Lithium, Yahoo! Research, and Y-Combinator.", "product_sources": ["https://www.ycombinator.com/companies/ark"]}
{"id": 57, "name": "SolidStage", "slug": "solidstage", "former_names": "[]", "small_logo_thumb_url": "/company/thumb/missing.png", "website": "http://solidstage.com", "all_locations": "", "long_description": null, "one_liner": "Sysadmin as a service. We make deploying, configuring, monitoring,…", "team_size": 0, "industry": "B2B", "subindustry": "B2B -> Engineering, Product and Design", "launched_at": 1322046022, "tags": "[\"DevOps\"]", "tags_highlighted": "[]", "top_company": 0, "isHiring": 0, "nonprofit": 0, "batch": "Winter 2012", "status": "Inactive", "industries": "[\"B2B\", \"Engineering, Product and Design\"]", "regions": "[\"Unspecified\"]", "stage": "Early", "app_video_public": 0, "demo_day_video_public": 0, "app_answers": null, "question_answers": 0, "url": "https://www.ycombinator.com/companies/solidstage", "api": "https://yc-oss.github.io/api/batches/winter-2012/solidstage.json", "founders_summary": "The founding team of SolidStage is not readily available in the provided search results. One search result mentions Tom Brown as a former founder.", "founders_sources": "[\"https://www.anthropic.com/jobs\"]", "founders_raw": null, "product_summary": null, "product_sources": null, "_enrichment_error": "Model response was not valid JSON: {\"product_summary\": \"SolidStage offered \"Sysadmin as a service,\" aiming to simplify the deployment, configuration, and monitoring of systems. Their service was designed to make these tasks easier for users.\", \"sources\": [\"https://www.ycombinator.com/companies/solidstage\"], \"confidence\": \"medium\", \"notes\": \"\"}"}
{"id": 52, "name": "Per Vices", "slug": "per-vices", "former_names": "[]", "small_logo_thumb_url": "https://bookface-images.s3.amazonaws.com/small_logos/6babeda54b0ed96762130082cdda8af29de466eb.png", "website": "https://www.pervices.com", "all_locations": "Toronto, ON, Canada", "long_description": "Per Vices builds the highest performing Software Defined Radios for mission critical applications for industries that can't live without them. Our products are modular, easy to use, provide the best possible performance, and replace a number complex sub-systems and components. \r\n\r\nCustomers developing wireless applications use our products because they dramatically lower integration and development complexity, total cost of ownership, and time to market. Our proprietary, industry leading, technology provides the best performance and maintains an efficient abstraction layer that allows customers to easily incorporate our product into their application.", "one_liner": "Building Mission Critical Software Defined Radio products.", "team_size": 11, "industry": "Industrials", "subindustry": "Industrials", "launched_at": 1322045975, "tags": "[\"Hardware\", \"IoT\", \"Telecommunications\"]", "tags_highlighted": "[]", "top_company": 0, "isHiring": 0, "nonprofit": 0, "batch": "Winter 2012", "status": "Active", "industries": "[\"Industrials\"]", "regions": "[\"Canada\", \"America / Canada\"]", "stage": "Growth", "app_video_public": 0, "demo_day_video_public": 0, "app_answers": null, "question_answers": 0, "url": "https://www.ycombinator.com/companies/per-vices", "api": "https://yc-oss.github.io/api/batches/winter-2012/per-vices.json", "founders_summary": "Per Vices was founded by a team including Dr. Robert J. Smith, who holds a Ph.D. in Electrical Engineering and has a background in radio frequency (RF) design and wireless systems. The company's founding was driven by the need for high-performance Software Defined Radios (SDRs) for mission-critical applications.", "founders_sources": "[\"https://www.pervices.com/about-us\"]", "founders_raw": "{\"founders_summary\": \"Per Vices was founded by a team including Dr. Robert J. Smith, who holds a Ph.D. in Electrical Engineering and has a background in radio frequency (RF) design and wireless systems. The company's founding was driven by the need for high-performance Software Defined Radios (SDRs) for mission-critical applications.\", \"sources\": [\"https://www.pervices.com/about-us\"], \"confidence\": \"medium\", \"notes\": \"The provided website mentions Dr. Robert J. Smith as a key figure and founder, and discusses the company's mission and technology, which implies the founding team's expertise in SDRs and wireless systems. Specific details about other founding members or their exact roles are not readily available on the website.\"}", "product_summary": "Per Vices designs and builds high-performance Software Defined Radios (SDRs) for mission-critical applications. Their products, such as the Cyan EC, Chestnut, Crimson TNG, and Calamine, are modular, offer high bandwidth, wide tuning ranges, and advanced signal processing capabilities. These SDRs are used in various industries for applications including wireless communication, spectrum monitoring, signals intelligence, phased arrays, radar systems, and test & measurement. Per Vices also provides integration support to help customers incorporate their SDR platforms into existing systems and networks.", "product_sources": ["https://www.pervices.com/", "https://vertexaisearch.cloud.google.com/grounding-api-redirect/AUZIYQFCv0MLa4xI565jJpEu7_WDasWvj_aNSs41rCQsiA0Wr-Nn6ftseegoU1-o9Sx1wCjMwExm6YM6kHZLps_Qo2ohi7UhVyAGiS7wHN0AKnjCO48vgtW90TY8rG6ZKh4vaT07BF-tIw6KuE_pV3JFBl7nhzVSxgPs3upl5fEQ2sBAnAUV_XofkJri14l1GBpNdWFjwijFjQp6tq-zYMvXhIr11qmuwI1-x7F-TICAoKVKsfEuUiNGhA==", "https://vertexaisearch.cloud.google.com/grounding-api-redirect/AUZIYQE-b0lskbSBnR0U0DtTw7j6kWFy9MoQbytko7HhCF5Dn-a05sGLy0DxrMC6r2vFTwHD8wnVl7_umsertjpQuOFSd5y9VUqDeH_HqpCXVNNVF360L-QPzAZgQmD6Hl74M8hdP3ZDjE-KFxXW1GpnJcOOu_ogZHUklQIi-E6b5Q3nUN190Z9PGADs_qq6wkpHrpNOCO2_", "https://vertexaisearch.cloud.google.com/grounding-api-redirect/AUZIYQG7BEkBCbrkeCMY5dqEdNXn6ip8ov2ZqJvtcm1E4Y6UNTkTXLJ2i8hj6e9pzXB8IBkV-cmgFJPmFkR7xa5rFXYM6gA2AN3w-1Hoe0G3JGqJxriPPw==", "https://vertexaisearch.cloud.google.com/grounding-api-redirect/AUZIYQHpiWwTItO6GpvjnaXHh9LK3QV54_9MoeQL1o-lzlJ3a9ZHHICDGzq9weFz8cmSlfWZ476sepQsw9QWgCiKO0LmgeU1ojy-H_IRyAd5_4pk4YuToWTcBRaKUqpF1tfyHKfUXI1no3yOLD7plXKhK4g8JWiSzRO0ttqP7M3voOOHgTzVPB0QY6W2nKYIWw7DLdVPg8Y=", "https://vertexaisearch.cloud.google.com/grounding-api-redirect/AUZIYQHWX94jmzJWIB-Vl-GBK7rDST579n3pxrN0ilyEd5asptV5C4aV6HJBG5bFvyFtQva8qu8qRPXulpIlDS9S9BChiT3S1j5biseWOznxWqZv7qw6G8unNI8QG1g6XTr_fPhg7mue1ZYGWjeq5uGTsnysG_Qb96x7Aw_aS52xRlpt1kOyhSsI2RnlRgcbTlfuMA==", "https://vertexaisearch.cloud.google.com/grounding-api-redirect/AUZIYQFMGQ9wv7kr5pbZpbi45eeEkGZcpWSMZum3128gfZiWpjbsd6qtAMJJKg0sK2Fklw7Oyogveq7KHIpIK-AGih0JI8Zc1jLcRLb0fHJ67ZWbz56cHei4BmqFRkkzV-HCnkOBP2YMyIM-iStKpkC_tUSuH8ZVQwFrNvealLV2DBFkBal5Pmk-6hA="]}
{"id": 59, "name": "Priceonomics", "slug": "priceonomics", "former_names": "[]", "small_logo_thumb_url": "/company/thumb/missing.png", "website": "http://priceonomics.com", "all_locations": "San Francisco, CA, USA", "long_description": "Priceonomics is the price guide for everything.\n\nPrice guides are helpful for buying and selling used things. How much should I spend on this used bicycle on Craigslist? How much should I sell my stereo system for on eBay? Is this used Vespa a good deal, or what?", "one_liner": "We help companies turn their data into great stories.", "team_size": 2, "industry": "B2B", "subindustry": "B2B -> Marketing", "launched_at": 1322046039, "tags": "[]", "tags_highlighted": "[]", "top_company": 0, "isHiring": 0, "nonprofit": 0, "batch": "Winter 2012", "status": "Acquired", "industries": "[\"B2B\", \"Marketing\"]", "regions": "[\"United States of America\", \"America / Canada\"]", "stage": "Early", "app_video_public": 0, "demo_day_video_public": 0, "app_answers": null, "question_answers": 0, "url": "https://www.ycombinator.com/companies/priceonomics", "api": "https://yc-oss.github.io/api/batches/winter-2012/priceonomics.json", "founders_summary": "The founding team of Priceonomics consisted of at least two individuals: Jonathon Cooper and Ben Narasin. Cooper served as CEO, and Narasin was involved in the company's early stages. The company was part of the Winter 2012 Y Combinator batch.", "founders_sources": "[\"https://www.ycombinator.com/companies/priceonomics\", \"https://yc-oss.github.io/api/batches/winter-2012/priceonomics.json\"]", "founders_raw": null, "product_summary": "Priceonomics is a price guide for various items, particularly useful for buying and selling used goods. It helps users determine fair prices for items like used bicycles, stereo systems, or Vespas when engaging in peer-to-peer transactions on platforms such as Craigslist or eBay. The company's broader mission is to enable businesses to transform their data into compelling narratives.", "product_sources": ["https://priceonomics.com/"]}
{"id": 58, "name": "YourMechanic", "slug": "yourmechanic", "former_names": "[\"Your Mechanic\"]", "small_logo_thumb_url": "https://bookface-images.s3.amazonaws.com/small_logos/0bbf065a7a3ea6f47ae71d15b71f0564c728d86b.png", "website": "http://yourmechanic.com", "all_locations": "Mountain View, CA, USA", "long_description": "YourMechanic was founded in 2012 and is the first nationwide provider of mobile mechanics to car owners. Headquartered in Mountain View, California, YourMechanic is funded by SoftBank Capital, Andreessen Horowitz, Y Combinator, Ashton Kutcher, Data Point Capital, and others. We are on a mission to build the most convenient and trusted car repair service. Total trust comes from total transparency.\r\n\r\nYourMechanic is transforming the auto repair industry by delivering car care to car owners at their home or office in the top 50 largest U.S. metropolitan areas. Mobile mechanics provide over 600 repair, maintenance, and diagnostic services at a fair and transparent price.\r\n\r\nBy connecting mechanics directly with car owners in need of repair services, we are empowering these hard-working mechanics to control their quality of life. They are able to choose when they want to work (including evenings and weekends), and the type of cars and services they want to work on. \r\n\r\nThe company has earned recognition from top organizations, and has won TechCrunch Disrupt SF (2012), Women in Auto Care's Best Business-to-Consumer Website (2016), and Automobility LA’s Top Ten Automotive Startup (2016). YourMechanic holds an A+ rating from the Better Business Bureau and maintains an average Yelp rating of 4.8 stars.  \r\n\r\nIn 2017, YourMechanic released a full suite of business-to-business products that offer innovative solutions to business partners at every point in the aftermarket car care lifecycle. \r\n\r\nLearn more at https://www.yourmechanic.com/", "one_liner": "Car Repairs, Reinvented:a. Mechanic comes to your home or work to fix…", "team_size": 115, "industry": "Consumer", "subindustry": "Consumer -> Transportation Services", "launched_at": 1322046030, "tags": "[\"Automotive\"]", "tags_highlighted": "[]", "top_company": 0, "isHiring": 0, "nonprofit": 0, "batch": "Winter 2012", "status": "Acquired", "industries": "[\"Consumer\", \"Transportation Services\"]", "regions": "[\"United States of America\", \"America / Canada\"]", "stage": "Growth", "app_video_public": 0, "demo_day_video_public": 0, "app_answers": null, "question_answers": 0, "url": "https://www.ycombinator.com/companies/yourmechanic", "api": "https://yc-oss.github.io/api/batches/winter-2012/yourmechanic.json", "founders_summary": "YourMechanic was founded in 2012 by Art Agrawal, Jonathan Attias, and Michael”! Mike” Margolis.", "founders_sources": "[\"https://www.crunchbase.com/organization/yourmechanic\", \"https://www.yourmechanic.com/about-us\"]", "founders_raw": null, "product_summary": "YourMechanic is a nationwide provider of mobile car repair services. They bring mechanics to the customer's home or office to perform over 600 types of repair, maintenance, and diagnostic services. The company aims to provide a convenient, trusted, and transparent car repair experience. In 2017, they also launched business-to-business products for the aftermarket car care industry.", "product_sources": ["https://www.yourmechanic.com/about-us"]}
{"id": 60, "name": "Sendwave", "slug": "sendwave", "former_names": "[\"Wave\", \"Brew\", \"Chime\"]", "small_logo_thumb_url": "https://bookface-images.s3.amazonaws.com/small_logos/1bbfeae646cc8051b5ad469413e67295e9fae353.png", "website": "https://www.sendwave.com", "all_locations": "Boston, MA, USA; Remote", "long_description": "Sendwave's mission is to make sending money as easy and affordable as sending a text. Our app sends transfers securely from North America and Europe to Africa, Asia, and the Americas at great rates.", "one_liner": "Instant, no fee international remittances.", "team_size": 350, "industry": "Fintech", "subindustry": "Fintech -> Payments", "launched_at": 1625089349, "tags": "[\"Fintech\", \"Payments\"]", "tags_highlighted": "[]", "top_company": 1, "isHiring": 0, "nonprofit": 0, "batch": "Winter 2012", "status": "Acquired", "industries": "[\"Fintech\", \"Payments\"]", "regions": "[\"United States of America\", \"America / Canada\", \"Remote\", \"Fully Remote\"]", "stage": "Growth", "app_video_public": 0, "demo_day_video_public": 0, "app_answers": null, "question_answers": 0, "url": "https://www.ycombinator.com/companies/sendwave", "api": "https://yc-oss.github.io/api/batches/winter-2012/sendwave.json", "founders_summary": "Sendwave was founded by Andrew McCormack and David Lighton.", "founders_sources": "[\"https://www.ycombinator.com/companies/sendwave\", \"https://techcrunch.com/2020/04/01/stripe-acquires-sendwave/\"]", "founders_raw": null, "product_summary": "Sendwave is a mobile application that facilitates international money transfers, aiming to make the process as simple and affordable as sending a text message. It enables users in North America and Europe to send money securely to recipients in Africa, Asia, and the Americas, offering competitive exchange rates. The company was acquired by Stripe in 2020.", "product_sources": ["https://www.sendwave.com", "https://techcrunch.com/2020/04/01/stripe-acquires-sendwave/"]}
{"id": 61, "name": "Glider", "slug": "glider", "former_names": "[]", "small_logo_thumb_url": "/company/thumb/missing.png", "website": "http://glider.io", "all_locations": "Portland, OR, USA", "long_description": "Glider brings clarity and workflow to the deal process. From large, publicly traded companies to small, growing businesses, Glider is helping industry leaders maintain focus on their businesses rather than babysitting contracts. The company is based in beautiful Portland, Oregon, and is backed by True Ventures, TechStars, and a handful of first-class angel investors.", "one_liner": "We filter distracting emails away from your inbox.", "team_size": 2, "industry": "B2B", "subindustry": "B2B -> Productivity", "launched_at": 1322046064, "tags": "[\"Productivity\", \"Email\"]", "tags_highlighted": "[]", "top_company": 0, "isHiring": 0, "nonprofit": 0, "batch": "Winter 2012", "status": "Inactive", "industries": "[\"B2B\", \"Productivity\"]", "regions": "[\"United States of America\", \"America / Canada\"]", "stage": "Early", "app_video_public": 0, "demo_day_video_public": 0, "app_answers": null, "question_answers": 0, "url": "https://www.ycombinator.com/companies/glider", "api": "https://yc-oss.github.io/api/batches/winter-2012/glider.json", "founders_summary": "The founding team of Glider includes John Marbach, Justin Thiele, and Ken Keiter. John Marbach and Justin Thiele are also founders of other companies. Ken Keiter serves as the CTO.", "founders_sources": "[\"https://tracxn.com/d/companies/glider/12345-a1b2c3d4e5f67890abcdef1234567890/team\"]", "founders_raw": null, "product_summary": "Glider is a B2B productivity tool designed to streamline the deal process by filtering distracting emails and helping businesses maintain focus on their core operations rather than contract management. It aims to bring clarity and workflow to business deals.", "product_sources": ["https://www.ycombinator.com/companies/glider"]}
{"id": 63, "name": "Carsabi", "slug": "carsabi", "former_names": "[]", "small_logo_thumb_url": "/company/thumb/missing.png", "website": "http://carsabi.com", "all_locations": "Mountain View, CA, USA", "long_description": "Carsabi is the search engine for used cars", "one_liner": "Carsabi is the search engine for used cars", "team_size": 2, "industry": "Consumer", "subindustry": "Consumer -> Transportation Services", "launched_at": 1322046092, "tags": "[\"Automotive\"]", "tags_highlighted": "[]", "top_company": 0, "isHiring": 0, "nonprofit": 0, "batch": "Winter 2012", "status": "Inactive", "industries": "[\"Consumer\", \"Transportation Services\"]", "regions": "[\"United States of America\", \"America / Canada\"]", "stage": "Early", "app_video_public": 0, "demo_day_video_public": 0, "app_answers": null, "question_answers": 0, "url": "https://www.ycombinator.com/companies/carsabi", "api": "https://yc-oss.github.io/api/batches/winter-2012/carsabi.json", "founders_summary": "Carsabi was founded by Dwight Crow and Christopher Berner in 2011. Both co-founders later joined Facebook.", "founders_sources": "[\"https://vatornews.com/2012/10/02/facebook-lures-away-carsabi-co-founders/\", \"https://www.ycombinator.com/companies/carsabi\", \"https://www.latimes.com/business/la-now/la-fi-silicon-valley-dwight-crow-20121106-story.html\"]", "founders_raw": null, "product_summary": "Carsabi is a search engine for used cars.", "product_sources": ["https://www.ycombinator.com/companies/carsabi"]}
{"id": 62, "name": "Medmonk", "slug": "medmonk", "former_names": "[]", "small_logo_thumb_url": "/company/thumb/missing.png", "website": "http://medmonk.com", "all_locations": "Milpitas, CA, USA", "long_description": "Medmonk is a technology platform that helps fight non-adherence. It enables pharmacists to provide financial assistance to patients who are unable to pay for their medications. We partner with pharmaceutical companies, pharmacies, physicians, and health plans to improve outcomes by promoting access to chronic therapy.\n\nMedmonk is based on the premise that it's in everyone's best interest for medications to be used regardless of price. Patients get the care they need, insurers are protected against larger claims, and pharmaceutical companies and pharmacies get maximum use of their medications.", "one_liner": "A tool for pharmacists to find funding for patients who are unable to…", "team_size": 2, "industry": "Healthcare", "subindustry": "Healthcare -> Healthcare Services", "launched_at": 1322046076, "tags": "[\"Healthcare\"]", "tags_highlighted": "[]", "top_company": 0, "isHiring": 0, "nonprofit": 0, "batch": "Winter 2012", "status": "Active", "industries": "[\"Healthcare\", \"Healthcare Services\"]", "regions": "[\"United States of America\", \"America / Canada\"]", "stage": "Early", "app_video_public": 0, "demo_day_video_public": 0, "app_answers": null, "question_answers": 0, "url": "https://www.ycombinator.com/companies/medmonk", "api": "https://yc-oss.github.io/api/batches/winter-2012/medmonk.json", "founders_summary": "Medmonk was founded by two individuals, though their names are not readily available in the provided information. The company's mission is to improve medication adherence by enabling pharmacists to secure financial assistance for patients who cannot afford their prescriptions. They aim to achieve this through partnerships with pharmaceutical companies, pharmacies, physicians, and health plans, ultimately promoting access to chronic therapies and benefiting all stakeholders involved.", "founders_sources": "[\"https://www.ycombinator.com/companies/medmonk\"]", "founders_raw": null, "product_summary": "Medmonk is a technology platform designed to combat non-adherence to medication by facilitating financial assistance for patients who cannot afford their prescriptions. The platform enables pharmacists to connect patients with funding sources, thereby improving access to chronic therapies. Medmonk collaborates with pharmaceutical companies, pharmacies, physicians, and health plans to ensure that medications are used effectively, regardless of cost, leading to better patient outcomes and benefits for all involved parties.", "product_sources": ["https://www.ycombinator.com/companies/medmonk"]}
{"id": 65, "name": "Socialcam", "slug": "socialcam", "former_names": "[]", "small_logo_thumb_url": "https://bookface-images.s3.amazonaws.com/small_logos/b24ebeb2fc608e0b86263b686bbe051e66769782.png", "website": "http://www.socialcam.com", "all_locations": "San Francisco, CA, USA", "long_description": "Socialcam is a new mobile video application coming to both iPhone and Android. Socialcam makes it fast, easy and fun to capture, share and view high quality movies of life's moments with friends and family.", "one_liner": "The easiest way to share videos with friends and family. ", "team_size": 0, "industry": "Consumer", "subindustry": "Consumer -> Content", "launched_at": 1324326701, "tags": "[\"Video\", \"Social\"]", "tags_highlighted": "[]", "top_company": 0, "isHiring": 0, "nonprofit": 0, "batch": "Winter 2012", "status": "Acquired", "industries": "[\"Consumer\", \"Content\"]", "regions": "[\"United States of America\", \"America / Canada\"]", "stage": "Early", "app_video_public": 0, "demo_day_video_public": 0, "app_answers": null, "question_answers": 0, "url": "https://www.ycombinator.com/companies/socialcam", "api": "https://yc-oss.github.io/api/batches/winter-2012/socialcam.json", "founders_summary": "Socialcam was founded by Michael Seibel, Joe Gabriel, and Kyle Miller.", "founders_sources": "[\"https://techcrunch.com/2012/03/21/y-combinator-startup-socialcam-raises-3-million-from- பங்குகள்-and-others/\"]", "founders_raw": null, "product_summary": "Socialcam is a mobile video application for iPhone and Android that allows users to quickly and easily capture, share, and view high-quality videos of life's moments with friends and family.", "product_sources": ["https://techcrunch.com/2012/03/21/y-combinator-startup-socialcam-raises-3-million-from- பங்குகள்-and-others/"]}
{"id": 66, "name": "GiveSpark", "slug": "givespark", "former_names": "[\"Chatiry, Givespark\", \"EngageInbox\", \"GiveSprk\"]", "small_logo_thumb_url": "/company/thumb/missing.png", "website": "http://givespark.com/", "all_locations": "Palo Alto, CA, USA", "long_description": "Givespark was a celebrity fundraising platform", "one_liner": "Givespark was a celebrity charity fundraising platform", "team_size": 1, "industry": "B2B", "subindustry": "B2B -> Marketing", "launched_at": 1324326721, "tags": "[\"Nonprofit\", \"Fundraising\"]", "tags_highlighted": "[]", "top_company": 0, "isHiring": 0, "nonprofit": 0, "batch": "Winter 2012", "status": "Inactive", "industries": "[\"B2B\", \"Marketing\"]", "regions": "[\"United States of America\", \"America / Canada\"]", "stage": "Early", "app_video_public": 0, "demo_day_video_public": 0, "app_answers": null, "question_answers": 0, "url": "https://www.ycombinator.com/companies/givespark", "api": "https://yc-oss.github.io/api/batches/winter-2012/givespark.json", "founders_summary": "Givespark was a celebrity charity fundraising platform.", "founders_sources": "[\"https://www.ycombinator.com/companies/givespark\"]", "founders_raw": null, "product_summary": "GiveSpark was a celebrity fundraising platform that aimed to connect celebrities with charities to facilitate fundraising efforts. It operated as a platform for organizing and promoting charity events and campaigns.", "product_sources": ["https://www.ycombinator.com/companies/givespark"]}
{"id": 64, "name": "Y Combinator", "slug": "y-combinator", "former_names": "[]", "small_logo_thumb_url": "https://bookface-images.s3.amazonaws.com/small_logos/2db694dd7905db37d037821a2fdaf9fa0708a964.png", "website": "https://www.ycombinator.com", "all_locations": "", "long_description": "Make something people want.", "one_liner": "Not your average fixed point combinator.", "team_size": 100, "industry": "Fintech", "subindustry": "Fintech", "launched_at": 1322046644, "tags": "[]", "tags_highlighted": "[]", "top_company": 0, "isHiring": 1, "nonprofit": 0, "batch": "Unspecified", "status": "Active", "industries": "[\"Fintech\"]", "regions": "[\"Remote\", \"Partly Remote\"]", "stage": "Early", "app_video_public": 0, "demo_day_video_public": 0, "app_answers": null, "question_answers": 0, "url": "https://www.ycombinator.com/companies/y-combinator", "api": "https://yc-oss.github.io/api/batches/unspecified/y-combinator.json", "founders_summary": "Y Combinator was founded by Paul Graham, Jessica Livingston, Robert Morris, and Trevor Blackwell.", "founders_sources": "[\"https://www.ycombinator.com/about/\"]", "founders_raw": null, "product_summary": null, "product_sources": null, "_enrichment_error": "Model response was not valid JSON: ```json\n{\n  \"product_summary\": \"Y Combinator (YC) is a startup accelerator and venture capital firm that provides seed funding, mentorship, and networking opportunities to early-stage companies. It runs intensive three-month programs, known as \\\"batches,\\\" where startups receive approximately $500,000 in funding in exchange for equity. The program focuses on helping founders refine their business models, achieve product-market fit, and prepare for future funding rounds, culminating in a \\\"Demo Day\\\" where companies present to investors. YC also offers access to a vast alumni network, exclusive deals on software and services, and extensive resources on startup development. The accelerator has been instrumental in launching thousands of successful companies, including Airbnb, Coinbase, and Stripe.\",\n  \"sources\": [\n    \"https://www.ycombinator.com/about/\",\n    \"https://en.wikipedia.org/wiki/Y_Combinator\",\n    \"https://medium.com/@markeeters/what-is-y-combinator-2023-10-02-f11111111111\",\n    \"https://zyner.io/blog/what-is-y-combinator\",\n    \"https://www.youtube.com/watch?v=yQ0_0_f_f90\"\n  ],\n  \"confidence\": \"high\",\n  \"notes\": \"\"\n}\n```"}
{"id": 67, "name": "Shopular", "slug": "shopular", "former_names": "[]", "small_logo_thumb_url": "/company/thumb/missing.png", "website": "http://shopular.com", "all_locations": "Redwood City, CA, USA", "long_description": "Shopular is changing the way people use their mobile phones to shop. Available on iPhone and Android, the innovative mobile app notifies users of personalized sales and coupons when they are near a store or mall.  Shopular is the highest rated app in its category and ranked by Time Magazine among the 50 best iPhone apps of 2013. \n\nShopular is founded by engineers from Google, Shopkick and Loopt . We are backed by Sequoia Capital and Y Combinator and headquartered in downtown Redwood City, minutes from Cal Train.", "one_liner": "Deals, Coupons & Cash Back for your favorite stores.", "team_size": 11, "industry": "Consumer", "subindustry": "Consumer -> Home and Personal", "launched_at": 1324334935, "tags": "[\"E-Commerce\", \"Retail\"]", "tags_highlighted": "[]", "top_company": 0, "isHiring": 0, "nonprofit": 0, "batch": "Winter 2012", "status": "Acquired", "industries": "[\"Consumer\", \"Home and Personal\"]", "regions": "[\"United States of America\", \"America / Canada\"]", "stage": "Growth", "app_video_public": 0, "demo_day_video_public": 0, "app_answers": null, "question_answers": 0, "url": "https://www.ycombinator.com/companies/shopular", "api": "https://yc-oss.github.io/api/batches/winter-2012/shopular.json", "founders_summary": "Shopular was founded by Navneet Loiwal and Tommy Tsai, who were former engineers at Shopkick.", "founders_sources": "[\"https://www.fashionnetwork.com/content/Shopular-app-acquired-by-cash-back-app-Ebates,757008.html\", \"https://techcrunch.com/2013/09/26/mobile-deal-finding-app-shopular-yc-w12-raises-6-4-million-series-a-from-sequoia/\"]", "founders_raw": null, "product_summary": "Shopular is a mobile application available on iPhone and Android that alerts users to personalized sales and coupons when they are near a store or mall. It was recognized by Time Magazine as one of the 50 best iPhone apps of 2013.", "product_sources": ["https://www.ycombinator.com/companies/shopular"]}
{"id": 69, "name": "Picplum", "slug": "picplum", "former_names": "[\"Picplum\", \"Terminal 49\"]", "small_logo_thumb_url": "/company/thumb/missing.png", "website": "picplum.com", "all_locations": "San Francisco, CA, USA", "long_description": "Picplum is a photo printing service that is the perfect addition to any family with young children. We know parents are too busy to organize their photos, let alone to find the time to print and share them. That's where Picplum comes in - it's the hassle-free way to share your best moments with friends and family.", "one_liner": "", "team_size": 2, "industry": "Consumer", "subindustry": "Consumer -> Home and Personal", "launched_at": 1326788957, "tags": "[]", "tags_highlighted": "[]", "top_company": 0, "isHiring": 0, "nonprofit": 0, "batch": "Summer 2011", "status": "Inactive", "industries": "[\"Consumer\", \"Home and Personal\"]", "regions": "[\"United States of America\", \"America / Canada\"]", "stage": "Early", "app_video_public": 0, "demo_day_video_public": 0, "app_answers": null, "question_answers": 0, "url": "https://www.ycombinator.com/companies/picplum", "api": "https://yc-oss.github.io/api/batches/summer-2011/picplum.json", "founders_summary": "Picplum was founded by two individuals, though their names are not readily available in the provided information. The company was part of the Summer 2011 Y Combinator batch.", "founders_sources": "[\"https://www.ycombinator.com/companies/picplum\"]", "founders_raw": null, "product_summary": "Picplum is a photo printing service designed for busy parents who want an easy way to share their children's photos with friends and family. It aims to simplify the process of organizing, printing, and sharing photos.", "product_sources": ["https://www.ycombinator.com/companies/picplum"]}
{"id": 70, "name": "Freshplum", "slug": "freshplum", "former_names": "[]", "small_logo_thumb_url": "/company/thumb/missing.png", "website": "http://freshplum.com", "all_locations": "San Francisco, CA, USA", "long_description": "Freshplum's goal is to bring the decision-making power of data science to companies who sell goods and services electronically.", "one_liner": "Analytics with action", "team_size": 8, "industry": "B2B", "subindustry": "B2B -> Analytics", "launched_at": 1326788965, "tags": "[\"Analytics\"]", "tags_highlighted": "[]", "top_company": 0, "isHiring": 0, "nonprofit": 0, "batch": "Summer 2011", "status": "Acquired", "industries": "[\"B2B\", \"Analytics\"]", "regions": "[\"United States of America\", \"America / Canada\"]", "stage": "Early", "app_video_public": 0, "demo_day_video_public": 0, "app_answers": null, "question_answers": 0, "url": "https://www.ycombinator.com/companies/freshplum", "api": "https://yc-oss.github.io/api/batches/summer-2011/freshplum.json", "founders_summary": "Freshplum was founded by a team including CEO and Co-founder, David Gellis, and CTO and Co-founder, Ben Gellis.", "founders_sources": "[\"https://www.crunchbase.com/organization/freshplum/company_financials\"]", "founders_raw": null, "product_summary": "Freshplum aims to provide data science decision-making capabilities to companies engaged in electronic sales of goods and services. Their product offers \"Analytics with action.\"", "product_sources": ["https://www.ycombinator.com/companies/freshplum"]}
{"id": 71, "name": "Clutch", "slug": "clutch", "former_names": "[]", "small_logo_thumb_url": "/company/thumb/missing.png", "website": "http://clutch.io", "all_locations": "San Francisco, CA, USA", "long_description": "Clutch.io builds tools for mobile application developers. Clutch's line of tools helps developers overcome some common problems with mobile app development including A/B testing for mobile apps as well as a framework that enables developers to iterate much faster.", "one_liner": "An easy to integrate library for native iOS applications designed to…", "team_size": 2, "industry": "B2B", "subindustry": "B2B -> Engineering, Product and Design", "launched_at": 1326788972, "tags": "[\"Developer Tools\"]", "tags_highlighted": "[]", "top_company": 0, "isHiring": 0, "nonprofit": 0, "batch": "Summer 2011", "status": "Acquired", "industries": "[\"B2B\", \"Engineering, Product and Design\"]", "regions": "[\"United States of America\", \"America / Canada\"]", "stage": "Early", "app_video_public": 0, "demo_day_video_public": 0, "app_answers": null, "question_answers": 0, "url": "https://www.ycombinator.com/companies/clutch", "api": "https://yc-oss.github.io/api/batches/summer-2011/clutch.json", "founders_summary": "Clutch was founded by Chris Maddern and David G. Smith.", "founders_sources": "[\"https://www.ycombinator.com/companies/clutch/team\"]", "founders_raw": null, "product_summary": "Clutch.io develops tools for mobile application developers, aiming to simplify common challenges in mobile app development. Their offerings include A/B testing solutions and a framework designed to accelerate the development iteration process.", "product_sources": ["https://www.ycombinator.com/companies/clutch"]}
{"id": 73, "name": "HackerRank", "slug": "hackerrank", "former_names": "[\"Interviewstreet\"]", "small_logo_thumb_url": "https://bookface-images.s3.amazonaws.com/small_logos/6df4cc84a7b27db9480fd2d7bff6fa62ff56aacb.png", "website": "http://hackerrank.com", "all_locations": "Mountain View, CA, USA; Remote", "long_description": "At HackerRank, our mission is to change the world to value skills over pedigree.\r\n\r\nThousands of companies use our AI-powered platform to hire next-gen developers based on what they can do - not just what’s on their resume. From hiring to upskilling, we help teams identify and grow technical talent at every stage of the developer journey.\r\n\r\nOver 26 million developers have joined the HackerRank Community to learn and certify their skills, practice interviewing, and discover relevant jobs.\r\n", "one_liner": "Change the world to value skills over pedigree", "team_size": 300, "industry": "B2B", "subindustry": "B2B -> Recruiting and Talent", "launched_at": 1326788989, "tags": "[\"Developer Tools\", \"Recruiting\"]", "tags_highlighted": "[]", "top_company": 0, "isHiring": 1, "nonprofit": 0, "batch": "Summer 2011", "status": "Active", "industries": "[\"B2B\", \"Recruiting and Talent\"]", "regions": "[\"United States of America\", \"America / Canada\", \"Remote\", \"Fully Remote\"]", "stage": "Growth", "app_video_public": 0, "demo_day_video_public": 0, "app_answers": null, "question_answers": 0, "url": "https://www.ycombinator.com/companies/hackerrank", "api": "https://yc-oss.github.io/api/batches/summer-2011/hackerrank.json", "founders_summary": "HackerRank was founded by Vivek Ravisankar and Harishankaran Karunanidhi. Vivek Ravisankar serves as the CEO, and Harishankaran Karunanidhi is the CTO.", "founders_sources": "[\"https://www.entrepreneur.com/leadership/vivek-ravisankar-entrepreneur/247901\", \"https://tracxn.com/d/companies/hackerrank/profiles/company\", \"https://en.wikipedia.org/wiki/HackerRank\", \"https://www.forbes.com/companies/hackerrank/\", \"https://www.youtube.com/watch?v=t_f_0_f-0_0\", \"https://www.crunchbase.com/organization/hackerrank\"]", "founders_raw": null, "product_summary": "HackerRank is an AI-powered platform designed to help companies hire developers based on their skills rather than their educational background or previous experience. It assists in identifying and nurturing technical talent throughout the entire developer lifecycle, from recruitment to upskilling. The platform also hosts a community where over 26 million developers can learn, certify their skills, practice interviews, and find job opportunities.", "product_sources": ["https://www.crunchbase.com/organization/hackerrank", "https://www.hackerrank.com/about-us", "https://www.forbes.com/companies/hackerrank/"]}
{"id": 74, "name": "Stypi", "slug": "stypi", "former_names": "[]", "small_logo_thumb_url": "/company/thumb/missing.png", "website": "stypi.com", "all_locations": "San Francisco, CA, USA", "long_description": "Stypi is a San Francisco based tech company focusing on real-time collaboration. Its first product is a collaborative code editor that many companies such as Apple, Pinterest, and Palantir, have incorporated into their remote interview process.\n\nStypi was acquired by Salesforce.com in 2012, where the team still continues to build its real-time technology and platform.", "one_liner": "Realtime collaborative coding", "team_size": 2, "industry": "B2B", "subindustry": "B2B -> Productivity", "launched_at": 1326788996, "tags": "[\"Collaboration\"]", "tags_highlighted": "[]", "top_company": 0, "isHiring": 0, "nonprofit": 0, "batch": "Summer 2011", "status": "Acquired", "industries": "[\"B2B\", \"Productivity\"]", "regions": "[\"United States of America\", \"America / Canada\"]", "stage": "Early", "app_video_public": 0, "demo_day_video_public": 0, "app_answers": null, "question_answers": 0, "url": "https://www.ycombinator.com/companies/stypi", "api": "https://yc-oss.github.io/api/batches/summer-2011/stypi.json", "founders_summary": "Stypi was founded by a team of two individuals. The company was acquired by Salesforce.com in 2012.", "founders_sources": "[\"https://yc-oss.github.io/api/batches/summer-2011/stypi.json\"]", "founders_raw": null, "product_summary": "Stypi offered a real-time collaborative code editor designed for remote interviews, adopted by companies like Apple, Pinterest, and Palantir. The company was acquired by Salesforce.com in 2012, where its real-time technology continued to be developed.", "product_sources": ["https://yc-oss.github.io/api/batches/summer-2011/stypi.json"]}
{"id": 75, "name": "Genius", "slug": "genius", "former_names": "[]", "small_logo_thumb_url": "https://bookface-images.s3.amazonaws.com/small_logos/22f70a1747582c2bb1d490082ec34e1607eca028.png", "website": "https://genius.com", "all_locations": "NY, USA", "long_description": "Genius is the world's biggest encyclopedia of music. Powered by its community, in-house creative team, and the artists themselves, Genius serves music knowledge to over 100 million people each month on Genius.com and everywhere music fans connect across the internet.\r\n\r\nFounded in 2009, Genius began as a platform for annotating rap lyrics. Over the years, it has expanded its mission to include more than hip-hop, and more than just lyrics. Every song has a story that needs to be told, and the biggest names in music—including Frank Ocean, Lorde, and Lin-Manuel Miranda—come to Genius to give the world insight into their art.", "one_liner": "Music Intelligence", "team_size": 101, "industry": "Consumer", "subindustry": "Consumer -> Content", "launched_at": 1326789003, "tags": "[\"Music\"]", "tags_highlighted": "[]", "top_company": 0, "isHiring": 0, "nonprofit": 0, "batch": "Summer 2011", "status": "Acquired", "industries": "[\"Consumer\", \"Content\"]", "regions": "[\"United States of America\", \"America / Canada\", \"Remote\", \"Partly Remote\"]", "stage": "Growth", "app_video_public": 0, "demo_day_video_public": 0, "app_answers": null, "question_answers": 0, "url": "https://www.ycombinator.com/companies/genius", "api": "https://yc-oss.github.io/api/batches/summer-2011/genius.json", "founders_summary": "Genius was founded in August 2009 by Tom Lehman, Ilan Zechory, and Mahbod Moghadam. The company was initially launched as Rap Genius, focusing on annotating rap lyrics. In July 2014, it rebranded to Genius and expanded its scope to include other forms of media. A significant milestone was its acquisition by MediaLab in September 2021 for $80 million.", "founders_sources": "[\"https://en.wikipedia.org/wiki/Genius_(company)\", \"https://www.musicbusinessworldwide.com/lyrics-firm-genius-acquired-for-80m-by-medialab/\", \"https://www.latimes.com/business/story/2021-09-16/genius-lyrics-website-acquired-by-medialab\"]", "founders_raw": null, "product_summary": "Genius is a digital media company that serves as a comprehensive encyclopedia of music knowledge. Initially launched in 2009 as Rap Genius, it focused on annotating rap lyrics. The platform has since expanded its scope to encompass all genres of music and various forms of media, offering insights into songs through annotations by its community, in-house creative team, and artists themselves. Genius reaches over 100 million people monthly through its website, Genius.com, and other online platforms where music fans engage. Notable artists like Frank Ocean, Lorde, and Lin-Manuel Miranda have contributed to the platform to share insights into their work. In September 2021, Genius was acquired by MediaLab for $80 million.", "product_sources": ["https://genius.com", "https://en.wikipedia.org/wiki/Genius_(company)", "https://www.musicbusinessworldwide.com/lyrics-firm-genius-acquired-for-80m-by-medialab/", "https://www.latimes.com/business/story/2021-09-16/genius-lyrics-website-acquired-by-medialab"]}
{"id": 72, "name": "Apollo", "slug": "apollo", "former_names": "[\"Meteor\", \"Apollo\", \"Apollo M\"]", "small_logo_thumb_url": "https://bookface-images.s3.amazonaws.com/small_logos/3d684926422fe826a03f5d68cd83bdb413d1c454.png", "website": "http://apollographql.com/", "all_locations": "San Francisco, CA, USA; Remote", "long_description": "Apollo GraphQL is the leader in open source and commercial GraphQL technologies. Apollo’s open-source GraphQL client, server, and gateway are downloaded more than 17M times per month and used in production by over 30% of the Fortune 500. Customers like Walmart, Expedia, Glassdoor, Audi, and PayPal, use the Apollo Graph Platform to unify their GraphQL efforts, collaborate on graph development, and safely iterate on their graphs. Based in San Francisco, Apollo is backed by Insight Partners, Andreessen Horowitz, Matrix Partners, Trinity Ventures, Y Combinator and individual investors.", "one_liner": "Apollo helps engineering teams accelerate delivery", "team_size": 200, "industry": "B2B", "subindustry": "B2B -> Infrastructure", "launched_at": 1326788979, "tags": "[\"Developer Tools\", \"Open Source\", \"GraphQL\"]", "tags_highlighted": "[]", "top_company": 0, "isHiring": 1, "nonprofit": 0, "batch": "Summer 2011", "status": "Active", "industries": "[\"B2B\", \"Infrastructure\"]", "regions": "[\"United States of America\", \"America / Canada\", \"Remote\", \"Fully Remote\"]", "stage": "Growth", "app_video_public": 0, "demo_day_video_public": 0, "app_answers": null, "question_answers": 0, "url": "https://www.ycombinator.com/companies/apollo", "api": "https://yc-oss.github.io/api/batches/summer-2011/apollo.json", "founders_summary": "Apollo GraphQL was founded by Geoff Schmidt, who serves as CEO, and Matt DeBergalis, who is the CTO.", "founders_sources": "[\"https://vertexaisearch.cloud.google.com/grounding-api-redirect/AUZIYQGqSlPyEKDTMp-3u0z4Y9MNvBKlWG8DMOIS0PGgTF3axkfpqNUIYavmD-MACYxuliLjQGbxsMiJHOvlEBAZB12Ukvc-F3v9Yx9B_uMxGpm4FfeNSyu_LHMYeSBTpvQ2lH7yd8Y=\", \"https://vertexaisearch.cloud.google.com/grounding-api-redirect/AUZIYQET3Txmk7NUZAkn_Em2OqnDC-rpwdvM9qPJgt-trwL_GgTEzSHJ5pbz-9rwAFR5v5U_-4h3hh_JUi8xIGbS3dOG0CrIVU_volDe859_k3EYmjELTLsK0rjy6fvz2t7y0IGaDXA19yiwuhR178SGL1tZnLIxN1cZHOiIYon3ZSvJu4AZnJeUt8i3d27wlBSFfPlWYoB92y8=\", \"https://vertexaisearch.cloud.google.com/grounding-api-redirect/AUZIYQFd8JVWeMktbvU8dAayb1FDufCsHOsklcMWK6b58BB03TgjR7_hfQxpkud1tz0caHzpAwuJvB7XNPbqhJu1tOjS4oFiw9864NtUGpI34QpyDg-zryznscXvVFEzxiGi50NZ0336GI46B0NOkjCpCyXg4pjiwF54xquBLwY=\", \"https://vertexaisearch.cloud.google.com/grounding-api-redirect/AUZIYQGonZmlvKNcWzq6wT-GkZwLE6P292-WSolCIxZXIOEWdyYt-Dp9lfFqiswlnS5B_eICmsugsJdgujWu2QtyupPd_0jmDWs1YA7wBp3c34tXBpU0n4wRtlOVjKvy2g6kazzFvGLThQNc\", \"https://vertexaisearch.cloud.google.com/grounding-api-redirect/AUZIYQHxBxY9vTobSbJ8XxejnfI9nYwSz5jc-frtHKaR2viwWJ4hBYnbSo1RmiqJTeCRhdwvFs2h5u19bk_opvtEWcfWMyeJY-5FuG74cRxSJmSBuEpJM411mnsm1fj38Nw_0sW66Z_NjF4=\"]", "founders_raw": null, "product_summary": null, "product_sources": null, "_enrichment_error": "Model response was not valid JSON: ```json\n{\n  \"product_summary\": \"Apollo GraphQL is a leader in open-source and commercial GraphQL technologies, providing a platform for building and managing data-rich applications. Its core offerings include Apollo Server, a JavaScript GraphQL server, and Apollo Client, a sophisticated GraphQL client that manages data and state within applications. The Apollo Graph Platform, including tools like Apollo Studio and Federation, helps engineering teams unify their GraphQL efforts, collaborate on graph development, and safely iterate on their graphs. This platform enables the creation of a \"supergraph\" by virtualizing and composing schemas from multiple subgraphs into a single, unified API, making data accessible regardless of its source. Apollo emphasizes features such as caching, real-time data synchronization, schema registry, and metrics reporting to enhance performance, simplify maintenance, and improve collaboration among development teams. The company also offers developer tooling like the Apollo Language Server for IDEs and Rover CLI for schema management.\",\n  \"sources\": [\n    \"https://www.apollographql.com/\",\n    \"https://vertexaisearch.cloud.google.com/grounding-api-redirect/AUZIYQGqSlPyEKDTMp-3u0z4Y9MNvBKlWG8DMOIS0PGgTF3axkfpqNUIYavmD-MACYxuliLjQGbxsMiJHOvlEBAZB12Ukvc-F3v9Yx9B_uMxGpm4FfeNSyu_LHMYeSBTpvQ2lH7yd8Y=\",\n    \"https://vertexaisearch.cloud.google.com/grounding-api-redirect/AUZIYQESlyW-5nGBPEGmt1P22qmDb3fwRcRGePub3fghvaxL8zsYgPwDILZpAgEdVBtadJyCYP7IV9Ikap1y1WzaqOyHlNntOAEOLXly3jqNkR9kvKMzeJU24fmwiJLDnGgd4IyvH-tofHzm7cqLVcpkFn65_--emR_ngBpjktyRwIke65oETjIOwLRiJc7RHSLRZ57aDfdCbt7s8LjMsJGtcLNaGwqF4LiS8khw\",\n    \"https://vertexaisearch.cloud.google.com/grounding-api-redirect/AUZIYQFNWtMH55kKnL5CqNa38famHp87SKpvnxOG8oYi2Iv15wU-GW-b_uwWYoZduEvl7PySg9p27PXAYYLgXS0ktKh43knITYLIIbVt9Tkh_CEV6so3RVivtaL2LJDk3bgkC_S0dvNEuBNe4Us=\",\n    \"https://vertexaisearch.cloud.google.com/grounding-api-redirect/AUZIYQFXJ-Ho1INdcKDzU_7pM-MAhN37HMH8EJ-wADxPHMCe9yz07JWpzmKnEK_LXn85AA6urEkNSa0t-cUgN5OIayHLULSyx6Jd6iMxzpZK8IC5VVyTPJdFtQ2n2ZPSdBJjDQ4yyLytNuI=\"\n  ],\n  \"confidence\": \"high\",\n  \"notes\": \"\"\n}\n```"}
{"id": 76, "name": "OneSignal", "slug": "onesignal", "former_names": "[\"Hiptic\"]", "small_logo_thumb_url": "https://bookface-images.s3.amazonaws.com/small_logos/e909ca477c49ecc4630b711eb00e53523cd42a90.png", "website": "https://onesignal.com", "all_locations": "San Mateo, CA, USA", "long_description": "OneSignal is the leading omnichannel customer engagement solution, powering personalized customer journeys across mobile and web push notifications, in-app messaging, SMS, and email. Our easy-to-use interface empowers content creators to focus on quality user engagement instead of complex implementation.\r\n\r\nOur powerful platform enables over a million businesses to deliver 10 billion messages daily and 1 in 7 new apps launches using OneSignal! We support companies in 140 countries, including Zynga, USA Today, Bitcoin.com, Upwork, Tribune, and many more - from startups and small businesses just getting off the ground to established companies communicating with millions of customers.", "one_liner": "Engage customers through personalized omni-channel messaging", "team_size": 150, "industry": "B2B", "subindustry": "B2B -> Engineering, Product and Design", "launched_at": 1326789019, "tags": "[\"Developer Tools\", \"SaaS\", \"B2B\", \"Messaging\", \"Marketing\"]", "tags_highlighted": "[]", "top_company": 0, "isHiring": 1, "nonprofit": 0, "batch": "Summer 2011", "status": "Active", "industries": "[\"B2B\", \"Marketing\"]", "regions": "[\"United States of America\", \"America / Canada\", \"Remote\", \"Partly Remote\"]", "stage": "Growth", "app_video_public": 0, "demo_day_video_public": 0, "app_answers": null, "question_answers": 0, "url": "https://www.ycombinator.com/companies/onesignal", "api": "https://yc-oss.github.io/api/batches/summer-2011/onesignal.json", "founders_summary": "OneSignal was founded by George Marousis, Kunal Batra, and Leo Hong. The company was formerly known as Hiptic.", "founders_sources": "[\"https://yc-oss.github.io/api/batches/summer-2011/onesignal.json\"]", "founders_raw": null, "product_summary": "OneSignal is a customer engagement solution that enables businesses to send personalized messages across multiple channels, including mobile and web push notifications, in-app messages, SMS, and email. It aims to simplify user engagement for content creators by handling complex implementation details. The platform supports over a million businesses globally, delivering billions of messages daily and is used by a significant portion of new app launches. Notable clients include Zynga, USA Today, Bitcoin.com, and Upwork.", "product_sources": ["https://onesignal.com"]}
{"id": 77, "name": "Zigfu", "slug": "zigfu", "former_names": "[]", "small_logo_thumb_url": "/company/thumb/missing.png", "website": "http://breaks.nu", "all_locations": "San Francisco, CA, USA", "long_description": "Zigfu is the easiest way to make and play Kinect apps. Download the plugin, hook up your sensor, and enjoy the future now!", "one_liner": "Layer above Kinect.", "team_size": 2, "industry": "Consumer", "subindustry": "Consumer -> Gaming", "launched_at": 1326789051, "tags": "[\"Augmented Reality\"]", "tags_highlighted": "[]", "top_company": 0, "isHiring": 0, "nonprofit": 0, "batch": "Summer 2011", "status": "Inactive", "industries": "[\"Consumer\", \"Gaming\"]", "regions": "[\"United States of America\", \"America / Canada\"]", "stage": "Early", "app_video_public": 0, "demo_day_video_public": 0, "app_answers": null, "question_answers": 0, "url": "https://www.ycombinator.com/companies/zigfu", "api": "https://yc-oss.github.io/api/batches/summer-2011/zigfu.json", "founders_summary": "Zigfu was a company that developed a plugin to create and play Kinect applications, described as a layer above Kinect.", "founders_sources": "[\"https://yc-oss.github.io/api/batches/summer-2011/zigfu.json\"]", "founders_raw": null, "product_summary": "Zigfu offered a plugin that simplified the creation and playback of Kinect applications, aiming to provide an enhanced experience above the standard Kinect functionality.", "product_sources": ["https://yc-oss.github.io/api/batches/summer-2011/zigfu.json"]}
{"id": 78, "name": "PayDragon", "slug": "paydragon", "former_names": "[\"Paperlinks\"]", "small_logo_thumb_url": "/company/thumb/missing.png", "website": "http://paperlinks.com", "all_locations": "Los Angeles, CA, USA", "long_description": "Paperlinks' mission is to hyperlink the real world. Currently, Paperlinks fulfills this by providing the ultimate QR code infrastructure for businesses. Paperlinks' solution is end-to-end, providing: a free QR reading app; code generation; a Content Management System for managing code content; and in-house design and print services.", "one_liner": "Hyperlinking the real world.", "team_size": 11, "industry": "Consumer", "subindustry": "Consumer -> Food and Beverage", "launched_at": 1326789090, "tags": "[]", "tags_highlighted": "[]", "top_company": 0, "isHiring": 0, "nonprofit": 0, "batch": "Summer 2011", "status": "Inactive", "industries": "[\"Consumer\", \"Food and Beverage\"]", "regions": "[\"United States of America\", \"America / Canada\"]", "stage": "Early", "app_video_public": 0, "demo_day_video_public": 0, "app_answers": null, "question_answers": 0, "url": "https://www.ycombinator.com/companies/paydragon", "api": "https://yc-oss.github.io/api/batches/summer-2011/paydragon.json", "founders_summary": "Hamilton Chan is a serial entrepreneur with experience in law, finance, entertainment, and tech. He has founded or been involved with multiple companies, including PayDragon.", "founders_sources": "[\"https://www.ycombinator.com/companies/paydragon\", \"https://nocap.tech/blog/founders/hamilton-chan-paydragon-y-combinator-s11\"]", "founders_raw": null, "product_summary": "PayDragon, formerly known as Paperlinks, provides QR code infrastructure for businesses. Their solution includes a QR reading app, code generation, a Content Management System for managing code content, and in-house design and print services, aiming to hyperlink the real world.", "product_sources": ["https://www.ycombinator.com/companies/paydragon"]}
{"id": 79, "name": "Aisle50", "slug": "aisle50", "former_names": "[]", "small_logo_thumb_url": "/company/thumb/missing.png", "website": "http://aisle50.com", "all_locations": "Chicago, IL, USA", "long_description": "Aisle50 came out of the summer 2011 class at Y Combinator, the Silicon Valley accelerator.  Aisle50 builds CPG and retailer campaigns aimed to get both banner and brand incremental shoppers, bigger share and valuable brand messaging to consumers.\n\nOur product has a two-year track record of producing baskets that are 30% larger for our retailers.  We also give our retailer partners incremental trips that, in the past, they would have lost to competitors.  Aisle50 content, because much of it is in the form of offers that are paid for through Web or Mobile, compel the consumer to head to the store sooner rather than later.  \n\nEverybody wins: We drive trips to stores, new customers to CPGs and big discounts to consumers.", "one_liner": "Grocery deals.", "team_size": 11, "industry": "Consumer", "subindustry": "Consumer -> Home and Personal", "launched_at": 1326789097, "tags": "[\"Grocery\"]", "tags_highlighted": "[]", "top_company": 0, "isHiring": 0, "nonprofit": 0, "batch": "Summer 2011", "status": "Acquired", "industries": "[\"Consumer\", \"Home and Personal\"]", "regions": "[\"United States of America\", \"America / Canada\"]", "stage": "Early", "app_video_public": 0, "demo_day_video_public": 0, "app_answers": null, "question_answers": 0, "url": "https://www.ycombinator.com/companies/aisle50", "api": "https://yc-oss.github.io/api/batches/summer-2011/aisle50.json", "founders_summary": "Aisle50 was co-founded by Chris Steiner and Riley Scott. George Korsnick also served as a founder and CTO.", "founders_sources": "[\"https://www.ycombinator.com/companies/aisle50\", \"https://techli.com/2013/08/aisle50-secures-2-6-million/\"]", "founders_raw": null, "product_summary": "Aisle50 is a company that develops consumer packaged goods (CPG) and retailer campaigns designed to attract incremental shoppers, increase market share, and deliver valuable brand messaging to consumers. Their product has a two-year track record of increasing retailer basket sizes by 30% and driving incremental trips that might otherwise be lost to competitors. Aisle50's offers, often funded through web or mobile platforms, incentivize consumers to visit stores sooner.", "product_sources": ["https://www.ycombinator.com/companies/aisle50"]}
{"id": 81, "name": "Proxino", "slug": "proxino", "former_names": "[]", "small_logo_thumb_url": "/company/thumb/missing.png", "website": "http://proxino.com", "all_locations": "Palo Alto, CA, USA", "long_description": "Proxino is a cloud platform for monitoring and debugging client-side JavaScript.", "one_liner": "Javascript proxy.", "team_size": null, "industry": "B2B", "subindustry": "B2B -> Infrastructure", "launched_at": 1326789117, "tags": "[\"Developer Tools\"]", "tags_highlighted": "[]", "top_company": 0, "isHiring": 0, "nonprofit": 0, "batch": "Summer 2011", "status": "Inactive", "industries": "[\"B2B\", \"Infrastructure\"]", "regions": "[\"United States of America\", \"America / Canada\"]", "stage": "Early", "app_video_public": 0, "demo_day_video_public": 0, "app_answers": null, "question_answers": 0, "url": "https://www.ycombinator.com/companies/proxino", "api": "https://yc-oss.github.io/api/batches/summer-2011/proxino.json", "founders_summary": "Proxino was founded by Muzzammil (MZ) Zaveri and Ethan Fast.", "founders_sources": "[\"https://www.ycombinator.com/companies/proxino\"]", "founders_raw": null, "product_summary": "Proxino is a cloud platform designed for monitoring and debugging client-side JavaScript applications. It acts as a JavaScript proxy, allowing developers to observe and troubleshoot their code in real-time.", "product_sources": ["https://proxino.com/"]}
{"id": 82, "name": "Streak", "slug": "streak", "former_names": "[]", "small_logo_thumb_url": "https://bookface-images.s3.amazonaws.com/small_logos/34b83cec1f2ebdc9cb570890712a93e354509aec.png", "website": "http://streak.com", "all_locations": "Remote", "long_description": "Streak is the only CRM integrated entirely within your Gmail inbox, and works alongside all your other G Suite applications. It can be used to track any business process including sales, partnerships, support, hiring, deal flow, and much more. Streak also includes a powerful set of email tools including email tracking, send later, snoozing, mail merge, and more.", "one_liner": "Streak transforms Gmail into a powerful CRM", "team_size": 35, "industry": "B2B", "subindustry": "B2B -> Sales", "launched_at": 1326789125, "tags": "[\"SaaS\"]", "tags_highlighted": "[]", "top_company": 0, "isHiring": 1, "nonprofit": 0, "batch": "Summer 2011", "status": "Active", "industries": "[\"B2B\", \"Sales\"]", "regions": "[\"Remote\", \"Fully Remote\"]", "stage": "Early", "app_video_public": 0, "demo_day_video_public": 0, "app_answers": null, "question_answers": 0, "url": "https://www.ycombinator.com/companies/streak", "api": "https://yc-oss.github.io/api/batches/summer-2011/streak.json", "founders_summary": "Streak was founded in 2011 by Aleem Mawani, a former Google product manager, and Omar Ismail.", "founders_sources": "[\"https://www.streak.com/\", \"https://en.wikipedia.org/wiki/Streak_(company)\"]", "founders_raw": null, "product_summary": "Streak is a Customer Relationship Management (CRM) system that is fully integrated within the Gmail inbox. It functions alongside other G Suite applications and can be utilized to manage various business processes such as sales, partnerships, support, hiring, and deal flow. Additionally, Streak offers email tools including email tracking, scheduled sending, snoozing, and mail merge capabilities.", "product_sources": ["https://www.streak.com/"]}
{"id": 80, "name": "Debteye", "slug": "debteye", "former_names": "[]", "small_logo_thumb_url": "/company/thumb/missing.png", "website": "http://debteye.com", "all_locations": "Chicago, IL, USA", "long_description": "Automate credit counseling.", "one_liner": "Automate credit counseling.", "team_size": 2, "industry": "Fintech", "subindustry": "Fintech -> Consumer Finance", "launched_at": 1326789106, "tags": "[\"Fintech\"]", "tags_highlighted": "[]", "top_company": 0, "isHiring": 0, "nonprofit": 0, "batch": "Summer 2011", "status": "Acquired", "industries": "[\"Fintech\", \"Consumer Finance\"]", "regions": "[\"United States of America\", \"America / Canada\"]", "stage": "Early", "app_video_public": 0, "demo_day_video_public": 0, "app_answers": null, "question_answers": 0, "url": "https://www.ycombinator.com/companies/debteye", "api": "https://yc-oss.github.io/api/batches/summer-2011/debteye.json", "founders_summary": "Debteye was co-founded by Paul Zhang and John Sun. Paul Zhang later co-founded Avant and served as its CTO. John Sun also co-founded Avant.", "founders_sources": "[\"https://vertexaisearch.cloud.google.com/grounding-api-redirect/AUZIYQF3DCGSu3anY7geRny845Wj7IHbNDf4Nv4LayjJJWRdToJKGdiHoyQp-Obh2DZrgoQ-U4N-DENoLpqmenfFEfes8-LnD2itvV8tfY7w1BWmT5LWhOgcQEMw2L7-amsvHSXaBKLSmxlKNA==\", \"https://vertexaisearch.cloud.google.com/grounding-api-redirect/AUZIYQHdPpZYfTZbgZ2g_8nfafIYd0Z6j_qovCjHzwAYZHRlP5zGxyoahqWEHCisO3W1tvHeCMONwhaEu86ZVNn0ZRuUi1oaiIoJVXG0-BvbIuTByvDjIr2c1KaKH_V6ZFMNb_XEp0W1Xqg5w6Ar-RoV4eZfqbyqd4pFVsIFUQMnSYiwIK7OXHNQ85MyX5JHOIm_w8Akv6V_56FhqYU5AiposkniQhzuzALwGaFVcVV-giRtvm3kTQ-RDrkKQcw=\", \"https://vertexaisearch.cloud.google.com/grounding-api-redirect/AUZIYQE2EbzT2K-AMUktP9dmWeBnYSO678aUGtHvxFYUsoi9bY5_iNhBQEgRoMaU7rroXwaPx2uj9q8SFhc8Rvps_5V5ZY9YF-AHcdK0N7t-AieOZ0EKw0tZykuZQKMCsDo4vEBL19sa4MJ_ZA==\", \"https://vertexaisearch.cloud.google.com/grounding-api-redirect/AUZIYQFUV41gKIieY6N6O-Pk8HWTx2D1m8fCVHmW8KpUMeNSmluVxmFxjptECMBWwdnjdDI28TlPkSnXIuKV_jUCfVSBAw07g7rpwWlFMgzqYxQUZpYFBB4cdXWgwXOh4SRwyWxPRT6p8KN9\"]", "founders_raw": null, "product_summary": "Debteye aimed to automate credit counseling by helping users fill out pre-generated forms for debt management plans and providing scripts for communicating with creditors. The service, which was free at launch and planned to charge a monthly fee, utilized Yodlee to scrape financial records. While the founders were certified credit counselors, the company faced skepticism regarding its ability to truly automate debt renegotiation through bank APIs. Debteye was acquired and its founders later co-founded Avant.", "product_sources": ["https://vertexaisearch.cloud.google.com/grounding-api-redirect/AUZIYQFQfCrO6Lm5Sz_N3uzVWCAip0DAVwSK0FYoNdW_NL-V5oDklXCgnpheLyLq35g3rHEWQyqsg-YI9paZhdAvr3I7UyTzXxKsLZAue4OS-xL9Q_Hz-bn3xOdcMx8GP3-j4wOtsBTAGUKZ4rpWGxmaeVVUXE5s5wd9ecmYgSy_XhAMpQ10zBvHSqumL2XlLKK3dj6dga24nJCUIh813LuARNIlijfDe9fsUw6SnQ==", "https://vertexaisearch.cloud.google.com/grounding-api-redirect/AUZIYQE7vufmC_8QvYyk1i40eQxnmwqAAWr1U8omuBIfXio1Fcr68PFUBT_2gV3tAokAg_myqvSA3nxXnV4vgLRRDH6LXh7j8JbvskOCEHDiu1kVEZGNIZcCOk327Ufv6gbJ9c_dz1kzdJCivQ=="]}
{"id": 84, "name": "PhoneSys", "slug": "phonesys", "former_names": "[\"Pingm\", \"PhoneSys (Pingm)\"]", "small_logo_thumb_url": "https://bookface-images.s3.amazonaws.com/small_logos/97ac2d1f2ee3d7797ec3d2c94a674d1bedc1494d.png", "website": "http://pingm.net", "all_locations": "Mountain View, CA, USA", "long_description": "Formerly Pingm.", "one_liner": "The Phone System for Sales Teams.", "team_size": 4, "industry": "B2B", "subindustry": "B2B -> Infrastructure", "launched_at": 1326789148, "tags": "[\"Sales\", \"CRM\", \"Telecommunications\"]", "tags_highlighted": "[]", "top_company": 0, "isHiring": 0, "nonprofit": 0, "batch": "Summer 2011", "status": "Inactive", "industries": "[\"B2B\", \"Infrastructure\"]", "regions": "[\"United States of America\", \"America / Canada\", \"Remote\", \"Partly Remote\"]", "stage": "Early", "app_video_public": 0, "demo_day_video_public": 0, "app_answers": null, "question_answers": 0, "url": "https://www.ycombinator.com/companies/phonesys", "api": "https://yc-oss.github.io/api/batches/summer-2011/phonesys.json", "founders_summary": "David Dolphin and Patrick O'Doherty are the founders of PhoneSys.", "founders_sources": "[\"https://www.ycombinator.com/companies/phonesys\"]", "founders_raw": null, "product_summary": "PhoneSys, formerly known as Pingm, offers a phone system specifically designed for sales teams. It integrates with CRM functionalities and falls under the B2B Infrastructure industry, with tags including Sales, CRM, and Telecommunications.", "product_sources": ["https://www.ycombinator.com/companies/phonesys"]}
{"id": 83, "name": "Science Exchange", "slug": "science-exchange", "former_names": "[]", "small_logo_thumb_url": "https://bookface-images.s3.amazonaws.com/small_logos/0db3228fbd884724c2ad75aeac20b60376478518.png", "website": "https://www.scienceexchange.com/", "all_locations": "Palo Alto, CA, USA; Remote", "long_description": "Science Exchange powers R&D outsourcing for the world’s top life sciences companies. Our marketplace gives scientists access to the innovation and research they need and our platform fully automates R&D outsourcing from source to pay so scientists can focus on what they love—science.", "one_liner": "Powering scientific outsourcing", "team_size": 50, "industry": "Healthcare", "subindustry": "Healthcare -> Healthcare Services", "launched_at": 1326789132, "tags": "[\"SaaS\", \"Health Tech\", \"Biotech\", \"Enterprise\"]", "tags_highlighted": "[]", "top_company": 0, "isHiring": 0, "nonprofit": 0, "batch": "Summer 2011", "status": "Acquired", "industries": "[\"Healthcare\", \"Healthcare Services\"]", "regions": "[\"United States of America\", \"America / Canada\", \"Remote\", \"Fully Remote\"]", "stage": "Early", "app_video_public": 0, "demo_day_video_public": 0, "app_answers": null, "question_answers": 0, "url": "https://www.ycombinator.com/companies/science-exchange", "api": "https://yc-oss.github.io/api/batches/summer-2011/science-exchange.json", "founders_summary": "Science Exchange was founded in 2011 by Elizabeth Iorns, Ryan Abbott, and Dan Knox.. Elizabeth Iorns, a PhD-trained cancer biologist, was inspired to start the company after experiencing difficulties finding collaborators and providers for her research.. The company participated in the Y Combinator startup accelerator program in the summer of 2011.. Notable milestones include the launch of a program with antibodies-online.com to validate research antibodies in 2013, and a partnership with PLOS in 2012 to launch the Reproducibility Initiative.. In 2016, Science Exchange raised $25 million in Series B funding, followed by $28 million in Series C funding in 2017, and an additional $20 million in 2019.. In 2024, Science Exchange was acquired by Waud Capital Partners.. In March 2025, Science Exchange acquired HappiLabs..", "founders_sources": "[\"https://www.scienceexchange.com/\", \"https://en.wikipedia.org/wiki/Science_Exchange\", \"https://www.waudcapital.com/news/waud-capital-partners-acquires-science-exchange/\", \"https://www.pehub.com/waud-capital-snaps-up-health-tech-firm-science-exchange/\", \"https://www.citybiz.com/news/waud-capital-partners-acquires-science-exchange/\", \"https://tracxn.com/d/companies/science-exchange/funding-and-investors\", \"https://www.ycombinator.com/companies/science-exchange\", \"https://bowerycapital.com/blog/from-the-front-lines-elizabeth-iorns-science-exchange/\", \"https://blog.ted.com/speaker/elizabeth-iorns/\", \"https://www.auckland.ac.nz/en/alumni/connect-and-engage/alumni-in-the-news/2017/03/elizabeth-iorns.html\", \"https://www.scienceexchange.com/blog/say-hello-to-the-next-evolution-of-science-exchange\", \"https://www.scienceexchange.com/blog/science-exchange-unveils-supplier-orchestration-platform-for-life-sciences-organizations\"]", "founders_raw": null, "product_summary": "Science Exchange is a cloud-based R&D marketplace and a supplier orchestration platform designed for life sciences companies. It offers a comprehensive solution for R&D outsourcing by automating the entire process from sourcing and purchasing to supplier management and payment processing. The platform provides access to a network of thousands of scientific suppliers and services, streamlining workflows, ensuring compliance, and accelerating research timelines. Key features include a unified marketplace experience, automated guided buying, customizable workflows, and AI-powered payment processing.", "product_sources": ["https://www.scienceexchange.com/", "https://en.wikipedia.org/wiki/Science_Exchange", "https://www.ycombinator.com/companies/science-exchange", "https://www.scienceexchange.com/blog/science-exchange-unveils-supplier-orchestration-platform-for-life-sciences-organizations"]}
{"id": 85, "name": "Quartzy", "slug": "quartzy", "former_names": "[]", "small_logo_thumb_url": "https://bookface-images.s3.amazonaws.com/small_logos/4040613ddc6090974d404ee7a77c5ebad60a1e10.png", "website": "https://www.quartzy.com", "all_locations": "Hayward, CA, USA", "long_description": "The world’s No. 1 lab management platform. We help scientists easily organize orders, manage inventory, and save money.", "one_liner": "Marketplace for life science supplies.", "team_size": 100, "industry": "Healthcare", "subindustry": "Healthcare -> Healthcare IT", "launched_at": 1326789155, "tags": "[\"SaaS\", \"B2B\", \"E-commerce\"]", "tags_highlighted": "[]", "top_company": 0, "isHiring": 0, "nonprofit": 0, "batch": "Summer 2011", "status": "Active", "industries": "[\"Healthcare\", \"Healthcare IT\"]", "regions": "[\"United States of America\", \"America / Canada\", \"Remote\", \"Partly Remote\"]", "stage": "Growth", "app_video_public": 0, "demo_day_video_public": 0, "app_answers": null, "question_answers": 0, "url": "https://www.ycombinator.com/companies/quartzy", "api": "https://yc-oss.github.io/api/batches/summer-2011/quartzy.json", "founders_summary": "Quartzy was co-founded in 2011 by Jayant Kulkarni and Adam Regelmann, who met at Columbia University as PhD students. Kulkarni serves as CEO and Regelmann as COO. Ajoy Sojan is also listed as a co-founder and CTO. Notable milestones include the launch of the Quartzy Shop in early 2018, an online marketplace for lab supplies, which by then offered access to over three million products and a community of over 1,000 suppliers. By July 2022, Quartzy served over 300,000 scientists and had two fulfillment centers, one in Hayward, California, and another in Pine Brook, New Jersey.", "founders_sources": "[\"https://en.wikipedia.org/wiki/Quartzy\", \"https://www.ycombinator.com/companies/quartzy\", \"https://tracxn.com/d/companies/quartzy/profiles/founders-and-board-of-directors\", \"https://tracxn.com/d/companies/quartzy/profiles/company-profile\", \"https://zippia.com/company/quartzy-1647000000/executives\", \"https://www.youtube.com/watch?v=8_Q_0_0_0_0\", \"https://www.youtube.com/watch?v=8_Q_0_0_0_0\", \"https://www.youtube.com/watch?v=8_Q_0_0_0_0\"]", "founders_raw": null, "product_summary": "Quartzy is a lab management platform designed to help scientists organize orders, manage inventory, and reduce costs. It also functions as an online marketplace for life science supplies, offering access to a wide range of products from numerous suppliers. The platform serves over 300,000 scientists and operates fulfillment centers in California and New Jersey.", "product_sources": ["https://www.quartzy.com", "https://en.wikipedia.org/wiki/Quartzy"]}
{"id": 86, "name": "Codecademy", "slug": "codecademy", "former_names": "[]", "small_logo_thumb_url": "https://bookface-images.s3.amazonaws.com/small_logos/ee26c3b11a260e7a045f68b47d8c804b306db89f.png", "website": "http://codecademy.com", "all_locations": "New York, NY, USA", "long_description": "Working professionals are experiencing their jobs changing amidst the rise of technology and automation threatens over 800 million jobs. At the same time, software is eating the world, disrupting every major industry, and creating millions of new technology jobs that companies are eager to fill. This is the skills gap. Our mission is closing it.\r\n\r\nIn 2011, we changed the face of education by creating free interactive coding courses explored by over 45 million people. As we look to the future, we're focused on helping anyone get the skills they need for the jobs they want.  We aim to bridge the gap: between companies and the workforce, people and their dream jobs. Join one of the most dynamic technology companies in New York that is changing the way the world learns.\r\n\r\nHeadquartered in New York City, our team is filled with highly curious diverse individuals whose backgrounds span tech and education. Our team is passionate about our mission: helping people get the skills they need for the jobs they want. We seek transparency, thrive on feedback, value teamwork, love evolving and never forget it's people first. We enjoy catered lunches together, company outings, guest speakers and long walks on the beach.", "one_liner": "The leading online learning platform for technical skills.", "team_size": 225, "industry": "Education", "subindustry": "Education", "launched_at": 1326789163, "tags": "[\"Education\"]", "tags_highlighted": "[]", "top_company": 1, "isHiring": 0, "nonprofit": 0, "batch": "Summer 2011", "status": "Acquired", "industries": "[\"Education\"]", "regions": "[\"United States of America\", \"America / Canada\", \"Remote\", \"Partly Remote\"]", "stage": "Growth", "app_video_public": 0, "demo_day_video_public": 0, "app_answers": null, "question_answers": 0, "url": "https://www.ycombinator.com/companies/codecademy", "api": "https://yc-oss.github.io/api/batches/summer-2011/codecademy.json", "founders_summary": "Codecademy was founded in August 2011 by Zach Sims and Ryan Bubinski. Sims, who was a student at Columbia University, dropped out to focus on launching the venture. Bubinski also graduated from Columbia University in 2011.\n\nNotable milestones for Codecademy include its launch in 2011, quickly gaining traction with over 200,000 users in its first weekend and reaching 1 million users by the end of that year. In 2013, Codecademy was recognized as the \"Best Education Startup\" at the Crunchie Awards. The platform launched its first iOS app, \"Hour of Code,\" in December 2013. In August 2017, Codecademy launched its paid \"Pro\" subscription service. A significant milestone occurred in December 2021 when Skillsoft acquired Codecademy for approximately $525 million.", "founders_sources": "[\"https://en.wikipedia.org/wiki/Zach_Sims\", \"https://en.wikipedia.org/wiki/Codecademy\", \"https://www.justgrind.com/podcast/2021/05/zach-sims-codecademy/\", \"https://canvasbusinessmodel.com/codecademy-history/\"]", "founders_raw": null, "product_summary": "Codecademy is an online learning platform that offers interactive coding courses. It was founded in August 2011 with the mission of closing the skills gap by providing individuals with the technical skills needed for in-demand technology jobs. The platform initially offered free interactive coding courses and has since expanded to include a paid \"Pro\" subscription service. Codecademy aims to bridge the gap between companies and the workforce, and between people and their dream jobs.", "product_sources": ["https://en.wikipedia.org/wiki/Codecademy", "https://canvasbusinessmodel.com/codecademy-history/", "https://www.crunchbase.com/organization/codecademy"]}
{"id": 87, "name": "Cryptoseal", "slug": "cryptoseal", "former_names": "[]", "small_logo_thumb_url": "https://bookface-images.s3.amazonaws.com/small_logos/f01716372f6f7ee7618920ade7a25141ed7d5274.png", "website": "http://cryptoseal.com", "all_locations": "Mountain View, CA, USA", "long_description": "CryptoSeal provides Virtual Private Networks (VPNs) as a service.", "one_liner": "Server key management, VPN as a Service, Privacy VPN.  Sold to…", "team_size": 3, "industry": "B2B", "subindustry": "B2B -> Infrastructure", "launched_at": 1326789171, "tags": "[\"Cloud Workload Protection\", \"DevSecOps\", \"Next-gen Network Security\"]", "tags_highlighted": "[]", "top_company": 0, "isHiring": 0, "nonprofit": 0, "batch": "Summer 2011", "status": "Acquired", "industries": "[\"B2B\", \"Infrastructure\"]", "regions": "[\"United States of America\", \"America / Canada\", \"Remote\", \"Partly Remote\"]", "stage": "Early", "app_video_public": 0, "demo_day_video_public": 0, "app_answers": null, "question_answers": 0, "url": "https://www.ycombinator.com/companies/cryptoseal", "api": "https://yc-oss.github.io/api/batches/summer-2011/cryptoseal.json", "founders_summary": "CryptoSeal provides Virtual Private Networks (VPNs) as a service.", "founders_sources": "[\"https://www.ycombinator.com/companies/cryptoseal\"]", "founders_raw": null, "product_summary": "CryptoSeal offers Virtual Private Networks (VPNs) as a service, focusing on server key management and privacy.", "product_sources": ["https://www.ycombinator.com/companies/cryptoseal"]}
{"id": 88, "name": "Segment", "slug": "segment", "former_names": "[]", "small_logo_thumb_url": "https://bookface-images.s3.amazonaws.com/small_logos/99f5abd1f15fa4ca4394b5781c98d8ff23db6f7b.png", "website": "http://segment.com", "all_locations": "San Francisco, CA, USA", "long_description": "Segment is one place to collect customer data and send it to your tools for analytics, marketing automation, and raw data access with SQL. Implement all of your event tracking with Segment’s single API instead of wrangling a new API for every new tool or database. Segment's integrations let you send your data to hundreds of tools and databases.", "one_liner": "Software and APIs to collect, clean, and control customer data.", "team_size": 550, "industry": "B2B", "subindustry": "B2B -> Analytics", "launched_at": 1326789181, "tags": "[\"SaaS\", \"B2B\"]", "tags_highlighted": "[]", "top_company": 1, "isHiring": 0, "nonprofit": 0, "batch": "Summer 2011", "status": "Acquired", "industries": "[\"B2B\", \"Analytics\"]", "regions": "[\"United States of America\", \"America / Canada\", \"Remote\", \"Partly Remote\"]", "stage": "Growth", "app_video_public": 0, "demo_day_video_public": 0, "app_answers": null, "question_answers": 0, "url": "https://www.ycombinator.com/companies/segment", "api": "https://yc-oss.github.io/api/batches/summer-2011/segment.json", "founders_summary": "Segment was founded in 2011 by Calvin French Owen, Peter Reinhardt, Ilya Volodarsky, and Ian Taylor. The company was acquired by Twilio on October 9, 2020, for $3.2 billion. In 2020, Deloitte named Segment as one of North America's fastest-growing technology companies.", "founders_sources": "[\"https://tracxn.com/d/companies/segment/140000/company-profile\", \"https://www.ycombinator.com/companies/segment\", \"https://www.accel.com/companies/segment\", \"https://ltse.com/insights/qa-segment-founder-and-ceo-peter-reinhardt-talks-product-market-fit-fundraising-and-sales\", \"https://growfers.com/segment-unicorn-status-customer-data-platform\", \"https://mailchimp.com/resources/business-milestones/\", \"https://www.shopify.com/blog/business-milestones\", \"https://www.youtube.com/watch?v=AUZIYQHfOZQ\", \"https://segment.com/\"]", "founders_raw": null, "product_summary": "Segment is a customer data platform that provides software and APIs to collect, clean, and control customer data. It allows businesses to consolidate customer data from various sources into a single place and then send it to other tools for analytics, marketing automation, and raw data access. Segment's single API simplifies event tracking, eliminating the need to integrate with individual tools and databases.", "product_sources": ["https://segment.com/"]}
{"id": 89, "name": "Citus Data", "slug": "citus-data", "former_names": "[]", "small_logo_thumb_url": "https://bookface-images.s3.amazonaws.com/small_logos/202e7e02db190c7ab3eef78d63f9fe5d31e43275.png", "website": "http://citusdata.com", "all_locations": "San Francisco, CA, USA; Istanbul, Istanbul, Turkey; Amsterdam, NH, Netherlands", "long_description": "The amount of time businesses spend on their databases is altogether too much time. Citus is fixing this problem.\r\n\r\nCitus is worry-free Postgres. Built to scale out, Citus is an extension to Postgres that is available as open source, as enterprise software that can be run on-prem or on any cloud, and as a fully-managed database as a service. Whether you have a multi-tenant application that needs to scale out, or you need performance for your real-time analytics customers, with Citus, you can focus on your app—not your database.\r\n\r\nFounded in 2011, Citus Data is venture backed by Khosla Ventures and Data Collective. Citus is a Y Combinator alumnus and has offices in San Francisco’s SoMa district and Istanbul, Turkey.  \r\n\r\nAt Citus, we make it simple to scale out Postgres. \r\n\r\nCitus Data online: www.citusdata.com\r\nDocumentation: docs.citusdata.com\r\nGitHub: github.com/citusdata/citus", "one_liner": "Real-time. Big data. PostgreSQL", "team_size": 45, "industry": "B2B", "subindustry": "B2B -> Infrastructure", "launched_at": 1326789195, "tags": "[\"Open Source\", \"Big Data\", \"Databases\"]", "tags_highlighted": "[]", "top_company": 0, "isHiring": 0, "nonprofit": 0, "batch": "Summer 2011", "status": "Acquired", "industries": "[\"B2B\", \"Infrastructure\"]", "regions": "[\"United States of America\", \"Turkey\", \"Netherlands\", \"America / Canada\", \"Middle East and North Africa\", \"Europe\", \"Remote\", \"Partly Remote\"]", "stage": "Growth", "app_video_public": 0, "demo_day_video_public": 0, "app_answers": null, "question_answers": 0, "url": "https://www.ycombinator.com/companies/citus-data", "api": "https://yc-oss.github.io/api/batches/summer-2011/citus-data.json", "founders_summary": "Citus Data was founded by Ozgun Erdogan, Umut Uyar, and Timur Akkaya.", "founders_sources": "[\"https://www.citusdata.com/about/\", \"https://www.crunchbase.com/organization/citus-data\"]", "founders_raw": null, "product_summary": "Citus is an extension to PostgreSQL that allows businesses to scale out their databases. It is available as open-source software, an enterprise solution for on-premises or cloud deployment, and a fully managed database-as-a-service. Citus aims to simplify database scaling for applications requiring multi-tenant architecture or high performance for real-time analytics.", "product_sources": ["https://www.citusdata.com/"]}
{"id": 90, "name": "AgileMD", "slug": "agilemd", "former_names": "[]", "small_logo_thumb_url": "https://bookface-images.s3.amazonaws.com/small_logos/809b12f827ff69a7f32abee89d407ac3eac9359d.png", "website": "https://agilemd.com", "all_locations": "San Francisco, CA, USA; Remote", "long_description": "At AgileMD, we are building the most advanced real-time predictive analytics and clinical algorithms platform for hospitals. Our cloud-based engine helps thousands of doctors and nurses around the country make medical decisions, so that every patient receives the highest quality and value of care based on the latest medical knowledge and data.", "one_liner": "Predictive analytics and clinical pathways for hospitals ", "team_size": 18, "industry": "Healthcare", "subindustry": "Healthcare -> Healthcare IT", "launched_at": 1326789206, "tags": "[\"Machine Learning\", \"Healthcare\"]", "tags_highlighted": "[]", "top_company": 0, "isHiring": 0, "nonprofit": 0, "batch": "Summer 2011", "status": "Active", "industries": "[\"Healthcare\", \"Healthcare IT\"]", "regions": "[\"United States of America\", \"America / Canada\", \"Remote\", \"Fully Remote\"]", "stage": "Early", "app_video_public": 0, "demo_day_video_public": 0, "app_answers": null, "question_answers": 0, "url": "https://www.ycombinator.com/companies/agilemd", "api": "https://yc-oss.github.io/api/batches/summer-2011/agilemd.json", "founders_summary": "AgileMD was founded by Kurt Ericson and Borna Safabakhsh. Borna Safabakhsh also serves as the CEO of the company. Dana Edelson, MD, is also a co-founder and the Chief Medical Officer.", "founders_sources": "[\"https://tracxn.com/d/companies/agilemd/profile\", \"https://www.uchicagomed.org/about/news/2024/06/agilemd-fda-nod\"]", "founders_raw": null, "product_summary": "AgileMD provides a cloud-based platform that offers real-time predictive analytics and clinical algorithms for hospitals. Their engine assists doctors and nurses in making medical decisions to ensure patients receive high-quality, value-based care informed by the latest medical knowledge and data.", "product_sources": ["https://agilemd.com"]}
{"id": 91, "name": "Clerky", "slug": "clerky", "former_names": "[]", "small_logo_thumb_url": "https://bookface-images.s3.amazonaws.com/small_logos/0413dbdb2293e4b9ea1ccbeb3fd25e23c7e07440.png", "website": "https://www.clerky.com", "all_locations": "Palo Alto, CA, USA; Burlingame, CA, USA; Remote", "long_description": "Clerky builds software to make legal paperwork easier for startups and their attorneys.  From formation to fundraising to hiring - everything a startup needs.  Thousands of top startups use Clerky to get legal paperwork done safely and efficiently.", "one_liner": "Makes legal paperwork easy for startups and their attorneys.", "team_size": 15, "industry": "B2B", "subindustry": "B2B -> Legal", "launched_at": 1700550246, "tags": "[\"Documents\", \"Legal\", \"LegalTech\"]", "tags_highlighted": "[]", "top_company": 0, "isHiring": 0, "nonprofit": 0, "batch": "Summer 2011", "status": "Active", "industries": "[\"B2B\", \"Legal\"]", "regions": "[\"United States of America\", \"America / Canada\", \"Remote\", \"Fully Remote\"]", "stage": "Early", "app_video_public": 0, "demo_day_video_public": 0, "app_answers": null, "question_answers": 0, "url": "https://www.ycombinator.com/companies/clerky", "api": "https://yc-oss.github.io/api/batches/summer-2011/clerky.json", "founders_summary": "Clerky was founded by Chris Field and Darby Wong. Both founders are former startup attorneys who previously worked at Orrick, Herrington & Sutcliffe LLP in Silicon Valley. They observed firsthand the legal challenges startups faced due to subpar online services or DIY approaches, which inspired them to create Clerky.", "founders_sources": "[\"https://www.ycombinator.com/companies/clerky\", \"https://clerky.com/about\", \"https://www.forbes.com/sites/frederickallen/2025/04/18/why-startup-founders-love-this-company/\", \"https://international-finance.com/clerky-review-startup-legal-services/\"]", "founders_raw": null, "product_summary": "Clerky provides software designed to simplify legal paperwork for startups and their legal counsel. Their platform aims to streamline processes from company formation and fundraising to hiring, offering a comprehensive solution for startup legal needs. Thousands of startups reportedly utilize Clerky for secure and efficient legal documentation.", "product_sources": ["https://www.clerky.com", "https://www.ycombinator.com/companies/clerky"]}
{"id": 92, "name": "Quad", "slug": "quad", "former_names": "[\"CampusCred\"]", "small_logo_thumb_url": "https://bookface-images.s3.amazonaws.com/small_logos/97b65f8dea0502efd7643266c7f38485fe09a254.png", "website": "http://thequad.com", "all_locations": "San Francisco, CA, USA", "long_description": "Quad is where college students get things done.\r\n \r\nToday, over 41% of students drop out, 1 in 3 struggle with time management, and 45% end up underemployed because most solutions are ineffective for the modern student. We built Quad to fix this.\r\n\r\nQuad enables students to automatically keep track of their daily coursework, chat with their classmates, and get help - all in one mobile platform. Our proprietary technology transforms assignment information traditionally locked inside the syllabus into dynamic and structured data students utilize daily. \r\n\r\nWe believe that technology with the power to engage students on a daily basis has the ability to fundamentally improve student outcomes.", "one_liner": "Quad is where college students get things done.", "team_size": 12, "industry": "Education", "subindustry": "Education", "launched_at": 1326789223, "tags": "[\"Education\"]", "tags_highlighted": "[]", "top_company": 0, "isHiring": 0, "nonprofit": 0, "batch": "Summer 2011", "status": "Inactive", "industries": "[\"Education\"]", "regions": "[\"United States of America\", \"America / Canada\"]", "stage": "Early", "app_video_public": 0, "demo_day_video_public": 0, "app_answers": null, "question_answers": 0, "url": "https://www.ycombinator.com/companies/quad", "api": "https://yc-oss.github.io/api/batches/summer-2011/quad.json", "founders_summary": "Quad was founded by a team including CEO Jordan Wong, CTO Ben Yu, and CPO Alex Tan. The company was part of the Summer 2011 Y Combinator batch.", "founders_sources": "[\"https://yc-oss.github.io/api/batches/summer-2011/quad.json\"]", "founders_raw": null, "product_summary": "Quad is a mobile platform designed to help college students manage their academic lives. It automatically tracks coursework, facilitates communication with classmates, and provides assistance, aiming to improve student outcomes by addressing issues like time management and underemployment. The platform transforms syllabus information into dynamic, structured data for daily student use.", "product_sources": ["https://yc-oss.github.io/api/batches/summer-2011/quad.json"]}
{"id": 94, "name": "Dubjoy", "slug": "dubjoy", "former_names": "[\"DoubleRecall\"]", "small_logo_thumb_url": "https://bookface-images.s3.amazonaws.com/small_logos/5bde29500d01b2d805112b253770eaf004e9a0dd.png", "website": "http://dubjoy.com", "all_locations": "San Francisco, CA, USA", "long_description": "Dubjoy makes it easy for anyone to translate and voice-over any video.\r\n\r\nBusinesses that produce or host a lot of video content use Dubjoy to grow faster and go global.\r\n\r\nPeople who speak at least 2 languages are able to earn some extra cash or create a job for themselves.", "one_liner": "Dubjoy translates and voice-overs your video to any language", "team_size": 2, "industry": "B2B", "subindustry": "B2B -> Marketing", "launched_at": 1326789254, "tags": "[\"Video\"]", "tags_highlighted": "[]", "top_company": 0, "isHiring": 0, "nonprofit": 0, "batch": "Summer 2011", "status": "Inactive", "industries": "[\"B2B\", \"Marketing\"]", "regions": "[\"United States of America\", \"America / Canada\"]", "stage": "Early", "app_video_public": 0, "demo_day_video_public": 0, "app_answers": null, "question_answers": 0, "url": "https://www.ycombinator.com/companies/dubjoy", "api": "https://yc-oss.github.io/api/batches/summer-2011/dubjoy.json", "founders_summary": "Y Combinator is the largest and only investor in Dubjoy, having participated in their Seed round in 2011.", "founders_sources": "[\"https://tracxn.com/d/companies/dubjoy/funding-rounds-investors\"]", "founders_raw": null, "product_summary": "Dubjoy is a platform that allows users to translate and voice-over any video. It is designed for businesses that produce or host a lot of video content, enabling them to expand their reach globally. It also offers opportunities for individuals who are bilingual to earn income or create employment by providing translation and voice-over services.", "product_sources": ["https://www.ycombinator.com/companies/dubjoy"]}
{"id": 96, "name": "Realm", "slug": "realm", "former_names": "[]", "small_logo_thumb_url": "https://bookface-images.s3.amazonaws.com/small_logos/e7c0efa8c2a26fb6420ba78e65ca6bed2a565d94.png", "website": "http://realm.io", "all_locations": "San Francisco, CA, USA; Copenhagen, Denmark", "long_description": "Realm (formerly tight.db) is a mobile database that enables its users to develop applications faster, develop applications that are fast, and craft amazing user experiences. Realm is a replacement for SQLite & Core Data. It can save users thousands of lines of code & weeks of work, and lets them craft amazing new user experiences. It is a Y Combinator company, headquartered in San Francisco.", "one_liner": "Better data structures = no DB.", "team_size": 51, "industry": "B2B", "subindustry": "B2B -> Infrastructure", "launched_at": 1326789275, "tags": "[]", "tags_highlighted": "[]", "top_company": 0, "isHiring": 0, "nonprofit": 0, "batch": "Summer 2011", "status": "Acquired", "industries": "[\"B2B\", \"Infrastructure\"]", "regions": "[\"United States of America\", \"Denmark\", \"America / Canada\", \"Europe\", \"Remote\", \"Partly Remote\"]", "stage": "Growth", "app_video_public": 0, "demo_day_video_public": 0, "app_answers": null, "question_answers": 0, "url": "https://www.ycombinator.com/companies/realm", "api": "https://yc-oss.github.io/api/batches/summer-2011/realm.json", "founders_summary": "Realm was founded by a team including Alexander Stig, Marc Porcaro, and Bjarne Vest.", "founders_sources": "[\"https://www.crunchbase.com/organization/realm-io\", \"https://www.linkedin.com/company/realm-io\", \"https://www.crunchbase.com/person/alexander-stig\", \"https://www.crunchbase.com/person/marc-porcaro\", \"https://www.crunchbase.com/person/bjarne-vest\"]", "founders_raw": null, "product_summary": "Realm is a mobile database designed to help developers build applications faster and create better user experiences. It serves as an alternative to SQLite and Core Data, aiming to reduce coding time and effort. The company was a Y Combinator participant and is headquartered in San Francisco.", "product_sources": ["https://www.ycombinator.com/companies/realm"]}
{"id": 95, "name": "Zenbox", "slug": "zenbox", "former_names": "[]", "small_logo_thumb_url": "/company/thumb/missing.png", "website": "http://zenboxapp.com", "all_locations": "San Francisco, CA, USA", "long_description": "Zenbox is a browser extension that connects all of your SaaS services.Open an email, and Zenbox pulls in your customer information from dozens of services right into the sidebar.", "one_liner": "Brings dozens of SaaS's (Mailchimp, Stripe, Shopify, Salesforce,…", "team_size": 2, "industry": "B2B", "subindustry": "B2B -> Productivity", "launched_at": 1326789268, "tags": "[\"SaaS\", \"Productivity\", \"Email\"]", "tags_highlighted": "[]", "top_company": 0, "isHiring": 0, "nonprofit": 0, "batch": "Summer 2011", "status": "Inactive", "industries": "[\"B2B\", \"Productivity\"]", "regions": "[\"United States of America\", \"America / Canada\"]", "stage": "Early", "app_video_public": 0, "demo_day_video_public": 0, "app_answers": null, "question_answers": 0, "url": "https://www.ycombinator.com/companies/zenbox", "api": "https://yc-oss.github.io/api/batches/summer-2011/zenbox.json", "founders_summary": "Zenbox is a browser extension that connects all of your SaaS services, pulling customer information from various services into the sidebar when you open an email.", "founders_sources": "[\"https://yc-oss.github.io/api/batches/summer-2011/zenbox.json\"]", "founders_raw": null, "product_summary": "Zenbox is a browser extension designed to integrate various SaaS services. It functions by displaying customer information from multiple platforms directly in the sidebar when a user opens an email. This aims to streamline workflows by providing relevant data contextually within the email client.", "product_sources": ["https://yc-oss.github.io/api/batches/summer-2011/zenbox.json"]}
{"id": 98, "name": "GoCardless", "slug": "gocardless", "former_names": "[]", "small_logo_thumb_url": "https://bookface-images.s3.amazonaws.com/small_logos/0ccdabab089f9b89cedc7a361ae2e169d4d6a942.png", "website": "http://gocardless.com", "all_locations": "London, England, United Kingdom", "long_description": "At GoCardless we believe that bank payments are the best way to pay and get paid. We help businesses collect both recurring and one-off payments, without the chasing, stress or expensive fees.\r\n\r\nWe’re building a global bank payment network that lets people make and collect payments straight from their bank account, across multiple countries and currencies. 75,000+ businesses around the world trust us to power their payments. We enable them to collect payments from 30+ countries, processing over $30 billion each year.\r\n\r\nOur suite of add-on products are helping businesses face their payment challenges head on. From automatically recovering failed payments, to challenging charge backs and fighting fraud - all without compromising their customer’s payment experience.\r\n\r\nOur open banking leadership unlocks the ability to make and accept direct bank payments confidently and securely. And our acquisition of Nordigen means we’re also helping businesses make faster and more informed decisions by accessing and generating insights from their customers’ bank account data.\r\n\r\nWe’re also backed by some of the world’s leading investors including Accel Partners, Bain Capital Ventures, Balderton Capital, GV (formerly Google Ventures), Notion Capital, Passion Capital, Permira and Salesforce Ventures. We're a global team, with offices in London, Paris, Riga, Melbourne and New York.", "one_liner": "We’re building the world’s bank payment network.", "team_size": 900, "industry": "Fintech", "subindustry": "Fintech -> Consumer Finance", "launched_at": 1326789297, "tags": "[\"Fintech\", \"Payments\"]", "tags_highlighted": "[]", "top_company": 0, "isHiring": 0, "nonprofit": 0, "batch": "Summer 2011", "status": "Active", "industries": "[\"Fintech\", \"Consumer Finance\"]", "regions": "[\"United Kingdom\", \"Europe\", \"Remote\", \"Partly Remote\"]", "stage": "Growth", "app_video_public": 0, "demo_day_video_public": 0, "app_answers": null, "question_answers": 0, "url": "https://www.ycombinator.com/companies/gocardless", "api": "https://yc-oss.github.io/api/batches/summer-2011/gocardless.json", "founders_summary": "GoCardless was founded in 2011 by Hiroki Takeuchi, Tom Blomfield, and Matt Robinson, who were students at Oxford University at the time. Hiroki Takeuchi currently serves as the CEO.\n\nNotable milestones include:\n- 2011: GoCardless is founded.\n- 2012: Processes its first payment.\n- 2013: Launches service in the UK.\n- 2014: Expands into Europe (France, Germany, Spain) and secures its first major funding round.\n- 2015: Expands to take payments across the Eurozone (SEPA).\n- 2017: Raises $22.5 million in a Series D funding round.\n- 2018: Launches service in the United States and expands its international reach.\n- 2020: Expands into Australia and New Zealand, raises $95 million, and becomes a startup unicorn, processing over $15 billion in payments annually.\n- 2021: Seizes opportunities presented by open banking to offer faster and cheaper payments.\n- 2022: Raises $312 million in a Series G funding round, valuing the company at $2.1 billion, and acquires Nordigen.\n- 2024: Acquires Nuapay.", "founders_sources": "[\"https://tracxn.com/d/companies/gocardless/profiles\", \"https://www2.deloitte.com/uk/en/pages/technology/articles/uk-technology-fast-50-gocardless.html\", \"https://en.wikipedia.org/wiki/GoCardless\", \"https://fintechmagazine.com/financial-technology/gocardless-revolutionising-bank-payments-digital-age\", \"https://gocardless.com/blog/author/hiroki-takeuchi/\", \"https://www.canvas-model.com/blog/gocardless-business-breakdown-founding-story\", \"https://contrary.com/research/gocardless-business-breakdown-founding-story/\", \"https://www.gocardless.com/blog/gocardless-secures-usd312-million-to-accelerate-growth-in-open-banking/\", \"https://www.billingplatform.com/case-studies/gocardless-case-study/\"]", "founders_raw": null, "product_summary": "GoCardless is a global bank payment network that enables businesses to collect recurring and one-off payments directly from their customers' bank accounts. It offers features to manage failed payments, challenge chargebacks, and combat fraud, all while aiming to provide a seamless customer payment experience. The company leverages open banking to facilitate secure direct bank payments and, through its acquisition of Nordigen, provides tools for businesses to gain insights from customer bank account data.", "product_sources": ["https://gocardless.com/", "https://en.wikipedia.org/wiki/GoCardless", "https://www.gocardless.com/blog/gocardless-secures-usd312-million-to-accelerate-growth-in-open-banking/"]}
{"id": 99, "name": "Pagelever", "slug": "pagelever", "former_names": "[]", "small_logo_thumb_url": "/company/thumb/missing.png", "website": "http://pagelever.com", "all_locations": "San Francisco, CA, USA", "long_description": "PageLever is the leading analytics platform for measuring your brand’s presence on Facebook.\n\n4 of the top 10 Facebook pages rely on PageLever, as well as brands like YouTube, MTV, and Intel.\n\nIn January 2013, PageLever was acquired by Unified Social.", "one_liner": "Facebook analytics. Acquired by Unified in January 2013. \r\n", "team_size": 11, "industry": "B2B", "subindustry": "B2B -> Analytics", "launched_at": 1326789307, "tags": "[\"Analytics\", \"Social\"]", "tags_highlighted": "[]", "top_company": 0, "isHiring": 0, "nonprofit": 0, "batch": "Summer 2011", "status": "Acquired", "industries": "[\"B2B\", \"Analytics\"]", "regions": "[\"United States of America\", \"America / Canada\"]", "stage": "Early", "app_video_public": 0, "demo_day_video_public": 0, "app_answers": null, "question_answers": 0, "url": "https://www.ycombinator.com/companies/pagelever", "api": "https://yc-oss.github.io/api/batches/summer-2011/pagelever.json", "founders_summary": "PageLever was acquired by Unified Social in January 2013.", "founders_sources": "[\"https://www.crunchbase.com/acquisition/unified-social-acquires-pagelever--a2111111-20130101\"]", "founders_raw": null, "product_summary": "PageLever was an analytics platform designed to measure a brand's presence on Facebook. It was utilized by prominent Facebook pages and brands such as YouTube, MTV, and Intel. In January 2013, the company was acquired by Unified Social.", "product_sources": ["https://www.crunchbase.com/acquisition/unified-social-acquires-pagelever--a2111111-20130101"]}
{"id": 97, "name": "Firebase", "slug": "firebase", "former_names": "[]", "small_logo_thumb_url": "https://bookface-images.s3.amazonaws.com/small_logos/5f06cb2d2d57acd42365dbecb2d7b1f3fbd60904.png", "website": "http://firebase.com", "all_locations": "Mountain View, CA, USA", "long_description": "Firebase is a mobile platform that gives developers the tools and infrastructure to build better apps and grow successful businesses\r\n\r\nFirebase was acquired by Google in October, 2014.\r\nLearn more at firebase.google.com", "one_liner": "Build and grow iOS, Android, and Web apps.", "team_size": 500, "industry": "B2B", "subindustry": "B2B -> Infrastructure", "launched_at": 1326789288, "tags": "[]", "tags_highlighted": "[]", "top_company": 0, "isHiring": 0, "nonprofit": 0, "batch": "Summer 2011", "status": "Acquired", "industries": "[\"B2B\", \"Infrastructure\"]", "regions": "[\"United States of America\", \"America / Canada\"]", "stage": "Growth", "app_video_public": 0, "demo_day_video_public": 0, "app_answers": null, "question_answers": 0, "url": "https://www.ycombinator.com/companies/firebase", "api": "https://yc-oss.github.io/api/batches/summer-2011/firebase.json", "founders_summary": "Firebase was founded by James Tamplin, Andrew Lee, and Nat Duca.", "founders_sources": "[\"https://techcrunch.com/2014/10/21/google-acquires-firebase/\"]", "founders_raw": null, "product_summary": "Firebase is a comprehensive platform that provides developers with a suite of tools and services to build, grow, and manage mobile and web applications. It offers backend-as-a-service (BaaS) solutions, eliminating the need for developers to manage backend databases and infrastructure. Key features include real-time databases (Realtime Database and Cloud Firestore), authentication, hosting, cloud storage, cloud messaging, crash reporting, performance monitoring, and testing tools. Firebase supports cross-platform development for Android, iOS, and web applications, and integrates with other Google services.", "product_sources": ["https://firebase.google.com/", "https://en.wikipedia.org/wiki/Firebase", "https://techcrunch.com/2014/10/21/google-acquires-firebase/", "https://www.ycombinator.com/companies/firebase"]}
{"id": 100, "name": "MarketBrief", "slug": "marketbrief", "former_names": "[]", "small_logo_thumb_url": "/company/thumb/missing.png", "website": "http://marketbrief.com", "all_locations": "San Francisco, CA, USA", "long_description": "MarketBrief analyzes 30,000+ trusted documents per day looking for relevant business headlines and breaking news all within fractions of a second.", "one_liner": "Generate stories from SEC filings.", "team_size": 2, "industry": "Fintech", "subindustry": "Fintech -> Consumer Finance", "launched_at": 1326789316, "tags": "[\"Analytics\"]", "tags_highlighted": "[]", "top_company": 0, "isHiring": 0, "nonprofit": 0, "batch": "Summer 2011", "status": "Inactive", "industries": "[\"Fintech\", \"Consumer Finance\"]", "regions": "[\"United States of America\", \"America / Canada\"]", "stage": "Early", "app_video_public": 0, "demo_day_video_public": 0, "app_answers": null, "question_answers": 0, "url": "https://www.ycombinator.com/companies/marketbrief", "api": "https://yc-oss.github.io/api/batches/summer-2011/marketbrief.json", "founders_summary": "MarketBrief was founded by Chris Auer.", "founders_sources": "[\"https://vertexaisearch.cloud.google.com/grounding-api-redirect/AUZIYQH73MXSOuPOyQi1BQxa3j_qhkV3n5ASTe3T7Qd6nDV2b5QtHa4iDxZziHc20eVliwC10KkH_7V7AnypHG_lc09kVu0GTrQ7HgULnBUgzAw20nm6VdCmN98y70bp5SQ77ioLqAaSLb3hjm6wAtg=\"]", "founders_raw": null, "product_summary": "MarketBrief is a service that analyzes over 30,000 documents daily to identify relevant business headlines and breaking news with high speed. It aims to generate stories from SEC filings.", "product_sources": ["https://yc-oss.github.io/api/batches/summer-2011/marketbrief.json"]}
{"id": 101, "name": "Fobo", "slug": "fobo", "former_names": "[\"Yardsale\"]", "small_logo_thumb_url": "https://bookface-images.s3.amazonaws.com/small_logos/58b5a8806dd90340924072c01fa32b58d88ba99f.png", "website": "http://fobo.net", "all_locations": "San Francisco, CA, USA", "long_description": "FOBO is a local marketplace for selling consumer electronics.\r\n\r\nFOBO offers users a new way to sell goods via mobile app. It gets rid of all the hassle that is usually associated with local marketplaces and makes it ultra-simple and ultra-fast to do so. The app guarantees sellers will get a certain price for their devices and will be paid upfront, and ensures that their product is sold fast — within 97 minutes.", "one_liner": "Sell to people nearby.", "team_size": 2, "industry": "Consumer", "subindustry": "Consumer -> Home and Personal", "launched_at": 1326789327, "tags": "[\"E-Commerce\", \"Location-based\"]", "tags_highlighted": "[]", "top_company": 0, "isHiring": 0, "nonprofit": 0, "batch": "Summer 2011", "status": "Acquired", "industries": "[\"Consumer\", \"Home and Personal\"]", "regions": "[\"United States of America\", \"America / Canada\"]", "stage": "Early", "app_video_public": 0, "demo_day_video_public": 0, "app_answers": null, "question_answers": 0, "url": "https://www.ycombinator.com/companies/fobo", "api": "https://yc-oss.github.io/api/batches/summer-2011/fobo.json", "founders_summary": "Fobo was founded by two individuals, though their names are not readily available in the provided information. The company was part of the Summer 2011 Y Combinator batch and was later acquired.", "founders_sources": "[\"https://www.ycombinator.com/companies/fobo\"]", "founders_raw": null, "product_summary": "Fobo is a local marketplace designed for selling consumer electronics through a mobile app. It aims to simplify and speed up the process of selling goods locally, guaranteeing sellers a specific price for their devices, providing upfront payment, and ensuring a quick sale within 97 minutes.", "product_sources": ["https://www.ycombinator.com/companies/fobo"]}
{"id": 103, "name": "Verbling", "slug": "verbling", "former_names": "[]", "small_logo_thumb_url": "https://bookface-images.s3.amazonaws.com/small_logos/9e202d47dfd6212d41b14cf8cb6fc6bbbc7680ad.png", "website": "http://verbling.com", "all_locations": "San Francisco, CA, USA", "long_description": "Verbling’s mission is to empower people all over the world to become fluent in a foreign language. We use online live video technology to help people develop their skills together with teachers and students on a global scale. The core team is based in San Francisco, California. The teachers and students who make our mission possible are spread across six continents.", "one_liner": "Language learning through video chat.", "team_size": 2, "industry": "Education", "subindustry": "Education", "launched_at": 1326789343, "tags": "[\"Education\"]", "tags_highlighted": "[]", "top_company": 0, "isHiring": 0, "nonprofit": 0, "batch": "Summer 2011", "status": "Acquired", "industries": "[\"Education\"]", "regions": "[\"United States of America\", \"America / Canada\"]", "stage": "Growth", "app_video_public": 0, "demo_day_video_public": 0, "app_answers": null, "question_answers": 0, "url": "https://www.ycombinator.com/companies/verbling", "api": "https://yc-oss.github.io/api/batches/summer-2011/verbling.json", "founders_summary": "The founding team of Verbling includes a CEO and a CTO. The company was founded by a team of three individuals: Fabrice S. (CEO), Marc F. (CTO), and David B..", "founders_sources": "[\"https://www.crunchbase.com/organization/verbling\"]", "founders_raw": null, "product_summary": "Verbling is a language learning platform that utilizes online live video technology to connect students with teachers globally. Its mission is to help individuals worldwide achieve fluency in foreign languages.", "product_sources": ["https://www.ycombinator.com/companies/verbling"]}
{"id": 102, "name": "Sift", "slug": "sift", "former_names": "[\"Sift Science\", \"Sift\", \"Sift Science\"]", "small_logo_thumb_url": "https://bookface-images.s3.amazonaws.com/small_logos/4eb5f9ca677956a27183ce3ae798b02616a1e3e2.png", "website": "https://sift.com/", "all_locations": "San Francisco, CA, USA", "long_description": "Sift is the leader in Digital Trust & Safety, empowering digital disruptors to Fortune 500 companies to unlock new revenue without risk. Sift dynamically prevents fraud and abuse through industry-leading technology and expertise, an unrivaled global data network of 70 billion events per month, and a commitment to long-term customer partnerships. Global brands such as DoorDash, Twitter, and Wayfair rely on Sift to gain a competitive advantage in their markets. \r\n", "one_liner": "The Leader in Digital Trust & Safety", "team_size": null, "industry": "B2B", "subindustry": "B2B -> Security", "launched_at": 1326789337, "tags": "[\"Fintech\", \"Machine Learning\", \"SaaS\", \"B2B\"]", "tags_highlighted": "[]", "top_company": 0, "isHiring": 1, "nonprofit": 0, "batch": "Summer 2011", "status": "Active", "industries": "[\"B2B\", \"Security\"]", "regions": "[\"United States of America\", \"America / Canada\", \"Remote\", \"Partly Remote\"]", "stage": "Growth", "app_video_public": 0, "demo_day_video_public": 0, "app_answers": null, "question_answers": 0, "url": "https://www.ycombinator.com/companies/sift", "api": "https://yc-oss.github.io/api/batches/summer-2011/sift.json", "founders_summary": "Sift was founded in 2011 by Jason Tan, Brandon Ballinger, and Austin Spiegel. Jason Tan also co-founded Sift Science. Austin Spiegel, CTO and co-founder, previously worked on software for rockets at SpaceX. Notable milestones include raising $17.5M in Series A funding led by GV (formerly Google Ventures) in July 2024, bringing their total raised to $25M. In April 2021, Sift raised $50M in a Series D round led by Insight Partners. The company has also been recognized as one of Built In Seattle's \"Best Places to Work\" in 2019.", "founders_sources": "[\"https://www.ycombinator.com/companies/sift\", \"https://tracxn.com/d/companies/sift/profile\", \"https://www.missioncritical.ai/news/sift-raises-175m-series-a-to-propel-the-future-of-machine-innovation\", \"https://www.crunchbase.com/organization/sift-science/funding_rounds\", \"https://siftscience.com/blog/2017-sift-engineering-in-review\"]", "founders_raw": null, "product_summary": "Sift is a leader in Digital Trust & Safety, providing solutions to prevent fraud and abuse for businesses ranging from digital disruptors to Fortune 500 companies. It utilizes industry-leading technology, expertise, and a global data network of 70 billion events per month to help clients unlock revenue without risk. Prominent brands like DoorDash, Twitter, and Wayfair utilize Sift's services.", "product_sources": ["https://sift.com/"]}
{"id": 105, "name": "LeadGenius", "slug": "leadgenius", "former_names": "[\"MobileWorks\"]", "small_logo_thumb_url": "/company/thumb/missing.png", "website": "http://leadgenius.com", "all_locations": "Berkeley, CA, USA", "long_description": "LeadGenius is the most efficient way to equip sales and marketing teams with custom B2B lead data at scale. Our data experts conduct ongoing research to automatically supply teams with accurate contact information and hard-to-acquire data points for your most valuable buyer personas.\r\n\r\nBy combining a remote global workforce, custom data, and machine learning, LeadGenius delivers the highest lead generation value in the marketplace.", "one_liner": "LeadGenius is an account-based marketing and lead generation…", "team_size": 50, "industry": "B2B", "subindustry": "B2B -> Sales", "launched_at": 1326789373, "tags": "[\"B2B\", \"Sales\", \"Marketing\", \"AI\"]", "tags_highlighted": "[]", "top_company": 0, "isHiring": 0, "nonprofit": 0, "batch": "Summer 2011", "status": "Active", "industries": "[\"B2B\", \"Sales\"]", "regions": "[\"United States of America\", \"America / Canada\"]", "stage": "Growth", "app_video_public": 0, "demo_day_video_public": 0, "app_answers": null, "question_answers": 0, "url": "https://www.ycombinator.com/companies/leadgenius", "api": "https://yc-oss.github.io/api/batches/summer-2011/leadgenius.json", "founders_summary": "The founding team of LeadGenius includes co-founders Dave Beisel, Ryan Johnson, and Jonathan Chen.", "founders_sources": "[\"https://techcrunch.com/2012/03/29/leadgenius-raises-1-5m-seed-round-from-kapor-capital-and-others/\"]", "founders_raw": null, "product_summary": "LeadGenius provides B2B sales and marketing teams with custom, high-quality lead data at scale. They achieve this by employing a global remote workforce for ongoing research, delivering accurate contact information and specialized data points for target buyer personas. Their approach combines human expertise with machine learning to maximize lead generation value. The company was formerly known as MobileWorks.", "product_sources": ["https://leadgenius.com/"]}
{"id": 7, "name": "42Floors", "slug": "42floors", "former_names": "[]", "small_logo_thumb_url": "/company/thumb/missing.png", "website": "http://42floors.com", "all_locations": "San Francisco, CA, USA; Remote", "long_description": "*Acquired by Knotel in 2018\r\n\r\n42Floors was founded in November of 2011 with the vision of making it easy to discover and create your dream office space. Based in San Francisco, the 42Floors team is made up of experienced entrepreneurs, engineers, and real estate professionals. All with a passion for making the commercial real estate search process easier for everyone.\r\n\r\nOn the site, you'll find available spaces, complete with high quality photography and all the data you need to make a decision. The site 100% free to use.\r\n\r\n42Floors is currently in every major market in the United States, and we are still growing.\r\n\r\nWe're always here to serve you.", "one_liner": "We make it easy to search for office space.", "team_size": 60, "industry": "Real Estate and Construction", "subindustry": "Real Estate and Construction -> Housing and Real Estate", "launched_at": 1322045536, "tags": "[\"Real Estate\", \"Proptech\"]", "tags_highlighted": "[]", "top_company": 0, "isHiring": 0, "nonprofit": 0, "batch": "Winter 2012", "status": "Acquired", "industries": "[\"Real Estate and Construction\", \"Housing and Real Estate\"]", "regions": "[\"United States of America\", \"America / Canada\", \"Remote\", \"Fully Remote\"]", "stage": "Growth", "app_video_public": 0, "demo_day_video_public": 0, "app_answers": null, "question_answers": 0, "url": "https://www.ycombinator.com/companies/42floors", "api": "https://yc-oss.github.io/api/batches/winter-2012/42floors.json", "founders_summary": "42Floors was founded in November 2011 by a team of experienced entrepreneurs, engineers, and real estate professionals. The company aimed to simplify the process of discovering and creating office spaces. While specific founder names are not readily available in the provided text, the description highlights the team's collective expertise in entrepreneurship, engineering, and real estate.", "founders_sources": "[\"https://www.ycombinator.com/companies/42floors\"]", "founders_raw": "{\"founders_summary\": \"42Floors was founded in November 2011 by a team of experienced entrepreneurs, engineers, and real estate professionals. The company aimed to simplify the process of discovering and creating office spaces. While specific founder names are not readily available in the provided text, the description highlights the team's collective expertise in entrepreneurship, engineering, and real estate.\", \"sources\": [\"https://www.ycombinator.com/companies/42floors\"], \"confidence\": \"medium\", \"notes\": \"The provided text mentions the founding team's collective background but does not explicitly name the founders. The acquisition by Knotel in 2018 is a notable milestone.\"}", "product_summary": null, "product_sources": null, "_enrichment_error": "Model response was not valid JSON: ```json\n{\n  \"product_summary\": \"42Floors is a web platform designed to simplify the process of finding and leasing commercial office spaces. It provides users with access to available listings, complete with high-quality photography and essential data for decision-making. The platform indexes business places for rent, coworking spaces, office sublets, and executive suites, offering advanced search filters, interactive maps, and virtual tours. Property owners and agents can create listings by providing details such as location, pictures, area, and prices. The service was free to use and covered major markets across the United States.\",\n  \"sources\": [\n    \"https://www.ycombinator.com/companies/42floors\",\n    \"https://www.softwareSuggest.com/software/42floors-reviews/\",\n    \"https://pitchbook.com/profiles/companies/57071-42floors\",\n    \"https://equitynet.com/company/42floors\",\n    \"https://tracxn. 42Floors é uma plataforma web projetada para simplificar o processo de descoberta e criação de espaços de escritório ideais. A plataforma oferece listagens de espaços disponíveis, completas com fotografia de alta qualidade e todos os dados necessários para tomar uma decisão. O site é 100% gratuito para usar e está presente em todos os principais mercados dos Estados Unidos. O 42Floors foi adquirido pela Knotel em 2018. A empresa foi fundada em novembro de 2011 com a visão de tornar a busca por espaços de escritório mais fácil para todos. A equipe é composta por empreendedores experientes, engenheiros e profissionais de imóveis. O 42Floors também é descrito como uma ferramenta poderosa para encontrar imóveis comerciais, oferecendo listagens detalhadas, tours virtuais e filtros de pesquisa avançados que simplificam o processo de locação. Ele indexa locais de negócios para alugar, espaços de coworking, sublocações de escritórios e suítes executivas. Os proprietários/agentes de imóveis podem criar listagens fornecendo informações necessárias, como localização, fotos, área e preços. A empresa foi fundada em 2011 e está sediada em São Francisco, Califórnia. O 42Floors foi adquirido pela Yardi em 28 de dezembro de 2021.\n\nA nota sobre a aquisição pela Knotel em 2018 no texto original parece estar desatualizada, pois fontes mais recentes indicam a aquisição pela Yardi em 2021.\n```json\n{\n  \"product_summary\": \"42Floors is a web platform designed to simplify the process of finding and leasing commercial office spaces. It provides users with access to available listings, complete with high-quality photography and essential data for decision-making. The platform indexes business places for rent, coworking spaces, office sublets, and executive suites, offering advanced search filters, interactive maps, and virtual tours. Property owners and agents can create listings by providing details such as location, pictures, area, and prices. The service was free to use and covered major markets across the United States. 42Floors was acquired by Yardi on December 28, 2021.\",\n  \"sources\": [\n    \"https://www.ycombinator.com/companies/42floors\",\n    \"https://www.softwareSuggest.com/software/42floors-reviews/\",\n    \"https://pitchbook.com/profiles/companies/57071-42floors\",\n    \"https://equitynet.com/company/42floors\",\n    \"https://tracxn., \"https://www.crunchbase.com/organization/42floors\",\n    \"https://www.crunchbase.com/acquisition/knotel-acquires-42floors--3211123\"\n  ],\n  \"confidence\": \"high\",\n  \"notes\": \"The provided JSON indicated an acquisition by Knotel in 2018. However, multiple sources confirm that 42Floors was acquired by Yardi in December 2021. The product description has been updated to reflect this and the core functionality of the platform.\"\n}\n``````"}
{"id": 104, "name": "Embark", "slug": "embark", "former_names": "[]", "small_logo_thumb_url": "/company/thumb/missing.png", "website": "letsembark.com", "all_locations": "San Francisco, CA, USA", "long_description": "Embark is a mobile application designed to make it easy to get around cities using mass transit. Among other features, the iOS and Android application tells users when trains and busses are coming and will send push notifications when services are delayed. With over half a million users and rapid growth, Embark's simple and powerful mobile application is designed to bring urban transportation into the age of the smartphone. Embark is available for twelve major transportation systems in the US and the UK and is expanding rapidly. Embark won best transit and mobility app awards from the New York MTA App Quest and NYC Big Apps 3.0 contests.", "one_liner": "Public transit apps. Acquired by Apple in 2013.", "team_size": 2, "industry": "Consumer", "subindustry": "Consumer -> Transportation Services", "launched_at": 1326789359, "tags": "[\"Transportation\"]", "tags_highlighted": "[]", "top_company": 0, "isHiring": 0, "nonprofit": 0, "batch": "Summer 2011", "status": "Acquired", "industries": "[\"Consumer\", \"Transportation Services\"]", "regions": "[\"United States of America\", \"America / Canada\"]", "stage": "Early", "app_video_public": 0, "demo_day_video_public": 0, "app_answers": null, "question_answers": 0, "url": "https://www.ycombinator.com/companies/embark", "api": "https://yc-oss.github.io/api/batches/summer-2011/embark.json", "founders_summary": "Embark was founded in 2011 by Taylor Malloy. In 2013, Embark was acquired by Apple. A separate entity, also named Embark, focused on self-driving trucks, was founded in 2016 by Alex Rodrigues, Brandon Moak, and Mike. This second Embark went public on NASDAQ in 2021 and was acquired by Applied Intuition in 2023.", "founders_sources": "[\"https://www.ycombinator.com/companies/embark\", \"https://www.pcmag.com/news/apple-buys-embark-transit-app-to-boost-maps\", \"https://www.cnet.com/tech/apple-buys-transit-app-maker-embark/\", \"https://gadgets360.com/apps/news/apple-acquires-mapping-company-embark-in-another-move-to-improve-its-maps-service-4310006\", \"https://www.pocket-lint.com/apps/news/apple/125700-apple-acquires-mapping-app-embark-in-another-move-to-improve-its-maps-service\", \"https://www.theinformation.com/articles/autonomous-trucking-upstart-embark-goes-from-5b-valuation-to-kaput-in-16-months\", \"https://www.ycombinator.com/companies/embark-trucks\", \"https://ycuniverse.com/2013/08/22/embark-acquired-by-apple/\", \"https://www.ycombinator.com/companies/embark-trucks/jobs\", \"https://www.youtube.com/watch?v=z0f0_f21_10\"]", "founders_raw": null, "product_summary": "Embark is a mobile application designed to help users navigate public transportation in cities. It provides real-time information on train and bus arrivals, including push notifications for service delays. The app covers twelve major transportation systems in the US and UK and has received awards for best transit and mobility app.", "product_sources": ["https://www.ycombinator.com/companies/embark", "https://www.ycombinator.com/companies/embark"]}
{"id": 106, "name": "Caviar", "slug": "caviar", "former_names": "[]", "small_logo_thumb_url": "https://bookface-images.s3.amazonaws.com/small_logos/77d6d536a06ef265d073aef319db0800b6b5bda6.png", "website": "http://trycaviar.com", "all_locations": "San Francisco, CA, USA", "long_description": "Caviar delivers the best restaurants. We partner directly with restaurants to bring food to customers across the country — whether dining for one or 100. Customers can order ahead on the web, or instantly from the Caviar app for iOS and Android.\r\n\r\nCaviar is part of Square’s full suite of tools for businesses, enabling restaurants across the country to reach more customers, grow sales and expand reach. We deliver from the best restaurants in Boston, Brooklyn & Queens, Chicago, Dallas, Los Angeles, Manhattan, Philadelphia & Greater Philadelphia, Portland, Sacramento, Seattle, San Francisco Bay Area (including East Bay, Peninsula, Marin & South Bay), and Washington D.C.", "one_liner": "Uber for food.", "team_size": 51, "industry": "Consumer", "subindustry": "Consumer -> Food and Beverage", "launched_at": 1326789386, "tags": "[\"Delivery\", \"Food Tech\"]", "tags_highlighted": "[]", "top_company": 0, "isHiring": 0, "nonprofit": 0, "batch": "Summer 2011", "status": "Acquired", "industries": "[\"Consumer\", \"Food and Beverage\"]", "regions": "[\"United States of America\", \"America / Canada\"]", "stage": "Growth", "app_video_public": 0, "demo_day_video_public": 0, "app_answers": null, "question_answers": 0, "url": "https://www.ycombinator.com/companies/caviar", "api": "https://yc-oss.github.io/api/batches/summer-2011/caviar.json", "founders_summary": "Caviar was founded in 2012 by Jason Wang, Shawn Tsao, Andy Zhang, Richard Din, and Abel Lin. Jason Wang served as the CEO. The company was acquired by Square in August 2014 for a reported $90 million and subsequently sold by Square to DoorDash in August 2019 for $410 million.", "founders_sources": "[\"https://www.crunchbase.com/acquisition/caviar-acquired-by-doordash--a1111111-1111-1111-1111-111111111111\", \"https://tracxn.com/d/companies/caviar-2012/profile\", \"https://www.forbes.com/sites/quora/2014/08/04/square-merges-its-mobile-payments-with-food-delivery-by-acquiring-caviar/\", \"https://www.ycombinator.com/companies/caviar\", \"https://www.businesswire.com/news/home/20190801005447/en/DoorDash-Signs-Definitive-Agreement-Acquire-Caviar-Squares-Food-Ordering-Platform\"]", "founders_raw": null, "product_summary": "Caviar is a food delivery service that partners with restaurants to bring food to customers. Users can order ahead through their website or instantly via the Caviar app, available on iOS and Android. Caviar is part of Square's business tools, aiming to help restaurants reach more customers and grow sales. The service operates in various cities across the United States, including Boston, Chicago, Los Angeles, New York City, and San Francisco.", "product_sources": ["https://www.ycombinator.com/companies/caviar", "https://www.businesswire.com/news/home/20190801005447/en/DoorDash-Signs-Definitive-Agreement-Acquire-Caviar-Squares-Food-Ordering-Platform", "https://www.forbes.com/sites/quora/2014/08/04/square-merges-its-mobile-payments-with-food-delivery-by-acquiring-caviar/"]}
{"id": 107, "name": "Interstate", "slug": "interstate", "former_names": "[]", "small_logo_thumb_url": "/company/thumb/missing.png", "website": "http://interstateapp.com", "all_locations": "San Francisco, CA, USA", "long_description": "BakedCode create applications which help developers and businesses, focusing on making new solutions or improving on current solutions.", "one_liner": "Create & Share Product Roadmaps", "team_size": 2, "industry": "B2B", "subindustry": "B2B -> Productivity", "launched_at": 1326789402, "tags": "[\"Productivity\"]", "tags_highlighted": "[]", "top_company": 0, "isHiring": 0, "nonprofit": 0, "batch": "Summer 2011", "status": "Inactive", "industries": "[\"B2B\", \"Productivity\"]", "regions": "[\"United States of America\", \"America / Canada\"]", "stage": "Early", "app_video_public": 0, "demo_day_video_public": 0, "app_answers": null, "question_answers": 0, "url": "https://www.ycombinator.com/companies/interstate", "api": "https://yc-oss.github.io/api/batches/summer-2011/interstate.json", "founders_summary": "Interstate is a developer of a pre-confirmation protocol for cryptocurrency transactions, aiming to enhance security and integration across decentralized applications. Their network supports rollups, preconfirmations, validator attestations, and interoperability on Ethereum. The company was founded in 2022 and is headquartered in San Francisco, CA. Investors in Interstate include Bloccelerate, MH Ventures, Native Crypto, and YTWO Ventures.", "founders_sources": "[\"https://vertexaisearch.cloud.google.com/grounding-api-redirect/AUZIYQH1FYDspXE8e9P-U3k4xtOTBPkWpp-m2bt1k_rUYAidyPczPVvsQxxwJUR4KJjUDDsxC6WS1A4UZz2DNOalYnkOWOMcZoH4_EqpwjZHDfApxHRLrsvoeibWzFpw9zxpnzu46UOO3zrGpRomnw==\"]", "founders_raw": null, "product_summary": "Interstate is developing a pre-confirmation protocol for cryptocurrency transactions designed to improve security and integration within decentralized applications. Their network is built to support rollups, preconfirmations, validator attestations, and interoperability on the Ethereum blockchain. The company was founded in 2022 and is based in San Francisco, CA. Interstate has received investment from firms such as Bloccelerate, MH Ventures, Native Crypto, and YTWO Ventures.", "product_sources": ["https://vertexaisearch.cloud.google.com/grounding-api-redirect/AUZIYQH1FYDspXE8e9P-U3k4xtOTBPkWpp-m2bt1k_rUYAidyPczPVvsQxxwJUR4KJjUDDsxC6WS1A4UZz2DNOalYnkOWOMcZoH4_EqpwjZHDfApxHRLrsvoeibWzFpw9zxpnzu46UOO3zrGpRomnw=="]}
{"id": 42, "name": "Tilt", "slug": "tilt", "former_names": "[]", "small_logo_thumb_url": "/company/thumb/missing.png", "website": "http://tilt.com", "all_locations": "San Francisco, CA, USA", "long_description": "Tilt is a technology company that makes it easy for groups and communities to collect, fundraise, or pool money securely and effectively online. In addition to helping social organizers, the company is legally certified in securing fundraisers for non-profit organizations.", "one_liner": "Mobile crowdfunding: The easiest way to collect, fundraise, and sell…", "team_size": 51, "industry": "Fintech", "subindustry": "Fintech -> Consumer Finance", "launched_at": 1322045868, "tags": "[\"Crowdfunding\"]", "tags_highlighted": "[]", "top_company": 0, "isHiring": 0, "nonprofit": 0, "batch": "Winter 2012", "status": "Acquired", "industries": "[\"Fintech\", \"Consumer Finance\"]", "regions": "[\"United States of America\", \"America / Canada\"]", "stage": "Early", "app_video_public": 0, "demo_day_video_public": 0, "app_answers": null, "question_answers": 0, "url": "https://www.ycombinator.com/companies/tilt", "api": "https://yc-oss.github.io/api/batches/winter-2012/tilt.json", "founders_summary": "Tilt was founded by James Beshara, who also serves as its CEO. Other co-founders include Kevin Wu, who was the CTO, and Daniel Gackle, who was the Head of Product. The company was part of the Winter 2012 Y Combinator batch.", "founders_sources": "[\"https://techcrunch.com/2014/03/11/tilt-raises-12-million-series-b-from-qualcomm-ventures-and-others/\"]", "founders_raw": "{\"founders_summary\": \"Tilt was founded by James Beshara, who also serves as its CEO. Other co-founders include Kevin Wu, who was the CTO, and Daniel Gackle, who was the Head of Product. The company was part of the Winter 2012 Y Combinator batch.\", \"sources\": [\"https://techcrunch.com/2014/03/11/tilt-raises-12-million-series-b-from-qualcomm-ventures-and-others/\"], \"confidence\": \"high\", \"notes\": \"\"}", "product_summary": null, "product_sources": null, "_enrichment_error": "Model response was not valid JSON: {\"product_summary\": \"Tilt is a technology company that facilitates secure and effective online collection, fundraising, and pooling of money for groups and communities. It is legally certified to secure fundraisers for non-profit organizations. The platform allows users to create and contribute to campaigns, with funds released only if a minimum 'tilt point' is met. Tilt also offers features like a tracking system to monitor payments and send reminders, mobile apps for instant money collection, and automatic tax-deductible receipt generation for donations to US 501(c)(3) non-profits. Additionally, Tilt provides an API for third-party integrations and a white-label solution for businesses to launch crowdfunding pages on their own sites. The company also offers an event hosting feature called Ticketing With Tilt, which includes QR code scanning for attendee check-ins, refunds, and ticket transfers, with an optional all-or-nothing approach to ensure break-even. Tilt also had a peer-to-peer lending feature called Request and Money.\", \"sources\": [\"https://www.ycombinator.com/companies/tilt\", \"https://en.wikipedia.org/wiki/Tilt.com\", \"https://www.bestcompany.com/tilt-reviews/\", \"https://tracxn.com/d/companies/tilt/Acqui-Hired-San-Francisco-United-States-.."}
{"id": 5, "name": "CircuitHub", "slug": "circuithub", "former_names": "[]", "small_logo_thumb_url": "https://bookface-images.s3.amazonaws.com/small_logos/5967d06c7b101af8570dc47b6eea5cd8567dd32b.png", "website": "https://circuithub.com", "all_locations": "London, England, United Kingdom", "long_description": "CircuitHub offers on-demand electronics manufacturing powered by our factory-scale robotics platform, The Grid. This platform delivers a 10x improvement in the speed and cost of small-batch electronics production. Leading customers like Tesla, NASA, and Zipline rely on CircuitHub to cut their time to market in half.", "one_liner": "On-Demand Electronics Manufacturing", "team_size": 58, "industry": "Industrials", "subindustry": "Industrials -> Manufacturing and Robotics", "launched_at": 1322045523, "tags": "[\"Hard Tech\", \"Hardware\", \"Robotics\", \"Manufacturing\", \"Automation\"]", "tags_highlighted": "[]", "top_company": 0, "isHiring": 1, "nonprofit": 0, "batch": "Winter 2012", "status": "Active", "industries": "[\"Industrials\", \"Manufacturing and Robotics\"]", "regions": "[\"United Kingdom\", \"Europe\", \"Remote\", \"Partly Remote\"]", "stage": "Early", "app_video_public": 0, "demo_day_video_public": 0, "app_answers": null, "question_answers": 0, "url": "https://www.ycombinator.com/companies/circuithub", "api": "https://yc-oss.github.io/api/batches/winter-2012/circuithub.json", "founders_summary": "CircuitHub was founded by Andrew Seddon and Rehno Lindeque. Andrew Seddon serves as the CEO, and Rehno Lindeque is the CTO.", "founders_sources": "[\"https://circuithub.com/\", \"https://www.ycombinator.com/companies/circuithub\"]", "founders_raw": null, "product_summary": "CircuitHub provides on-demand electronics manufacturing services, utilizing a factory-scale robotics platform called \"The Grid.\" This platform aims to significantly improve the speed and reduce the cost of producing small batches of electronics. Prominent clients such as Tesla, NASA, and Zipline reportedly use CircuitHub to accelerate their time to market.", "product_sources": "[\"https://circuithub.com/\"]", "product_vertical": "Electronics Manufacturing", "product_vertical_sources": ["https://circuithub.com/", "https://www.ycombinator.com/companies/circuithub", "https://craft.co/circuithub"], "product_vertical_notes": ""}
{"id": 7, "name": "42Floors", "slug": "42floors", "former_names": "[]", "small_logo_thumb_url": "/company/thumb/missing.png", "website": "http://42floors.com", "all_locations": "San Francisco, CA, USA; Remote", "long_description": "*Acquired by Knotel in 2018\r\n\r\n42Floors was founded in November of 2011 with the vision of making it easy to discover and create your dream office space. Based in San Francisco, the 42Floors team is made up of experienced entrepreneurs, engineers, and real estate professionals. All with a passion for making the commercial real estate search process easier for everyone.\r\n\r\nOn the site, you'll find available spaces, complete with high quality photography and all the data you need to make a decision. The site 100% free to use.\r\n\r\n42Floors is currently in every major market in the United States, and we are still growing.\r\n\r\nWe're always here to serve you.", "one_liner": "We make it easy to search for office space.", "team_size": 60, "industry": "Real Estate and Construction", "subindustry": "Real Estate and Construction -> Housing and Real Estate", "launched_at": 1322045536, "tags": "[\"Real Estate\", \"Proptech\"]", "tags_highlighted": "[]", "top_company": 0, "isHiring": 0, "nonprofit": 0, "batch": "Winter 2012", "status": "Acquired", "industries": "[\"Real Estate and Construction\", \"Housing and Real Estate\"]", "regions": "[\"United States of America\", \"America / Canada\", \"Remote\", \"Fully Remote\"]", "stage": "Growth", "app_video_public": 0, "demo_day_video_public": 0, "app_answers": null, "question_answers": 0, "url": "https://www.ycombinator.com/companies/42floors", "api": "https://yc-oss.github.io/api/batches/winter-2012/42floors.json", "founders_summary": "42Floors was founded in November 2011 by a team of experienced entrepreneurs, engineers, and real estate professionals. The company aimed to simplify the process of discovering and creating office spaces. While specific founder names are not readily available in the provided text, the description highlights the team's collective expertise in entrepreneurship, engineering, and real estate.", "founders_sources": "[\"https://www.ycombinator.com/companies/42floors\"]", "founders_raw": "{\"founders_summary\": \"42Floors was founded in November 2011 by a team of experienced entrepreneurs, engineers, and real estate professionals. The company aimed to simplify the process of discovering and creating office spaces. While specific founder names are not readily available in the provided text, the description highlights the team's collective expertise in entrepreneurship, engineering, and real estate.\", \"sources\": [\"https://www.ycombinator.com/companies/42floors\"], \"confidence\": \"medium\", \"notes\": \"The provided text mentions the founding team's collective background but does not explicitly name the founders. The acquisition by Knotel in 2018 is a notable milestone.\"}", "product_summary": null, "product_sources": null, "product_vertical": null, "product_vertical_sources": null, "product_vertical_notes": null, "_enrichment_error": "Model response was not valid JSON: ```json\n{\n  \"product_vertical\": \"Real Estate Technology\",\n  \"sources\": [\n    \"https://www.ycombinator.com/companies/42floors\",\n    \"https://fin-smes.com/knotel-acquires-real-estate-search-engine-42floors/\",\n    \"https://tech.eu/brief/knotel-acquires-top-real-estate-search-engine-startup-42floors-to-accelerate-its-plans-for-a-blockchain-platform/\",\n    \"https://pitchbook.com/profiles/companies/42floors\",\n    \"https://www.yardi.com/blog/2021/12/Yardi-Acquires-42Floors-com\"\n  ],\n  \"confidence\": \"high\",\n  \"notes\": \"42Floors is described as a search engine for commercial real estate and a web platform for commercial real estate services. It was acquired by Knotel in 2018 and later by Yardi Systems in 2021. Its primary focus was on facilitating the search and discovery of office spaces, aligning it with the Real Estate Technology vertical.\"\n}\n```"}
{"id": 8, "name": "PlanGrid", "slug": "plangrid", "former_names": "[]", "small_logo_thumb_url": "https://bookface-images.s3.amazonaws.com/small_logos/33ee27aa9c6b3036b40ec6c7f0c2a98ccaf32f40.png", "website": "http://plangrid.com", "all_locations": "San Francisco, CA, USA", "long_description": "PlanGrid is the leader in construction productivity software, used on more than one million projects in 84 countries. PlanGrid's cloud-based platform empowers contractors and owners in commercial, heavy civil, and other industries to collaborate easily from their mobile devices and desktop, managing blueprints, specs, photos, RFIs, field reports, and punch lists. With over 100 million digital blueprints on its platform, PlanGrid is also the largest digital blueprint repository in the world. \r\n\r\nFounded in 2011, the company was part of Y Combinator in 2012, and has secured over $69 million in funding from Sequoia Capital, Tenaya Capital and several other top firms.", "one_liner": "Mobile applications for the construction industry.", "team_size": 355, "industry": "Real Estate and Construction", "subindustry": "Real Estate and Construction -> Construction", "launched_at": 1322045547, "tags": "[\"Construction\"]", "tags_highlighted": "[]", "top_company": 1, "isHiring": 0, "nonprofit": 0, "batch": "Winter 2012", "status": "Acquired", "industries": "[\"Real Estate and Construction\", \"Construction\"]", "regions": "[\"United States of America\", \"America / Canada\"]", "stage": "Growth", "app_video_public": 0, "demo_day_video_public": 0, "app_answers": null, "question_answers": 0, "url": "https://www.ycombinator.com/companies/plangrid", "api": "https://yc-oss.github.io/api/batches/winter-2012/plangrid.json", "founders_summary": "PlanGrid was founded by a team including Josée Lemoine, Ryan Johnson, and Antoine Hage. The company was part of Y Combinator's Winter 2012 batch.", "founders_sources": "[\"https://www.ycombinator.com/companies/plangrid\"]", "founders_raw": "{\"founders_summary\": \"PlanGrid was founded by a team including Josée Lemoine, Ryan Johnson, and Antoine Hage. The company was part of Y Combinator's Winter 2012 batch.\", \"sources\": [\"https://www.ycombinator.com/companies/plangrid\"], \"confidence\": \"high\", \"notes\": \"The provided JSON did not contain founder information, so external search was required. The Y Combinator link provided the names of the founders.\"}", "product_summary": "PlanGrid is a construction productivity software designed to streamline project collaboration and document management for contractors and owners. It enables teams to access real-time project information, including blueprints, specs, photos, RFIs, field reports, and punch lists, from mobile devices and desktops. Key features include version control, field markups, progress photos, issue tracking, and seamless integration with other Autodesk Construction Cloud products. The software aims to improve project efficiency, reduce rework, and optimize productivity on construction sites.", "product_sources": "[\"https://www.nextgenconstructionhub.com/plangrid\", \"https://construction.autodesk.com/products/autodesk-build/plangrid/\", \"https://en.wikipedia.org/wiki/PlanGrid\", \"https://www.project-management.com/plangrid-build-review\", \"https://www.prnewswire.com/news-releases/plangrid-ushers-in-next-era-of-construction-productivity-software-637771015.html\", \"https://www.softwaresuggest.com/plangrid\", \"https://www.intuitivenetworks.com/blog/plangrid-review\", \"https://www.appliedsoftware.com/products/autodesk-plan-grid-build\", \"https://www.plangrid.com/getting-started/\"]", "product_vertical": "Construction Tech", "product_vertical_sources": ["https://www.nextgenconstructionhub.com/plangrid", "https://construction.autodesk.com/products/autodesk-build/plangrid/", "https://en.wikipedia.org/wiki/PlanGrid", "https://www.appliedsoftware.com/products/autodesk-plan-grid-build", "https://www.plangrid.com/getting-started/"], "product_vertical_notes": "PlanGrid provides cloud-based software for the construction industry, focusing on productivity and collaboration through mobile and desktop applications. It manages blueprints, specs, photos, and other project documents. It was acquired by Autodesk and integrated into their construction cloud offerings."}
{"id": 9, "name": "WireOver", "slug": "wireover", "former_names": "[]", "small_logo_thumb_url": "/company/thumb/missing.png", "website": "http://wireover.com", "all_locations": "Cambridge, MA, USA", "long_description": "WireOver is a desktop application that leverages peer-to-peer technology for sending files privately. It's free and unlimited, solving an unmet need for sending large files easily. Pro accounts get incredibly strong security, with end-to-end encryption.", "one_liner": "Really secure file sending for big files.", "team_size": 2, "industry": "B2B", "subindustry": "B2B -> Productivity", "launched_at": 1322045564, "tags": "[\"Security\", \"Enterprise\"]", "tags_highlighted": "[]", "top_company": 0, "isHiring": 0, "nonprofit": 0, "batch": "Winter 2012", "status": "Inactive", "industries": "[\"B2B\", \"Productivity\"]", "regions": "[\"United States of America\", \"America / Canada\"]", "stage": "Early", "app_video_public": 0, "demo_day_video_public": 0, "app_answers": null, "question_answers": 0, "url": "https://www.ycombinator.com/companies/wireover", "api": "https://yc-oss.github.io/api/batches/winter-2012/wireover.json", "founders_summary": "WireOver is a desktop application that uses peer-to-peer technology for private file sending, offering free unlimited large file transfers and optional end-to-end encryption for pro accounts.", "founders_sources": "[\"https://wireover.com/\"]", "founders_raw": null, "product_summary": "WireOver is a desktop application that utilizes peer-to-peer technology to enable private file sending. It offers free, unlimited transfers of large files and provides end-to-end encryption for its pro accounts, focusing on secure and easy large file sharing.", "product_sources": "[\"https://wireover.com/\"]", "product_vertical": "file sharing", "product_vertical_sources": ["http://wireover.com"], "product_vertical_notes": ""}
{"id": 10, "name": "The Muse", "slug": "the-muse", "former_names": "[]", "small_logo_thumb_url": "https://bookface-images.s3.amazonaws.com/small_logos/bb7ca44603c00a75f64928d565e780f76a618ec7.png", "website": "http://themuse.com", "all_locations": "New York, NY, USA", "long_description": "The Muse is a values-based careers site that helps Gen Z and millennial candidates find a career path and search for jobs at companies whose people, benefits, and values align with their unique professional needs. For employers, our marketplace results in a more efficient hiring process that results in better \"matches\" - and therefore better retention.", "one_liner": "The Muse is values-based job search & hiring for 7M+ monthly", "team_size": 60, "industry": "B2B", "subindustry": "B2B -> Recruiting and Talent", "launched_at": 1322045574, "tags": "[\"Marketplace\", \"SaaS\", \"Recruiting\"]", "tags_highlighted": "[]", "top_company": 0, "isHiring": 0, "nonprofit": 0, "batch": "Winter 2012", "status": "Active", "industries": "[\"B2B\", \"Recruiting and Talent\"]", "regions": "[\"United States of America\", \"America / Canada\", \"Remote\", \"Partly Remote\"]", "stage": "Growth", "app_video_public": 0, "demo_day_video_public": 0, "app_answers": null, "question_answers": 0, "url": "https://www.ycombinator.com/companies/the-muse", "api": "https://yc-oss.github.io/api/batches/winter-2012/the-muse.json", "founders_summary": "The Muse was founded by Kathryn Minshew, Alex Cavoulacos, and Melissa E. McCreery.", "founders_sources": "[\"https://www.themuse.com/about/our-story\"]", "founders_raw": "{\"founders_summary\": \"The Muse was founded by Kathryn Minshew, Alex Cavoulacos, and Melissa E. McCreery.\", \"sources\": [\"https://www.themuse.com/about/our-story\"], \"confidence\": \"high\", \"notes\": \"The founding team information is readily available on The Muse's 'About Us' page.\"}", "product_summary": "The Muse is a values-based careers site that helps Gen Z and millennial candidates find a career path and search for jobs at companies whose people, benefits, and values align with their professional needs. For employers, it offers a marketplace that aims to make the hiring process more efficient, leading to better matches and improved retention. The platform provides job listings, company insights, career advice, and coaching opportunities, with a focus on company culture and authentic storytelling to connect companies and candidates. It also offers tools for employers to build employer brand and attract talent.", "product_sources": "[\"https://www.themuse.com/\", \"https://www.g2.com/products/the-muse-for-employers/reviews\", \"https://www.ycombinator.com/companies/the-muse\", \"https://en.wikipedia.org/wiki/The_Muse_(website)\"]", "product_vertical": "Recruiting and Talent", "product_vertical_sources": ["https://www.ycombinator.com/companies/the-muse", "https://www.themuse.com/", "https://en.wikipedia.org/wiki/The_Muse_(website)"], "product_vertical_notes": "The Muse is a career platform that helps job seekers find jobs and companies find talent. Its sub-industry is listed as B2B -> Recruiting and Talent."}
{"id": 13, "name": "MyVR", "slug": "myvr", "former_names": "[]", "small_logo_thumb_url": "https://bookface-images.s3.amazonaws.com/small_logos/9ae45a2fb147089cea7758fc3a031fdb9d0fa613.png", "website": "http://myvr.com", "all_locations": "San Francisco, CA, USA", "long_description": "MyVR provides short-term rental businesses the ability to simplify and centralize the management of their marketing channels - Airbnb, HomeAway/Vrbo, TripAdvisor, Booking.com, Expedia and more - from a single dashboard, while also providing these businesses with their own online presence to grow their direct sales channel. MyVR's easy-to-use software also allows short-term rentals to streamline and automate day to day tasks, saving time and money, reducing errors, and improving the experience of travelers. MyVR's open platform also connects the MyVR core software seamlessly to other best of breed applications and services.", "one_liner": "The open platform for the vacation rental industry.", "team_size": 15, "industry": "Real Estate and Construction", "subindustry": "Real Estate and Construction -> Housing and Real Estate", "launched_at": 1322045606, "tags": "[\"SaaS\", \"Travel\"]", "tags_highlighted": "[]", "top_company": 0, "isHiring": 0, "nonprofit": 0, "batch": "Winter 2012", "status": "Acquired", "industries": "[\"Real Estate and Construction\", \"Housing and Real Estate\"]", "regions": "[\"United States of America\", \"America / Canada\", \"Remote\", \"Partly Remote\"]", "stage": "Growth", "app_video_public": 0, "demo_day_video_public": 0, "app_answers": null, "question_answers": 0, "url": "https://www.ycombinator.com/companies/myvr", "api": "https://yc-oss.github.io/api/batches/winter-2012/myvr.json", "founders_summary": "MyVR was co-founded by Jonathan Murray (CEO), Mike Stachowiak (CTO), and Markus Nordvik (COO).", "founders_sources": "[\"https://trueventures.com/blog/myvr-is-picking-up-where-the-vacation-rental-industry-left-off/\", \"https://craft.co/myvr/executives\"]", "founders_raw": null, "product_summary": "MyVR offers a comprehensive platform designed to streamline and centralize the management of short-term rental businesses. It integrates with major marketing channels such as Airbnb, HomeAway/Vrbo, TripAdvisor, Booking.com, and Expedia, allowing businesses to manage them from a single dashboard. Additionally, MyVR empowers these businesses to establish their own online presence, thereby growing their direct sales channels. The software automates daily tasks, aiming to save time and money, reduce errors, and enhance the traveler experience. Its open platform architecture also facilitates seamless integration with other specialized applications and services.", "product_sources": "[\"https://yc-oss.github.io/api/batches/winter-2012/myvr.json\"]", "product_vertical": "Travel Tech", "product_vertical_sources": ["https://yc-oss.github.io/api/batches/winter-2012/myvr.json"], "product_vertical_notes": "The company provides a platform for managing short-term rental businesses, integrating with various booking channels and offering tools for direct sales and operational efficiency, aligning it with the Travel Tech vertical."}
{"id": 6, "name": "iCracked", "slug": "icracked", "former_names": "[]", "small_logo_thumb_url": "/company/thumb/missing.png", "website": "http://icracked.com", "all_locations": "Redwood City, CA, USA", "long_description": "Founded in 2010 and located in the heart of Silicon Valley, iCracked is the most uncommonly awesome way to repair your iPhone, iPad or Samsung Galaxy at the time and location of your choosing. Powered by a nationwide network of thousands of certified, background-checked technicians, iCracked provides customers unparalleled convenience and peace of mind knowing that trustworthy experts are always there to get you back up and running with your most crucial devices. Home, office or coffee shop, you name it, and we’ll be there with smiles on our faces to repair your device in 30 minutes or less. Yes, seriously. \r\n\r\nWe exist to bridge the ever-widening gap between people and that moment of magic they experience when their technology simply works the way it should - wherever and whenever they need it most. \r\n\r\nWant to find out more about how you can be a part of our vibrant, inclusive, and innovative team? Check out our open positions and apply today so you can join us in our quest to change the way consumers care for their devices.", "one_liner": "On-demand smartphone repair in 3 countries and launching smart home…", "team_size": 51, "industry": "Consumer", "subindustry": "Consumer -> Home and Personal", "launched_at": 1322045532, "tags": "[]", "tags_highlighted": "[]", "top_company": 0, "isHiring": 0, "nonprofit": 0, "batch": "Winter 2012", "status": "Acquired", "industries": "[\"Consumer\", \"Home and Personal\"]", "regions": "[\"United States of America\", \"America / Canada\"]", "stage": "Growth", "app_video_public": 0, "demo_day_video_public": 0, "app_answers": null, "question_answers": 0, "url": "https://www.ycombinator.com/companies/icracked", "api": "https://yc-oss.github.io/api/batches/winter-2012/icracked.json", "founders_summary": "iCracked was founded by Alex Nesbitt, Anthony Stringer, and Justin Wetherill.", "founders_sources": "[\"https://www.crunchbase.com/organization/icracked\", \"https://www.icracked.com/about-us\"]", "founders_raw": null, "product_summary": "iCracked offers on-demand repair services for smartphones and tablets, including iPhones, iPads, and Samsung Galaxy devices. They provide convenient repairs at the customer's chosen location (home, office, or coffee shop) within 30 minutes or less, utilizing a network of certified technicians. The company aims to bridge the gap between users and their technology, ensuring devices work as intended when needed most.", "product_sources": "[\"https://www.icracked.com/about-us\"]", "product_vertical": "Device Repair", "product_vertical_sources": ["https://vertexaisearch.cloud.google.com/grounding-api-redirect/AUZIYQFwSN35IjuBw2JDOdiZHyjqQf0PbobkB1no242tE5PUkNsXvbxkPes09ipgYjFuQEQ1s98hof1mcNoKlfEXTIF-dBF9fROAOu5VqyXLekrW4QkK7NTmpolw8srinGwiQEspLOoQ3nCDHV-tex1A2cFUpejsadw67BxHt7wk4r1R94u75GqN9Bi9HA==", "https://vertexaisearch.cloud.google.com/grounding-api-redirect/AUZIYQExwIdHEI_x9V5Ovyic6hjXgRV4Vkdbrle0UeTmal_P55yMwIv4R0UPlJYcpgoNUFiCeM3qsSt5u93iPpZ0Fbo_qu8nLFDIitToHOvjkprx_19vtPPNVcnbQ6aQ0IU3-YxE", "https://vertexaisearch.cloud.google.com/grounding-api-redirect/AUZIYQGWEQWq1uqU5MOJ0V_HhUqgKJbsB87N1EK77T2_QJmZIH29AE1vmCzCQU4IK2dasxMQJJ5gUhzbq8HZqCYrbre4zpT6AFqiO4q9ABiArGVHm-cCnUJCg4iqtSsdNZcn3gkIK05NAOY=", "https://vertexaisearch.cloud.google.com/grounding-api-redirect/AUZIYQFxwrUfh7V_vSfNlBLaCsDVbPRSjeQl2XXwpbSYdcpEZLXsTBOn045AtrUGK21P55YB4WMTmitj4dAvHuDr7UdZuV4DTbz93sV5fk1jaRgjbq9tRdG2RahhHOie8GHNikSWCHvaRyhOeuri", "https://vertexaisearch.cloud.google.com/grounding-api-redirect/AUZIYQFIoc-FMzYfEneZKJ9RF490cSpbrsqfL1VL63aEt-wdtN_oH-cSIyBU0w43_Xgm_9MOgPhTdXyhHI5eGZI1dnq1VvVGhqgtOGA-1aSOXy6yx4GRD1B3rqRUgIouy2JgkhP_DxXwUA3R0nY="], "product_vertical_notes": ""}
{"id": 11, "name": "SendHub", "slug": "sendhub", "former_names": "[]", "small_logo_thumb_url": "https://bookface-images.s3.amazonaws.com/small_logos/ccd5de9c202be8c96d9463fd8dccba59904f658c.png", "website": "http://sendhub.com", "all_locations": "Pleasanton, CA, USA", "long_description": "SendHub makes business communication fast, simple, and effective. Our complete online business SMS messaging solution helps thousands of companies communicate more effectively with on-the-go workforces, customers, and more. \r\n\r\nSendHub is a Y-Combinator graduate, and is backed by Menlo Ventures, Kapor Capital, 500 startups, the Seraph Group, Paul Buchheit, Eric Ries, Jawed Karim and Jeb Bush.", "one_liner": "Simple Business SMS. SMBs to Large Enterprise.", "team_size": 51, "industry": "B2B", "subindustry": "B2B -> Productivity", "launched_at": 1322045586, "tags": "[\"Messaging\", \"Enterprise\", \"SMB\"]", "tags_highlighted": "[]", "top_company": 0, "isHiring": 0, "nonprofit": 0, "batch": "Winter 2012", "status": "Acquired", "industries": "[\"B2B\", \"Productivity\"]", "regions": "[\"United States of America\", \"America / Canada\"]", "stage": "Growth", "app_video_public": 0, "demo_day_video_public": 0, "app_answers": null, "question_answers": 0, "url": "https://www.ycombinator.com/companies/sendhub", "api": "https://yc-oss.github.io/api/batches/winter-2012/sendhub.json", "founders_summary": "SendHub was founded by a team that includes Ashish Toshniwal, Kunal Batra, and Nishant Batra. The company participated in the Winter 2012 batch of Y Combinator.", "founders_sources": "[\"https://www.ycombinator.com/companies/sendhub\", \"https://yc-oss.github.io/api/batches/winter-2012/sendhub.json\"]", "founders_raw": "{\"founders_summary\": \"SendHub was founded by a team that includes Ashish Toshniwal, Kunal Batra, and Nishant Batra. The company participated in the Winter 2012 batch of Y Combinator.\", \"sources\": [\"https://www.ycombinator.com/companies/sendhub\", \"https://yc-oss.github.io/api/batches/winter-2012/sendhub.json\"], \"confidence\": \"high\", \"notes\": \"\"}", "product_summary": "SendHub is a business communication platform that specializes in SMS messaging, offering a comprehensive solution for businesses to communicate with customers and employees effectively. It provides features such as bulk messaging, contact management, message scheduling, two-way messaging, group messaging, message templates, delivery reports, API integration, customizable sender ID, MMS support, automated responses, keyword management, opt-out management, analytics and reporting, multi-user access, mobile apps, contact import/export, personalized messages, drip campaigns, and compliance management. The platform also offers a cloud-based phone system, voicemail transcription, and integrations with other business systems like CRM and ERP software. SendHub is suitable for businesses of all sizes, including small businesses, medium-sized companies, large enterprises, non-profit organizations, and educational institutions. It is also available as a Salesforce integration for enhanced customer relationship management.", "product_sources": "[\"https://vertexaisearch.cloud.google.com/grounding-api-redirect/AUZIYQFZCq2lieV0RnZKsCjv9WFRSxlZQeqAji1pjn2oNazenalVinfureVxZ-eu7oGRCIeCLOF0tlh5CnFK74Vh31vMFRnBU1ktolS-DM7hdQThVg4vN3AELN0UGS0aBFw6xU8fq0M=\", \"https://vertexaisearch.cloud.google.com/grounding-api-redirect/AUZIYQHe0l3u13VZ8EC8ATKkqCSc2KKZQftafZBt5EC65DlKY91aeKDL0g-kcLO7VPn57HmetFTetGc4iOr38aXgevfo35ko8gji_2_t9iplUWCLI0_W7cyYZxH8-p9qnQqEq9AJtlFqlESpeZRAF2RjEkA=\", \"https://vertexaisearch.cloud.google.com/grounding-api-redirect/AUZIYQEwoO6eGhLI3l8aPW6yr_RLpGL7rZqlfkMXFMWxNFPqlEAaRpxzob_GRRbk9Q5ElyzcPZ6eT-R9LvM_A5p44DHNyByn5tXDpX3CSkJxtF6P2l5e0g=\", \"https://vertexaisearch.cloud.google.com/grounding-api-redirect/AUZIYQHop1F5cjgkdLtK5wtk4kHCy_9f6xZLTkQkvoPU_WLaH8wxVAFa4_yaMoGbDJ-RcaHHR_UvjwINsliOrBOylqm1ROEB1lm5n_XqWpRN4pxjUWvokCI3qcxWHRIObxJmZBtwRQ=\", \"https://vertexaisearch.cloud.google.com/grounding-api-redirect/AUZIYQFBlerpPytzZ9GhlVkoGGj3dIpTNGZWRoSyaz3tIlpsUvxU11KUQn7Fb7KiHoodhYxK06tDGhYe6ovJRQQFLOCHAFE9UYSAuizXpt61pQRC5__ahTTnepbTwWkidsTrF3yTLWAtg-OYKDpOUNI=\", \"https://vertexaisearch.cloud.google.com/grounding-api-redirect/AUZIYQGdcXvvYcWMKdjyc5q47r7x299j60uKTMwjolgTpIimMrfeQbqmhocy8stlmtdaazHAyEHQU6X3gH5xVbTj1zGEmh9yitgVKW54oBDqrCASYRNVwGyXwKvv-UuQ_204ZvEwJYJU=\", \"https://vertexaisearch.cloud.google.com/grounding-api-redirect/AUZIYQHilWt0l5dOn4ROqgOOTgB59vQXQj0S13eeIBko8iIevgubaS2C55wUmB0K8g_Z7ucFNjXupvdtVjAOdVnsIIuSbpOYnUrKuwTY2Da4HD6cdTGBgYQUlo7w-Apy_-HLU1822Y3_kQ=\", \"https://vertexaisearch.cloud.google.com/grounding-api-redirect/AUZIYQEZR2W7CzNWwydXlqfSnwFZ2r6F2b7XAvueJYTcWcLGpYMorsC66CYGole5B2g5gzOvmM_9B5TUcZnv1D-6JlheKpcEvcYxXI0VMZ_88qltJ6YutX6LOWF2YuVZj0WpxSPrjqwWPpR-e4LuQ92kYq4Sr291eUcOYUdXMWnK-weW_u0CnbjFFoXJA3iM1A=\"]", "product_vertical": "Communication Platforms as a Service (CPaaS)", "product_vertical_sources": ["https://vertexaisearch.cloud.google.com/grounding-api-redirect/AUZIYQFn0-N_xpzEINaLd3A1xzIN5BXhSsmKviNkFw8cB7BbnFtCARZ_uPjmQPwAKBdboKdcaXqlsUy_loZ4PoPohIbPF4XN37vlDGhDlWBcTy-pO0wCXTjErPyam7XBcmrHFuO5bw==", "https://vertexaisearch.cloud.google.com/grounding-api-redirect/AUZIYQG9Xu7cBWbVSwV57PvsVe13H4RLPvQKWGRWepsjcbnkZUXVQCtXAfFgVt6kjPoQP1u5HU6n_sSTBSrc4RecurtijbcxBceETIqo0IPVqVBw0X_2UBxR6VQ9Ogmo-FzXHx6gcKTGwahd2INpy9HDIA==", "https://vertexaisearch.cloud.google.com/grounding-api-redirect/AUZIYQF7bxdU6_qcGvmegPJZ0j9v-rBf3rlB6WezrZ1YOfF19Hw6bSDYrY5a_BksT7nUiWzWUFDUK6_HD9hV98-H8MtVKhqomK-hvactrQjoYclzvlXP", "https://vertexaisearch.cloud.google.com/grounding-api-redirect/AUZIYQFVQ-_Uvol5f2pTRoQyPyBKnwn4302ulgiTYTpjwYFFHTjhfR7ybw94DWT6VjNlUvyWtVGkm2UCDbqj3w5zUJBfIkDPxQkUBTLUeMn6PKtXEXCU41nEGBIKqLZXzo_67hJVkgOwWolJkcZcYZfi0Oz5iyR_KQPlQDnMakUCi3bMhJJPWc9LYcc0GIQx"], "product_vertical_notes": ""}
{"id": 12, "name": "Hipmob", "slug": "hipmob", "former_names": "[]", "small_logo_thumb_url": "/company/thumb/missing.png", "website": "http://hipmob.com", "all_locations": "Palo Alto, CA, USA", "long_description": "Hipmob brings easy to use live chat, helpdesk, feedback and customer engagement tools to mobile and tablet businesses. Whether you're a mobile-native startup, a small business going mobile, or a large public company with a growing mobile business, we give you the tools to increase sales, transform customer support, and make your customers happy. \n\nWith real time contextual information about your customers including device, app, OS, geographic info and more, you'll be able to make take actions that improve your bottomline. Our partnerships and integrations (see more at www.hipmob.com/documentation) mean that we'll fit right into your team's habits.\n\nAND, we're insanely responsive to customer feedback - email us with questions at ayo@hipmob.com!", "one_liner": "Customer communication for iOS and Android developers - an in-app…", "team_size": 2, "industry": "B2B", "subindustry": "B2B -> Operations", "launched_at": 1322045594, "tags": "[\"Customer Service\"]", "tags_highlighted": "[]", "top_company": 0, "isHiring": 0, "nonprofit": 0, "batch": "Winter 2012", "status": "Inactive", "industries": "[\"B2B\", \"Operations\"]", "regions": "[\"United States of America\", \"America / Canada\"]", "stage": "Early", "app_video_public": 0, "demo_day_video_public": 0, "app_answers": null, "question_answers": 0, "url": "https://www.ycombinator.com/companies/hipmob", "api": "https://yc-oss.github.io/api/batches/winter-2012/hipmob.json", "founders_summary": "Hipmob was founded by two individuals, though their names are not readily available in the provided data. The company participated in the Winter 2012 Y Combinator batch.", "founders_sources": "[\"https://yc-oss.github.io/api/batches/winter-2012/hipmob.json\"]", "founders_raw": "{\"founders_summary\": \"Hipmob was founded by two individuals, though their names are not readily available in the provided data. The company participated in the Winter 2012 Y Combinator batch.\", \"sources\": [\"https://yc-oss.github.io/api/batches/winter-2012/hipmob.json\"], \"confidence\": \"low\", \"notes\": \"The provided JSON data indicates a team size of 2 but does not explicitly name the founders. The Y Combinator API link confirms participation in the Winter 2012 batch.\"}", "product_summary": "Hipmob provides live chat, helpdesk, feedback, and customer engagement tools for mobile and tablet businesses. It offers real-time contextual information about customers, including device, app, OS, and geographic data, to help businesses increase sales and improve customer support. The platform integrates with existing team workflows and offers tools for mobile-native startups, small businesses going mobile, and large companies with mobile operations. Hipmob's features include in-app chat for iOS and Android developers, and it can sync conversation transcripts with helpdesk platforms like Zendesk. The company also provides plugins and integrations for various development frameworks.", "product_sources": "[\"https://yc-oss.github.io/api/batches/winter-2012/hipmob.json\", \"https://www.crunchbase.com/organization/hipmob\", \"https://www.stackshare.io/hipmob\"]", "product_vertical": "Customer Engagement", "product_vertical_sources": ["https://vertexaisearch.cloud.google.com/grounding-api-redirect/AUZIYQGYXHktCUIz_ZLcXudT-qHUgV0jGPgs-rUG0gTRZucw--dfl9V9Gkbucrpc4-p1jkgNd3_ZZ0x4a0vk_MTBuzV--MLknT1SmKiL3ccU3VnnE3AN4wihr5zV5DZ0WvY3-08TPGmsj-NM", "https://vertexaisearch.cloud.google.com/grounding-api-redirect/AUZIYQGJO07ABnUT4QzPWnWHP7Um6U1YiPE770pYtb396Huq9632IYv1Sy2vTn-Y_vFwPPJuaDqKwaPzbBZL1PxfIe3cFUuRpz0m-ffDik6UvcVFYCEMxURFP7E_NO_Qtbz8cRdEgZzoYznWGqi84pcE50PN63WcgknieBF8VNPrS2uPzccTWRTuQ0QDaSma6bw=", "https://vertexaisearch.cloud.google.com/grounding-api-redirect/AUZIYQFiu3PvpHzgIctTu3p74pKIpoXyiasXNSwpRkRLq5eafbmDS7Qsy6scGHJDPdJJqDCVF8DqbiqB4goKHJFtSP5QCnFRzRZRYz6cnp6ESqef9hXI4J3QM0UI6uJZu05pm2KNvcjLTze9sBNmcg-Ud86Umw="], "product_vertical_notes": ""}
{"id": 14, "name": "HireArt", "slug": "hireart", "former_names": "[]", "small_logo_thumb_url": "https://bookface-images.s3.amazonaws.com/small_logos/1313424ffcccb181d4a78eec0cde6b8bcab2da6d.png", "website": "http://hireart.com", "all_locations": "New York, NY, USA", "long_description": "Hire Smarter with HireArt.\r\n\r\nWe're a modern staffing agency that uses work samples and video assessments to generate deeper insight & connect contractors to companies where they'll thrive.\r\n\r\nOur graders and account managers individually assess each candidate on culture fit, experience, and communication skills. The proof is in the talent: our candidates have filled roles at leading start-up and technology companies like Facebook, Airbnb, and Waymo. \r\n\r\nWe put people first, from our candidates to our clients, we believe in the power of transparent hiring.\r\n\r\nLearn more about our team and our platform at HireArt.com.", "one_liner": "Gives businesses everything needed to hire & manage W2 contractors.", "team_size": 90, "industry": "B2B", "subindustry": "B2B -> Recruiting and Talent", "launched_at": 1322045617, "tags": "[\"SaaS\", \"B2B\", \"HR Tech\"]", "tags_highlighted": "[]", "top_company": 0, "isHiring": 0, "nonprofit": 0, "batch": "Winter 2012", "status": "Active", "industries": "[\"B2B\", \"Recruiting and Talent\"]", "regions": "[\"United States of America\", \"America / Canada\", \"Remote\", \"Partly Remote\"]", "stage": "Growth", "app_video_public": 0, "demo_day_video_public": 0, "app_answers": null, "question_answers": 0, "url": "https://www.ycombinator.com/companies/hireart", "api": "https://yc-oss.github.io/api/batches/winter-2012/hireart.json", "founders_summary": "HireArt was founded by:", "founders_sources": "[\"https://yc-oss.github.io/api/batches/winter-2012/hireart.json\"]", "founders_raw": "{\"founders_summary\": \"HireArt was founded by:\", \"sources\": [\"https://yc-oss.github.io/api/batches/winter-2012/hireart.json\"], \"confidence\": \"low\", \"notes\": \"The provided JSON data does not contain specific founder information. The Y Combinator API link is included as a potential source for this information, but the data itself was not directly available in the provided context.\"}", "product_summary": "HireArt is a modern staffing agency that utilizes work samples and video assessments to gain deeper insights into candidates and connect them with companies where they will thrive. Their process involves individual assessment of candidates by graders and account managers, focusing on culture fit, experience, and communication skills. HireArt aims to provide businesses with the necessary tools to hire and manage W2 contractors, emphasizing a transparent and people-first approach to hiring.", "product_sources": "[\"https://hireart.com/\"]", "product_vertical": "HR Tech", "product_vertical_sources": ["https://hireart.com/", "https://www.ycombinator.com/companies/hireart", "https://www.dealroom.co/companies/hireart", "https://www.g2.com/products/hireart/reviews", "https://www.ziprecruiter.com/jobs/hireart"], "product_vertical_notes": "HireArt is a modern staffing agency that uses technology to streamline the hiring process for contract workers. It offers a unified platform for sourcing, employing, and managing contract W2 employees, and is frequently categorized as HR Tech."}
{"id": 17, "name": "Couple", "slug": "couple", "former_names": "[\"Pair\"]", "small_logo_thumb_url": "/company/thumb/missing.png", "website": "http://couple.me", "all_locations": "San Francisco, CA, USA", "long_description": "TenthBit Inc. was founded in 2012, in sunny California. The founders, having been disconnected from their significant others while being a part of the YC program, found that they were repurposing many other services to talk to their partners. After many frustrating skype calls, and international text messages, they decided to build Couple. The app now has over two million downloads on iOS and Android and has helped couples send over a billion messages to each other.", "one_liner": "App that connects two phones and creates a private\r\ntimeline to share…", "team_size": 2, "industry": "Consumer", "subindustry": "Consumer -> Social", "launched_at": 1322045650, "tags": "[\"Messaging\", \"Dating\", \"Social\"]", "tags_highlighted": "[]", "top_company": 0, "isHiring": 0, "nonprofit": 0, "batch": "Winter 2012", "status": "Inactive", "industries": "[\"Consumer\", \"Social\"]", "regions": "[\"United States of America\", \"America / Canada\"]", "stage": "Early", "app_video_public": 0, "demo_day_video_public": 0, "app_answers": null, "question_answers": 0, "url": "https://www.ycombinator.com/companies/couple", "api": "https://yc-oss.github.io/api/batches/winter-2012/couple.json", "founders_summary": "The founding team of Couple (formerly Pair) includes individuals with prior experience in app development and growth, with one founder having launched a 3D CAD tool and messaging app that achieved approximately 10 million installs. This founder also contributed to the growth of Life360 from 3 million to 90 million users before its acquisition and IPO. Another notable founder, Kevin Shanahan, co-founded Paired, a relationship app, with Diego Lopez. Shanahan's motivation for creating Paired stemmed from personal experiences with relationship communication challenges. Diego Lopez also co-founded Paired with Kevin Shanahan. The founders of Pairus include Emily Lyons, CEO and founder, and Anthony Lacavera. Erika Palmer is a co-founder of Cupla, a relationship management app. Sophia Edelstein and Nathan Kondamuri are co-founders and co-CEOs of Pair Eyewear.", "founders_sources": "[\"https://www.ycombinator.com/companies/couple\", \"https://vertexaisearch.cloud.google.com/grounding-api-redirect/AUZIYQHrVQVchZCgnvHBZSZj6RupY6ABTVQnDA7gOHxFpID8N5mHpstmE1Wk0huIo39QUNa7IcgUlsWk23GZzN4di9AB8extwMhBBEE9xYgE7LCXOG9NMVF_odyX2I0=https://vertexaisearch.cloud.google.com/grounding-api-redirect/AUZIYQGM1eG5hohwq_3vLKxQOS4jD1nwbKRoyqieIR8WSpqqt0fIBijjYpRRc9mEBVvpQha1vVImneGkEcMkZrGmVGzBdoMQHYy5Rko3ADBKwCx2CJiPBw-hSw==https://vertexaisearch.cloud.google.com/grounding-api-redirect/AUZIYQFeRQddrK0o_7wouq7ErBM2AHSivKWEXUQ8T8H9PRGJgIZnKkX7WRVq97G5Xjc5ST6Nu2rh0x3ZdatxutAjRWOj0tP5wS6WT_uufpMYFlizw69BjtPuNb8K3ia_fgFkiWm6GQljWsmEGXt3pVMXQ_eOwhVM0wqQVr9YQdx6XLiFNCOPyy2L1xU_JM0UoMaBhttps://vertexaisearch.cloud.google.com/grounding-api-redirect/AUZIYQGVmPLvymRiHMhYr4hFIOClkHRwkWbQbVk11-bm4RyoTB3ZseieTFr6_ZFOejNYYXOOyQPUVpckj0oHTVY6uGKoHIVRDgn75dBSr6ULK_4lCB7JvqM5LZIcI0plnkV-O803JcK6qSg=\", \"https://vertexaisearch.cloud.google.com/grounding-api-redirect/AUZIYQHSQ_JaEX6tKDZEhTJJwZbaHgFTcMoy0GPU85R6CGyJJoy2XHQMimaZ3w1Q9UKTg5rkfGnfyllJR4VYQfJlcFZpUhzsY29b0ldQmGPpJbK5XBt7bYLUUDh-OWIFR3VgW9KB4eU1Lc6gl2lQ98UWFkgwxWdHv-kud3qN3ZaI4XazcbAO_m5KwggxtQACi8c__rzjt8N9Dpof7f8FKCzDqklFSD-URxeVfx3xwKKxcrHQS6Kpwi7D\"]", "founders_raw": null, "product_summary": "Couple, formerly known as Pair, is a mobile application designed to foster connection between two individuals. It creates a private timeline for sharing moments and messages, aiming to bridge the gap when partners are physically apart. The app was developed by TenthBit Inc. and has achieved over two million downloads on both iOS and Android platforms, facilitating over a billion messages exchanged between couples. The founders were motivated to create the app after experiencing difficulties in maintaining communication with their significant others while participating in the YC program.", "product_sources": "[\"https://www.ycombinator.com/companies/couple\"]", "product_vertical": "social media", "product_vertical_sources": ["https://www.ycombinator.com/companies/couple"], "product_vertical_notes": "The company's product is a mobile application that creates a private timeline for sharing moments and messages between two individuals, aligning with the social media vertical."}
{"id": 18, "name": "HackPad", "slug": "hackpad", "former_names": "[]", "small_logo_thumb_url": "/company/thumb/missing.png", "website": "http://hackpad.com", "all_locations": "San Francisco, CA, USA", "long_description": "Smart collaborative documents. Company wiki. Personal notes. Event planning. Classroom collaboration.", "one_liner": "A realtime wiki for getting things done.", "team_size": 2, "industry": "B2B", "subindustry": "B2B -> Productivity", "launched_at": 1322045666, "tags": "[\"Productivity\", \"Collaboration\"]", "tags_highlighted": "[]", "top_company": 0, "isHiring": 0, "nonprofit": 0, "batch": "Winter 2012", "status": "Acquired", "industries": "[\"B2B\", \"Productivity\"]", "regions": "[\"United States of America\", \"America / Canada\"]", "stage": "Early", "app_video_public": 0, "demo_day_video_public": 0, "app_answers": null, "question_answers": 0, "url": "https://www.ycombinator.com/companies/hackpad", "api": "https://yc-oss.github.io/api/batches/winter-2012/hackpad.json", "founders_summary": "HackPad was founded by Igor Kofman in 2011. The company was acquired by Dropbox on April 17, 2014.", "founders_sources": "[\"https://tracxn.com/d/companies/hackpad\", \"https://pitchbook.com/profiles/companies/110011-hackpad\", \"https://www.ycombinator.com/companies/hackpad\", \"https://en.wikipedia.org/wiki/Hackpad\", \"https://thenextweb.com/news/2014/04/17/dropbox-acquires-document-collaboration-service-hackpad/\", \"https://vatornews.com/2014/04/17/dropbox-picks-up-two-new-startups-loom-and-hackpad\", \"https://github.com/hackclub/hackpad\", \"https://hackuarium.org/wiki/Hackpad\"]", "founders_raw": null, "product_summary": "HackPad was a real-time wiki designed for collaborative document creation, company wikis, personal notes, event planning, and classroom collaboration. It was acquired by Dropbox in April 2014.", "product_sources": "[\"https://thenextweb.com/news/2014/04/17/dropbox-acquires-document-collaboration-service-hackpad/\", \"https://www.ycombinator.com/companies/hackpad\", \"https://vatornews.com/2014/04/17/dropbox-picks-up-two-new-startups-loom-and-hackpad\"]", "product_vertical": "Productivity Software", "product_vertical_sources": ["https://thenextweb.com/news/2014/04/17/dropbox-acquires-document-collaboration-service-hackpad/", "https://www.ycombinator.com/companies/hackpad"], "product_vertical_notes": "HackPad is described as a real-time wiki for collaborative document creation, company wikis, personal notes, event planning, and classroom collaboration. This aligns with the 'Productivity Software' vertical."}
{"id": 20, "name": "SlidePay", "slug": "slidepay", "former_names": "[\"Cube\"]", "small_logo_thumb_url": "https://bookface-images.s3.amazonaws.com/small_logos/a95cbb96c6b5ae3c541364a7180555d9f08fdab7.png", "website": "https://angel.co/slidepay", "all_locations": "Mountain View, CA, USA", "long_description": "SlidePay, formerly Cube, is an API that makes it easy for any app to accept credit cards that are processed in person. Integration takes hours, not weeks, and works on any platform or device.", "one_liner": "Banking and Payment Platform APIs. Exited October 2014.", "team_size": 2, "industry": "Fintech", "subindustry": "Fintech -> Payments", "launched_at": 1322045681, "tags": "[\"Fintech\", \"Payments\", \"API\"]", "tags_highlighted": "[]", "top_company": 0, "isHiring": 0, "nonprofit": 0, "batch": "Winter 2012", "status": "Acquired", "industries": "[\"Fintech\", \"Payments\"]", "regions": "[\"United States of America\", \"America / Canada\"]", "stage": "Early", "app_video_public": 0, "demo_day_video_public": 0, "app_answers": null, "question_answers": 0, "url": "https://www.ycombinator.com/companies/slidepay", "api": "https://yc-oss.github.io/api/batches/winter-2012/slidepay.json", "founders_summary": "The founding team information for SlidePay is not readily available in the provided data or through initial searches. The company was formerly known as Cube and was acquired in October 2014.", "founders_sources": "[\"https://angel.co/slidepay\"]", "founders_raw": "{\"founders_summary\": \"The founding team information for SlidePay is not readily available in the provided data or through initial searches. The company was formerly known as Cube and was acquired in October 2014.\", \"sources\": [\"https://angel.co/slidepay\"], \"confidence\": \"low\", \"notes\": \"The provided JSON data does not contain founder information. Searches for \\\"SlidePay founders\\\" or \\\"Cube startup founders\\\" did not yield specific names.\"}", "product_summary": "SlidePay, previously known as Cube, offered an API designed to simplify in-person credit card processing for applications. The integration was intended to be quick, taking hours rather than weeks, and compatible with various platforms and devices. The company was acquired in October 2014.", "product_sources": "[\"https://angel.co/slidepay\"]", "product_vertical": "Fintech", "product_vertical_sources": ["https://angel.co/slidepay"], "product_vertical_notes": "The company's description and industry tags clearly indicate it operates within the Fintech sector, specifically in payments."}
{"id": 21, "name": "Tap to Learn", "slug": "tap-to-learn", "former_names": "[]", "small_logo_thumb_url": "/company/thumb/missing.png", "website": "http://taptolearn.com", "all_locations": "Menlo Park, CA, USA", "long_description": "When we began our first experiments with using Mobile devices a few years ago we were very excited by the possibility of learning in nontraditional manner. The beauty of effectiveness of the iPhone first and the iPad platforms gave shape to our vision of building beautiful apps, designed to build learning for your iPhone, iPod touch and iPad Devices. Each of our apps are extremely easy to use, focus on just one area of learning using interactivity and add an element to fun while learning.", "one_liner": "Games For Education", "team_size": 11, "industry": "Consumer", "subindustry": "Consumer -> Gaming", "launched_at": 1322045690, "tags": "[\"Education\", \"Gaming\"]", "tags_highlighted": "[]", "top_company": 0, "isHiring": 0, "nonprofit": 0, "batch": "Winter 2012", "status": "Inactive", "industries": "[\"Consumer\", \"Gaming\"]", "regions": "[\"United States of America\", \"America / Canada\"]", "stage": "Early", "app_video_public": 0, "demo_day_video_public": 0, "app_answers": null, "question_answers": 0, "url": "https://www.ycombinator.com/companies/tap-to-learn", "api": "https://yc-oss.github.io/api/batches/winter-2012/tap-to-learn.json", "founders_summary": "Tap to Learn's product is \"Games For Education\". Their largest investor could not be determined.", "founders_sources": "[]", "founders_raw": null, "product_summary": "Tap to Learn develops educational games for iOS devices, focusing on interactive and fun learning experiences. Their apps are designed for iPhone, iPod touch, and iPad, aiming to provide learning in non-traditional ways. The company's one-liner is \"Games For Education\".", "product_sources": "[\"https://www.ycombinator.com/companies/tap-to-learn\"]", "product_vertical": "Edtech", "product_vertical_sources": ["https://www.ycombinator.com/companies/tap-to-learn"], "product_vertical_notes": "The company's product summary and one-liner clearly indicate a focus on educational games for mobile devices, fitting the Edtech vertical."}
{"id": 15, "name": "Amiato", "slug": "amiato", "former_names": "[\"Nou Data\"]", "small_logo_thumb_url": "/company/thumb/missing.png", "website": "http://noudata.com", "all_locations": "Palo Alto, CA, USA", "long_description": "Amiato's real-time integration service moves your data to where it's\nmost valuable to you. Today's flexible databases like MongoDB and\nCouchBase let agile businesses accelerate and scale their operations,\nbut analyzing their data has been elusive. Amiato unlocks the value of\nthat unstructured data by bridging the gap to familiar tools in the\nrich structured world of BI, all with zero setup work. Run reports, do\ninteractive ad-hoc analysis, and combine disparate silos. Our\nSchema-lift (TM) technology allows you to immediately integrate new\nendpoints and seamlessly keep up with changes in your data. We get\ncustomers up and running in a day instead of weeks, and let them focus\non business instead of wrestling infrastructure.", "one_liner": "The BI bridge for unstructured data. We automatically bridge the gap…", "team_size": 2, "industry": "B2B", "subindustry": "B2B -> Infrastructure", "launched_at": 1322045630, "tags": "[\"Analytics\", \"Big Data\"]", "tags_highlighted": "[]", "top_company": 0, "isHiring": 0, "nonprofit": 0, "batch": "Winter 2012", "status": "Acquired", "industries": "[\"B2B\", \"Infrastructure\"]", "regions": "[\"United States of America\", \"America / Canada\"]", "stage": "Early", "app_video_public": 0, "demo_day_video_public": 0, "app_answers": null, "question_answers": 0, "url": "https://www.ycombinator.com/companies/amiato", "api": "https://yc-oss.github.io/api/batches/winter-2012/amiato.json", "founders_summary": "Amiato was founded by two individuals, though their names are not readily available in the provided information. The company was part of the Winter 2012 Y Combinator batch.", "founders_sources": "[\"https://yc-oss.github.io/api/batches/winter-2012/amiato.json\"]", "founders_raw": "{\"founders_summary\": \"Amiato was founded by two individuals, though their names are not readily available in the provided information. The company was part of the Winter 2012 Y Combinator batch.\", \"sources\": [\"https://yc-oss.github.io/api/batches/winter-2012/amiato.json\"], \"confidence\": \"low\", \"notes\": \"The provided JSON data indicates a team size of 2 but does not name the founders. The Y Combinator API link also does not contain founder names.\"}", "product_summary": "Amiato provides a real-time data integration service designed to move data from flexible databases like MongoDB and CouchBase to structured environments for business intelligence (BI) tools. Their technology, Schema-lift™, aims to bridge the gap between unstructured data and familiar BI tools, enabling users to run reports, perform ad-hoc analysis, and consolidate data from disparate sources with minimal setup. The service is designed to get customers operational within a day, allowing them to focus on business insights rather than infrastructure management. Amiato was formerly known as Nou Data and was part of the Winter 2012 Y Combinator batch. The company was acquired.", "product_sources": "[\"https://yc-oss.github.io/api/batches/winter-2012/amiato.json\"]", "product_vertical": "Data Integration & Business Intelligence", "product_vertical_sources": ["https://vertexaisearch.cloud.google.com/grounding-api-redirect/AUZIYQE6DNGzVaB9FIz0bYcv3HkMCVJS7JiaK5PJY0sdbWBFKFaRhmmmrGyJ3BbGS0uY_WZjz77mSIa-fGPwZHqOMIC89ojhjjC3I593DCLN5sV8MvGYzaYnPBeeWDu9MJa0fiA=", "https://vertexaisearch.cloud.google.com/grounding-api-redirect/AUZIYQEG3lZI6ayXC2QYbpg05d6SfhmJloQNtNLGmeQCsoYYcerHmBtELEVwZUrTmL83bOy699_2QHzrciA9EV0JM0_ZA0Ti7R7HGUsX5LRVSx8ikHOrpHm2yM52LNlEfl4cmNBaTvXBaLjK", "https://vertexaisearch.cloud.google.com/grounding-api-redirect/AUZIYQEn3wEs1eA3p14Kipt_Ma2oGILi1xv4HoY7ntZK8c268a1bkuVlGYbjR_qnD3lPOCMpGBd8cfQ89pUttQE7w3WNyKB75QqrgVrLrsQc6_A1erOYEgI9j5g8cIDCj-VLaTQZwrEfn0Ow7QUV", "https://vertexaisearch.cloud.google.com/grounding-api-redirect/AUZIYQFAygY_kHsHpXlh0cYO-7u77Mmuep3thjGLdWd4pK1D8rI-YxXxx5vmrii1MNxHZEDn4-FF0BcEn-3AfBetftZYJ4M2uoNFb2XitpXPKET5Jayj9BaR95n1RwjIfzJWJbSNZFlh_w_kbQzU420F7IphDg2mgI9wyAqU2K-NMvnGVg=", "https://vertexaisearch.cloud.google.com/grounding-api-redirect/AUZIYQFYQ0NPFf0QBzUrItDHTRE1GqzsFZAs2SJeRMnoFHLrIItMm12AvJ2XEnvcqwtKbQt8SQevMUWOuxIgFqV0XzQFjaXOKN38a01sjyChYTLBhapw06b49IEKxAhJ16f9FuNlrwvwrBnd27RwHbwwrIS5P0WVAFJagYPrZP0="], "product_vertical_notes": ""}
{"id": 16, "name": "Medigram", "slug": "medigram", "former_names": "[]", "small_logo_thumb_url": "/company/thumb/missing.png", "website": "http://medigram.com", "all_locations": "Los Gatos, CA, USA", "long_description": "Have you ever wondered why it's so hard for physicians to communicate quickly and why the leading cause of preventable death is still a delay in communication? Our team has built the solution for this. Medigram is a team of tier 1 health system CxO IT executives, technologists, SaaS exec, physicians, engineers, and data experts. We have developed a breakthrough service for the medical industry to save lives and for hospitals to make millions per year. Medigram instantly flags insights from clinician chats for immediate insight into hospital operations and patient care. This reduces critical response times by 50%. We've designed this system to provide instant, reliable messaging (including images and audio files) across very complicated network environments in hospitals. Medigram is secure, designed for HIPAA, and a full stack system which includes database back end, middleware, logic, and client apps for iOS, Android, desktop, and the web.\n\nOur solution to this is Mobile Intelligence For Healthcare by providing a secure, intelligent workflow management platform for the patient care ecosystem and medical professionals. Within the healthcare environment, you have physicians, the patient care team, EMR, workflow, data, and administration which needs to be tied together with intelligence through Medigram.", "one_liner": "We are making a HIPAA-compliant, Groupme app for doctors to…", "team_size": 11, "industry": "Healthcare", "subindustry": "Healthcare -> Healthcare IT", "launched_at": 1322045643, "tags": "[\"Messaging\", \"Healthcare\"]", "tags_highlighted": "[]", "top_company": 0, "isHiring": 0, "nonprofit": 0, "batch": "Winter 2012", "status": "Active", "industries": "[\"Healthcare\", \"Healthcare IT\"]", "regions": "[\"United States of America\", \"America / Canada\"]", "stage": "Early", "app_video_public": 0, "demo_day_video_public": 0, "app_answers": null, "question_answers": 0, "url": "https://www.ycombinator.com/companies/medigram", "api": "https://yc-oss.github.io/api/batches/winter-2012/medigram.json", "founders_summary": "Medigram was founded by Michael Chiu (Founder/CEO), Yuhao Ding (Founder/CTO), and Stephen Oakley (Founder).", "founders_sources": "[\"https://vertexaisearch.cloud.google.com/grounding-api-redirect/AUZIYQF0FH9V1HK75VX8W6Zb_dQ1v5TPC-tQDo37TIL1QT3gjLltRhE-x3b0kKyxbpKpljYqDb_zquK7X9CYn__6fOoq_a7Ay1V3NiTb38F73paMxkzi8eZOKDAVOH47_3WGl_GIA2lwm8sta6Q=\"]", "founders_raw": null, "product_summary": "Medigram offers a HIPAA-compliant, secure messaging and workflow management platform designed for the healthcare industry. It aims to improve communication among physicians and patient care teams, providing instant insights into hospital operations and patient care by flagging information from clinician chats. The system supports instant, reliable messaging, including images and audio files, across complex hospital network environments and integrates with EMRs and administrative systems. Medigram provides client applications for iOS, Android, desktop, and web, along with a full-stack system including a database backend, middleware, and logic. The platform is designed to reduce critical response times by 50% and help hospitals improve efficiency and patient care.", "product_sources": "[\"https://yc-oss.github.io/api/batches/winter-2012/medigram.json\"]", "product_vertical": "HealthTech", "product_vertical_sources": ["https://vertexaisearch.cloud.google.com/grounding-api-redirect/AUZIYQGeIPaxAJM-LY4yabkJ8n9RncKkBhxNFyGqkPbECq0S4NyChC_LyVnvOzRvxGZUXqcDbiNc7eaL2mszniYPu1yQOR8-bbabPtwTK1-Fe-C_U_WytmWwEnvyLrOrkDSLMb2M7aHy-OZ6ocOKmzNV7oICC_hmgHyR-aPqp2Mt3LvPt7twktg6RjnZXYRupQqxQwE=", "https://vertexaisearch.cloud.google.com/grounding-api-redirect/AUZIYQFrKSg9gePpXZ__OV618FK8Wv12Syx0KKkpCqhcryUl5l1SltpxsziXMh_ErhIPYgBWHfh_rb3QJ3-8SoD3ysD4adafnQi52X_-bzdTO1YhUHHHesE=", "https://vertexaisearch.cloud.google.com/grounding-api-redirect/AUZIYQEAH-6AJcEnOoXHSI2wcH6H-UIF4Yt2jXBVYcrDBZXI9Tzmf1IWFy6cLfVJ-IaXCw9eqo2KONARz9LaVuvtL_4zmtektfi-ZEyUVh4nnxo9h8ysGH_hKNaWdDYGmwnpXsIK0qgBx1zqmFmZ=", "https://vertexaisearch.cloud.google.com/grounding-api-redirect/AUZIYQGZHFsvOPmg2wvO1avA9NvbEx5wYwk0K8zE558C2VCOy4DMhQ87h7Ze2UrDtm2F-0qOJczcesI5W8T4P7wswM-LvcCSDkJ6fenLlxapyQYs5DnJ2A="], "product_vertical_notes": ""}
