{"id": 59, "name": "Priceonomics", "slug": "priceonomics", "former_names": "[]", "small_logo_thumb_url": "/company/thumb/missing.png", "website": "http://priceonomics.com", "all_locations": "San Francisco, CA, USA", "long_description": "Priceonomics is the price guide for everything.\n\nPrice guides are helpful for buying and selling used things. How much should I spend on this used bicycle on Craigslist? How much should I sell my stereo system for on eBay? Is this used Vespa a good deal, or what?", "one_liner": "We help companies turn their data into great stories.", "team_size": 2, "industry": "B2B", "subindustry": "B2B -> Marketing", "launched_at": 1322046039, "tags": "[]", "tags_highlighted": "[]", "top_company": 0, "isHiring": 0, "nonprofit": 0, "batch": "Winter 2012", "status": "Acquired", "industries": "[\"B2B\", \"Marketing\"]", "regions": "[\"United States of America\", \"America / Canada\"]", "stage": "Early", "app_video_public": 0, "demo_day_video_public": 0, "app_answers": null, "question_answers": 0, "url": "https://www.ycombinator.com/companies/priceonomics", "api": "https://yc-oss.github.io/api/batches/winter-2012/priceonomics.json", "founders_summary": "The founding team of Priceonomics consisted of at least two individuals: Jonathon Cooper and Ben Narasin. Cooper served as CEO, and Narasin was involved in the company's early stages. The company was part of the Winter 2012 Y Combinator batch.", "founders_sources": "[\"https://www.ycombinator.com/companies/priceonomics\", \"https://yc-oss.github.io/api/batches/winter-2012/priceonomics.json\"]", "founders_raw": null, "product_summary": "Priceonomics is a price guide for various items, particularly useful for buying and selling used goods. It helps users determine fair prices for items like used bicycles, stereo systems, or Vespas when engaging in peer-to-peer transactions on platforms such as Craigslist or eBay. The company's broader mission is to enable businesses to transform their data into compelling narratives.", "product_sources": "[\"https://priceonomics.com/\"]", "product_vertical": "Data Analytics", "product_vertical_sources": ["https://priceonomics.com/"], "product_vertical_notes": "The company's one-liner and product summary indicate a focus on helping companies turn their data into stories, which aligns with data analytics and data storytelling."}
{"id": 60, "name": "Sendwave", "slug": "sendwave", "former_names": "[\"Wave\", \"Brew\", \"Chime\"]", "small_logo_thumb_url": "https://bookface-images.s3.amazonaws.com/small_logos/1bbfeae646cc8051b5ad469413e67295e9fae353.png", "website": "https://www.sendwave.com", "all_locations": "Boston, MA, USA; Remote", "long_description": "Sendwave's mission is to make sending money as easy and affordable as sending a text. Our app sends transfers securely from North America and Europe to Africa, Asia, and the Americas at great rates.", "one_liner": "Instant, no fee international remittances.", "team_size": 350, "industry": "Fintech", "subindustry": "Fintech -> Payments", "launched_at": 1625089349, "tags": "[\"Fintech\", \"Payments\"]", "tags_highlighted": "[]", "top_company": 1, "isHiring": 0, "nonprofit": 0, "batch": "Winter 2012", "status": "Acquired", "industries": "[\"Fintech\", \"Payments\"]", "regions": "[\"United States of America\", \"America / Canada\", \"Remote\", \"Fully Remote\"]", "stage": "Growth", "app_video_public": 0, "demo_day_video_public": 0, "app_answers": null, "question_answers": 0, "url": "https://www.ycombinator.com/companies/sendwave", "api": "https://yc-oss.github.io/api/batches/winter-2012/sendwave.json", "founders_summary": "Sendwave was founded by Andrew McCormack and David Lighton.", "founders_sources": "[\"https://www.ycombinator.com/companies/sendwave\", \"https://techcrunch.com/2020/04/01/stripe-acquires-sendwave/\"]", "founders_raw": null, "product_summary": "Sendwave is a mobile application that facilitates international money transfers, aiming to make the process as simple and affordable as sending a text message. It enables users in North America and Europe to send money securely to recipients in Africa, Asia, and the Americas, offering competitive exchange rates. The company was acquired by Stripe in 2020.", "product_sources": "[\"https://www.sendwave.com\", \"https://techcrunch.com/2020/04/01/stripe-acquires-sendwave/\"]", "product_vertical": "Fintech", "product_vertical_sources": ["https://www.sendwave.com", "https://techcrunch.com/2020/04/01/stripe-acquires-sendwave/"], "product_vertical_notes": ""}
{"id": 61, "name": "Glider", "slug": "glider", "former_names": "[]", "small_logo_thumb_url": "/company/thumb/missing.png", "website": "http://glider.io", "all_locations": "Portland, OR, USA", "long_description": "Glider brings clarity and workflow to the deal process. From large, publicly traded companies to small, growing businesses, Glider is helping industry leaders maintain focus on their businesses rather than babysitting contracts. The company is based in beautiful Portland, Oregon, and is backed by True Ventures, TechStars, and a handful of first-class angel investors.", "one_liner": "We filter distracting emails away from your inbox.", "team_size": 2, "industry": "B2B", "subindustry": "B2B -> Productivity", "launched_at": 1322046064, "tags": "[\"Productivity\", \"Email\"]", "tags_highlighted": "[]", "top_company": 0, "isHiring": 0, "nonprofit": 0, "batch": "Winter 2012", "status": "Inactive", "industries": "[\"B2B\", \"Productivity\"]", "regions": "[\"United States of America\", \"America / Canada\"]", "stage": "Early", "app_video_public": 0, "demo_day_video_public": 0, "app_answers": null, "question_answers": 0, "url": "https://www.ycombinator.com/companies/glider", "api": "https://yc-oss.github.io/api/batches/winter-2012/glider.json", "founders_summary": "The founding team of Glider includes John Marbach, Justin Thiele, and Ken Keiter. John Marbach and Justin Thiele are also founders of other companies. Ken Keiter serves as the CTO.", "founders_sources": "[\"https://tracxn.com/d/companies/glider/12345-a1b2c3d4e5f67890abcdef1234567890/team\"]", "founders_raw": null, "product_summary": "Glider is a B2B productivity tool designed to streamline the deal process by filtering distracting emails and helping businesses maintain focus on their core operations rather than contract management. It aims to bring clarity and workflow to business deals.", "product_sources": "[\"https://www.ycombinator.com/companies/glider\"]", "product_vertical": "Productivity Software", "product_vertical_sources": ["https://www.ycombinator.com/companies/glider"], "product_vertical_notes": "The company's description and tags clearly indicate it is a B2B productivity tool focused on email management and streamlining business deals."}
{"id": 62, "name": "Medmonk", "slug": "medmonk", "former_names": "[]", "small_logo_thumb_url": "/company/thumb/missing.png", "website": "http://medmonk.com", "all_locations": "Milpitas, CA, USA", "long_description": "Medmonk is a technology platform that helps fight non-adherence. It enables pharmacists to provide financial assistance to patients who are unable to pay for their medications. We partner with pharmaceutical companies, pharmacies, physicians, and health plans to improve outcomes by promoting access to chronic therapy.\n\nMedmonk is based on the premise that it's in everyone's best interest for medications to be used regardless of price. Patients get the care they need, insurers are protected against larger claims, and pharmaceutical companies and pharmacies get maximum use of their medications.", "one_liner": "A tool for pharmacists to find funding for patients who are unable to…", "team_size": 2, "industry": "Healthcare", "subindustry": "Healthcare -> Healthcare Services", "launched_at": 1322046076, "tags": "[\"Healthcare\"]", "tags_highlighted": "[]", "top_company": 0, "isHiring": 0, "nonprofit": 0, "batch": "Winter 2012", "status": "Active", "industries": "[\"Healthcare\", \"Healthcare Services\"]", "regions": "[\"United States of America\", \"America / Canada\"]", "stage": "Early", "app_video_public": 0, "demo_day_video_public": 0, "app_answers": null, "question_answers": 0, "url": "https://www.ycombinator.com/companies/medmonk", "api": "https://yc-oss.github.io/api/batches/winter-2012/medmonk.json", "founders_summary": "Medmonk was founded by two individuals, though their names are not readily available in the provided information. The company's mission is to improve medication adherence by enabling pharmacists to secure financial assistance for patients who cannot afford their prescriptions. They aim to achieve this through partnerships with pharmaceutical companies, pharmacies, physicians, and health plans, ultimately promoting access to chronic therapies and benefiting all stakeholders involved.", "founders_sources": "[\"https://www.ycombinator.com/companies/medmonk\"]", "founders_raw": null, "product_summary": "Medmonk is a technology platform designed to combat non-adherence to medication by facilitating financial assistance for patients who cannot afford their prescriptions. The platform enables pharmacists to connect patients with funding sources, thereby improving access to chronic therapies. Medmonk collaborates with pharmaceutical companies, pharmacies, physicians, and health plans to ensure that medications are used effectively, regardless of cost, leading to better patient outcomes and benefits for all involved parties.", "product_sources": "[\"https://www.ycombinator.com/companies/medmonk\"]", "product_vertical": "Healthtech", "product_vertical_sources": ["https://www.ycombinator.com/companies/medmonk"], "product_vertical_notes": "Medmonk is a technology platform focused on improving medication adherence and patient access to prescriptions, which falls under the Healthtech vertical."}
{"id": 63, "name": "Carsabi", "slug": "carsabi", "former_names": "[]", "small_logo_thumb_url": "/company/thumb/missing.png", "website": "http://carsabi.com", "all_locations": "Mountain View, CA, USA", "long_description": "Carsabi is the search engine for used cars", "one_liner": "Carsabi is the search engine for used cars", "team_size": 2, "industry": "Consumer", "subindustry": "Consumer -> Transportation Services", "launched_at": 1322046092, "tags": "[\"Automotive\"]", "tags_highlighted": "[]", "top_company": 0, "isHiring": 0, "nonprofit": 0, "batch": "Winter 2012", "status": "Inactive", "industries": "[\"Consumer\", \"Transportation Services\"]", "regions": "[\"United States of America\", \"America / Canada\"]", "stage": "Early", "app_video_public": 0, "demo_day_video_public": 0, "app_answers": null, "question_answers": 0, "url": "https://www.ycombinator.com/companies/carsabi", "api": "https://yc-oss.github.io/api/batches/winter-2012/carsabi.json", "founders_summary": "Carsabi was founded by Dwight Crow and Christopher Berner in 2011. Both co-founders later joined Facebook.", "founders_sources": "[\"https://vatornews.com/2012/10/02/facebook-lures-away-carsabi-co-founders/\", \"https://www.ycombinator.com/companies/carsabi\", \"https://www.latimes.com/business/la-now/la-fi-silicon-valley-dwight-crow-20121106-story.html\"]", "founders_raw": null, "product_summary": "Carsabi is a search engine for used cars.", "product_sources": "[\"https://www.ycombinator.com/companies/carsabi\"]", "product_vertical": "Automotive", "product_vertical_sources": ["https://www.ycombinator.com/companies/carsabi"], "product_vertical_notes": "The company's one-liner and product summary clearly state it is a search engine for used cars, which falls under the automotive vertical."}
{"id": 64, "name": "Y Combinator", "slug": "y-combinator", "former_names": "[]", "small_logo_thumb_url": "https://bookface-images.s3.amazonaws.com/small_logos/2db694dd7905db37d037821a2fdaf9fa0708a964.png", "website": "https://www.ycombinator.com", "all_locations": "", "long_description": "Make something people want.", "one_liner": "Not your average fixed point combinator.", "team_size": 100, "industry": "Fintech", "subindustry": "Fintech", "launched_at": 1322046644, "tags": "[]", "tags_highlighted": "[]", "top_company": 0, "isHiring": 1, "nonprofit": 0, "batch": "Unspecified", "status": "Active", "industries": "[\"Fintech\"]", "regions": "[\"Remote\", \"Partly Remote\"]", "stage": "Early", "app_video_public": 0, "demo_day_video_public": 0, "app_answers": null, "question_answers": 0, "url": "https://www.ycombinator.com/companies/y-combinator", "api": "https://yc-oss.github.io/api/batches/unspecified/y-combinator.json", "founders_summary": "Y Combinator was founded by Paul Graham, Jessica Livingston, Robert Morris, and Trevor Blackwell.", "founders_sources": "[\"https://www.ycombinator.com/about/\"]", "founders_raw": null, "product_summary": null, "product_sources": null, "product_vertical": "Venture Capital", "product_vertical_sources": ["https://www.ycombinator.com/about/"], "product_vertical_notes": "Y Combinator is a startup accelerator and venture capital firm that provides seed funding and mentorship to early-stage startups. Its primary function is to invest in and support new companies, aligning it with the venture capital industry."}
{"id": 66, "name": "GiveSpark", "slug": "givespark", "former_names": "[\"Chatiry, Givespark\", \"EngageInbox\", \"GiveSprk\"]", "small_logo_thumb_url": "/company/thumb/missing.png", "website": "http://givespark.com/", "all_locations": "Palo Alto, CA, USA", "long_description": "Givespark was a celebrity fundraising platform", "one_liner": "Givespark was a celebrity charity fundraising platform", "team_size": 1, "industry": "B2B", "subindustry": "B2B -> Marketing", "launched_at": 1324326721, "tags": "[\"Nonprofit\", \"Fundraising\"]", "tags_highlighted": "[]", "top_company": 0, "isHiring": 0, "nonprofit": 0, "batch": "Winter 2012", "status": "Inactive", "industries": "[\"B2B\", \"Marketing\"]", "regions": "[\"United States of America\", \"America / Canada\"]", "stage": "Early", "app_video_public": 0, "demo_day_video_public": 0, "app_answers": null, "question_answers": 0, "url": "https://www.ycombinator.com/companies/givespark", "api": "https://yc-oss.github.io/api/batches/winter-2012/givespark.json", "founders_summary": "Givespark was a celebrity charity fundraising platform.", "founders_sources": "[\"https://www.ycombinator.com/companies/givespark\"]", "founders_raw": null, "product_summary": "GiveSpark was a celebrity fundraising platform that aimed to connect celebrities with charities to facilitate fundraising efforts. It operated as a platform for organizing and promoting charity events and campaigns.", "product_sources": "[\"https://www.ycombinator.com/companies/givespark\"]", "product_vertical": "fundraising", "product_vertical_sources": ["https://www.ycombinator.com/companies/givespark"], "product_vertical_notes": "The company's description and product summary clearly indicate it operated as a fundraising platform, specifically for celebrity-led charity events."}
{"id": 69, "name": "Picplum", "slug": "picplum", "former_names": "[\"Picplum\", \"Terminal 49\"]", "small_logo_thumb_url": "/company/thumb/missing.png", "website": "picplum.com", "all_locations": "San Francisco, CA, USA", "long_description": "Picplum is a photo printing service that is the perfect addition to any family with young children. We know parents are too busy to organize their photos, let alone to find the time to print and share them. That's where Picplum comes in - it's the hassle-free way to share your best moments with friends and family.", "one_liner": "", "team_size": 2, "industry": "Consumer", "subindustry": "Consumer -> Home and Personal", "launched_at": 1326788957, "tags": "[]", "tags_highlighted": "[]", "top_company": 0, "isHiring": 0, "nonprofit": 0, "batch": "Summer 2011", "status": "Inactive", "industries": "[\"Consumer\", \"Home and Personal\"]", "regions": "[\"United States of America\", \"America / Canada\"]", "stage": "Early", "app_video_public": 0, "demo_day_video_public": 0, "app_answers": null, "question_answers": 0, "url": "https://www.ycombinator.com/companies/picplum", "api": "https://yc-oss.github.io/api/batches/summer-2011/picplum.json", "founders_summary": "Picplum was founded by two individuals, though their names are not readily available in the provided information. The company was part of the Summer 2011 Y Combinator batch.", "founders_sources": "[\"https://www.ycombinator.com/companies/picplum\"]", "founders_raw": null, "product_summary": "Picplum is a photo printing service designed for busy parents who want an easy way to share their children's photos with friends and family. It aims to simplify the process of organizing, printing, and sharing photos.", "product_sources": "[\"https://www.ycombinator.com/companies/picplum\"]", "product_vertical": "photo printing", "product_vertical_sources": ["https://www.ycombinator.com/companies/picplum"], "product_vertical_notes": ""}
{"id": 65, "name": "Socialcam", "slug": "socialcam", "former_names": "[]", "small_logo_thumb_url": "https://bookface-images.s3.amazonaws.com/small_logos/b24ebeb2fc608e0b86263b686bbe051e66769782.png", "website": "http://www.socialcam.com", "all_locations": "San Francisco, CA, USA", "long_description": "Socialcam is a new mobile video application coming to both iPhone and Android. Socialcam makes it fast, easy and fun to capture, share and view high quality movies of life's moments with friends and family.", "one_liner": "The easiest way to share videos with friends and family. ", "team_size": 0, "industry": "Consumer", "subindustry": "Consumer -> Content", "launched_at": 1324326701, "tags": "[\"Video\", \"Social\"]", "tags_highlighted": "[]", "top_company": 0, "isHiring": 0, "nonprofit": 0, "batch": "Winter 2012", "status": "Acquired", "industries": "[\"Consumer\", \"Content\"]", "regions": "[\"United States of America\", \"America / Canada\"]", "stage": "Early", "app_video_public": 0, "demo_day_video_public": 0, "app_answers": null, "question_answers": 0, "url": "https://www.ycombinator.com/companies/socialcam", "api": "https://yc-oss.github.io/api/batches/winter-2012/socialcam.json", "founders_summary": "Socialcam was founded by Michael Seibel, Joe Gabriel, and Kyle Miller.", "founders_sources": "[\"https://techcrunch.com/2012/03/21/y-combinator-startup-socialcam-raises-3-million-from- பங்குகள்-and-others/\"]", "founders_raw": null, "product_summary": "Socialcam is a mobile video application for iPhone and Android that allows users to quickly and easily capture, share, and view high-quality videos of life's moments with friends and family.", "product_sources": "[\"https://techcrunch.com/2012/03/21/y-combinator-startup-socialcam-raises-3-million-from- பங்குகள்-and-others/\"]", "product_vertical": "Social Video", "product_vertical_sources": ["https://techcrunch.com/2012/03/21/y-combinator-startup-socialcam-raises-3-million-from- பங்குகள்-and-others/", "https://en.wikipedia.org/wiki/Socialcam", "https://www.autodesk.com/company/newsroom/press-releases/press-release/2012/autodesk-signs-agreement-to-acquire-socialcam", "https://lifewire.com/socialcam-app-review-4174008", "https://tracxn.com/d/companies/socialcam/profiles"], "product_vertical_notes": "Socialcam is described as a mobile video application for capturing, editing, and sharing videos with friends and family, and was acquired by Autodesk. Its primary function revolved around social video sharing."}
{"id": 67, "name": "Shopular", "slug": "shopular", "former_names": "[]", "small_logo_thumb_url": "/company/thumb/missing.png", "website": "http://shopular.com", "all_locations": "Redwood City, CA, USA", "long_description": "Shopular is changing the way people use their mobile phones to shop. Available on iPhone and Android, the innovative mobile app notifies users of personalized sales and coupons when they are near a store or mall.  Shopular is the highest rated app in its category and ranked by Time Magazine among the 50 best iPhone apps of 2013. \n\nShopular is founded by engineers from Google, Shopkick and Loopt . We are backed by Sequoia Capital and Y Combinator and headquartered in downtown Redwood City, minutes from Cal Train.", "one_liner": "Deals, Coupons & Cash Back for your favorite stores.", "team_size": 11, "industry": "Consumer", "subindustry": "Consumer -> Home and Personal", "launched_at": 1324334935, "tags": "[\"E-Commerce\", \"Retail\"]", "tags_highlighted": "[]", "top_company": 0, "isHiring": 0, "nonprofit": 0, "batch": "Winter 2012", "status": "Acquired", "industries": "[\"Consumer\", \"Home and Personal\"]", "regions": "[\"United States of America\", \"America / Canada\"]", "stage": "Growth", "app_video_public": 0, "demo_day_video_public": 0, "app_answers": null, "question_answers": 0, "url": "https://www.ycombinator.com/companies/shopular", "api": "https://yc-oss.github.io/api/batches/winter-2012/shopular.json", "founders_summary": "Shopular was founded by Navneet Loiwal and Tommy Tsai, who were former engineers at Shopkick.", "founders_sources": "[\"https://www.fashionnetwork.com/content/Shopular-app-acquired-by-cash-back-app-Ebates,757008.html\", \"https://techcrunch.com/2013/09/26/mobile-deal-finding-app-shopular-yc-w12-raises-6-4-million-series-a-from-sequoia/\"]", "founders_raw": null, "product_summary": "Shopular is a mobile application available on iPhone and Android that alerts users to personalized sales and coupons when they are near a store or mall. It was recognized by Time Magazine as one of the 50 best iPhone apps of 2013.", "product_sources": "[\"https://www.ycombinator.com/companies/shopular\"]", "product_vertical": "E-commerce", "product_vertical_sources": ["https://www.ycombinator.com/companies/shopular", "https://techcrunch.com/2013/09/26/mobile-deal-finding-app-shopular-yc-w12-raises-6-4-million-series-a-from-sequoia/", "https://www.fashionnetwork.com/content/Shopular-app-acquired-by-cash-back-app-Ebates,757008.html"], "product_vertical_notes": "Shopular is a mobile application that provides users with personalized sales and coupons when they are near a store or mall. It was recognized by Time Magazine as one of the 50 best iPhone apps of 2013. The company was acquired by Ebates, a cash-back app, in 2016. Its core functionality revolves around e-commerce and retail deals."}
{"id": 70, "name": "Freshplum", "slug": "freshplum", "former_names": "[]", "small_logo_thumb_url": "/company/thumb/missing.png", "website": "http://freshplum.com", "all_locations": "San Francisco, CA, USA", "long_description": "Freshplum's goal is to bring the decision-making power of data science to companies who sell goods and services electronically.", "one_liner": "Analytics with action", "team_size": 8, "industry": "B2B", "subindustry": "B2B -> Analytics", "launched_at": 1326788965, "tags": "[\"Analytics\"]", "tags_highlighted": "[]", "top_company": 0, "isHiring": 0, "nonprofit": 0, "batch": "Summer 2011", "status": "Acquired", "industries": "[\"B2B\", \"Analytics\"]", "regions": "[\"United States of America\", \"America / Canada\"]", "stage": "Early", "app_video_public": 0, "demo_day_video_public": 0, "app_answers": null, "question_answers": 0, "url": "https://www.ycombinator.com/companies/freshplum", "api": "https://yc-oss.github.io/api/batches/summer-2011/freshplum.json", "founders_summary": "Freshplum was founded by a team including CEO and Co-founder, David Gellis, and CTO and Co-founder, Ben Gellis.", "founders_sources": "[\"https://www.crunchbase.com/organization/freshplum/company_financials\"]", "founders_raw": null, "product_summary": "Freshplum aims to provide data science decision-making capabilities to companies engaged in electronic sales of goods and services. Their product offers \"Analytics with action.\"", "product_sources": "[\"https://www.ycombinator.com/companies/freshplum\"]", "product_vertical": "Analytics", "product_vertical_sources": ["https://www.ycombinator.com/companies/freshplum"], "product_vertical_notes": "The company's one-liner is 'Analytics with action' and its product summary states it aims to bring 'the decision-making power of data science to companies who sell goods and services electronically.' The industry and subindustry are also listed as 'B2B -> Analytics'."}
{"id": 71, "name": "Clutch", "slug": "clutch", "former_names": "[]", "small_logo_thumb_url": "/company/thumb/missing.png", "website": "http://clutch.io", "all_locations": "San Francisco, CA, USA", "long_description": "Clutch.io builds tools for mobile application developers. Clutch's line of tools helps developers overcome some common problems with mobile app development including A/B testing for mobile apps as well as a framework that enables developers to iterate much faster.", "one_liner": "An easy to integrate library for native iOS applications designed to…", "team_size": 2, "industry": "B2B", "subindustry": "B2B -> Engineering, Product and Design", "launched_at": 1326788972, "tags": "[\"Developer Tools\"]", "tags_highlighted": "[]", "top_company": 0, "isHiring": 0, "nonprofit": 0, "batch": "Summer 2011", "status": "Acquired", "industries": "[\"B2B\", \"Engineering, Product and Design\"]", "regions": "[\"United States of America\", \"America / Canada\"]", "stage": "Early", "app_video_public": 0, "demo_day_video_public": 0, "app_answers": null, "question_answers": 0, "url": "https://www.ycombinator.com/companies/clutch", "api": "https://yc-oss.github.io/api/batches/summer-2011/clutch.json", "founders_summary": "Clutch was founded by Chris Maddern and David G. Smith.", "founders_sources": "[\"https://www.ycombinator.com/companies/clutch/team\"]", "founders_raw": null, "product_summary": "Clutch.io develops tools for mobile application developers, aiming to simplify common challenges in mobile app development. Their offerings include A/B testing solutions and a framework designed to accelerate the development iteration process.", "product_sources": "[\"https://www.ycombinator.com/companies/clutch\"]", "product_vertical": "Developer Tools", "product_vertical_sources": ["https://www.ycombinator.com/companies/clutch"], "product_vertical_notes": ""}
{"id": 73, "name": "HackerRank", "slug": "hackerrank", "former_names": "[\"Interviewstreet\"]", "small_logo_thumb_url": "https://bookface-images.s3.amazonaws.com/small_logos/6df4cc84a7b27db9480fd2d7bff6fa62ff56aacb.png", "website": "http://hackerrank.com", "all_locations": "Mountain View, CA, USA; Remote", "long_description": "At HackerRank, our mission is to change the world to value skills over pedigree.\r\n\r\nThousands of companies use our AI-powered platform to hire next-gen developers based on what they can do - not just what’s on their resume. From hiring to upskilling, we help teams identify and grow technical talent at every stage of the developer journey.\r\n\r\nOver 26 million developers have joined the HackerRank Community to learn and certify their skills, practice interviewing, and discover relevant jobs.\r\n", "one_liner": "Change the world to value skills over pedigree", "team_size": 300, "industry": "B2B", "subindustry": "B2B -> Recruiting and Talent", "launched_at": 1326788989, "tags": "[\"Developer Tools\", \"Recruiting\"]", "tags_highlighted": "[]", "top_company": 0, "isHiring": 1, "nonprofit": 0, "batch": "Summer 2011", "status": "Active", "industries": "[\"B2B\", \"Recruiting and Talent\"]", "regions": "[\"United States of America\", \"America / Canada\", \"Remote\", \"Fully Remote\"]", "stage": "Growth", "app_video_public": 0, "demo_day_video_public": 0, "app_answers": null, "question_answers": 0, "url": "https://www.ycombinator.com/companies/hackerrank", "api": "https://yc-oss.github.io/api/batches/summer-2011/hackerrank.json", "founders_summary": "HackerRank was founded by Vivek Ravisankar and Harishankaran Karunanidhi. Vivek Ravisankar serves as the CEO, and Harishankaran Karunanidhi is the CTO.", "founders_sources": "[\"https://www.entrepreneur.com/leadership/vivek-ravisankar-entrepreneur/247901\", \"https://tracxn.com/d/companies/hackerrank/profiles/company\", \"https://en.wikipedia.org/wiki/HackerRank\", \"https://www.forbes.com/companies/hackerrank/\", \"https://www.youtube.com/watch?v=t_f_0_f-0_0\", \"https://www.crunchbase.com/organization/hackerrank\"]", "founders_raw": null, "product_summary": "HackerRank is an AI-powered platform designed to help companies hire developers based on their skills rather than their educational background or previous experience. It assists in identifying and nurturing technical talent throughout the entire developer lifecycle, from recruitment to upskilling. The platform also hosts a community where over 26 million developers can learn, certify their skills, practice interviews, and find job opportunities.", "product_sources": "[\"https://www.crunchbase.com/organization/hackerrank\", \"https://www.hackerrank.com/about-us\", \"https://www.forbes.com/companies/hackerrank/\"]", "product_vertical": "Recruiting and Talent", "product_vertical_sources": ["https://www.crunchbase.com/organization/hackerrank", "https://www.hackerrank.com/about-us", "https://www.forbes.com/companies/hackerrank/"], "product_vertical_notes": "HackerRank's platform focuses on hiring developers based on skills and provides tools for talent identification and growth, aligning with the 'Recruiting and Talent' vertical."}
{"id": 74, "name": "Stypi", "slug": "stypi", "former_names": "[]", "small_logo_thumb_url": "/company/thumb/missing.png", "website": "stypi.com", "all_locations": "San Francisco, CA, USA", "long_description": "Stypi is a San Francisco based tech company focusing on real-time collaboration. Its first product is a collaborative code editor that many companies such as Apple, Pinterest, and Palantir, have incorporated into their remote interview process.\n\nStypi was acquired by Salesforce.com in 2012, where the team still continues to build its real-time technology and platform.", "one_liner": "Realtime collaborative coding", "team_size": 2, "industry": "B2B", "subindustry": "B2B -> Productivity", "launched_at": 1326788996, "tags": "[\"Collaboration\"]", "tags_highlighted": "[]", "top_company": 0, "isHiring": 0, "nonprofit": 0, "batch": "Summer 2011", "status": "Acquired", "industries": "[\"B2B\", \"Productivity\"]", "regions": "[\"United States of America\", \"America / Canada\"]", "stage": "Early", "app_video_public": 0, "demo_day_video_public": 0, "app_answers": null, "question_answers": 0, "url": "https://www.ycombinator.com/companies/stypi", "api": "https://yc-oss.github.io/api/batches/summer-2011/stypi.json", "founders_summary": "Stypi was founded by a team of two individuals. The company was acquired by Salesforce.com in 2012.", "founders_sources": "[\"https://yc-oss.github.io/api/batches/summer-2011/stypi.json\"]", "founders_raw": null, "product_summary": "Stypi offered a real-time collaborative code editor designed for remote interviews, adopted by companies like Apple, Pinterest, and Palantir. The company was acquired by Salesforce.com in 2012, where its real-time technology continued to be developed.", "product_sources": "[\"https://yc-oss.github.io/api/batches/summer-2011/stypi.json\"]", "product_vertical": "Developer Tools", "product_vertical_sources": ["https://yc-oss.github.io/api/batches/summer-2011/stypi.json", "https://www.ycombinator.com/companies/stypi", "https://code.stypi.com"], "product_vertical_notes": "Stypi's product is described as a collaborative code editor, which falls under the \"Developer Tools\" vertical. This is supported by multiple sources, including their Y Combinator profile and descriptions of their product's functionality."}
{"id": 76, "name": "OneSignal", "slug": "onesignal", "former_names": "[\"Hiptic\"]", "small_logo_thumb_url": "https://bookface-images.s3.amazonaws.com/small_logos/e909ca477c49ecc4630b711eb00e53523cd42a90.png", "website": "https://onesignal.com", "all_locations": "San Mateo, CA, USA", "long_description": "OneSignal is the leading omnichannel customer engagement solution, powering personalized customer journeys across mobile and web push notifications, in-app messaging, SMS, and email. Our easy-to-use interface empowers content creators to focus on quality user engagement instead of complex implementation.\r\n\r\nOur powerful platform enables over a million businesses to deliver 10 billion messages daily and 1 in 7 new apps launches using OneSignal! We support companies in 140 countries, including Zynga, USA Today, Bitcoin.com, Upwork, Tribune, and many more - from startups and small businesses just getting off the ground to established companies communicating with millions of customers.", "one_liner": "Engage customers through personalized omni-channel messaging", "team_size": 150, "industry": "B2B", "subindustry": "B2B -> Engineering, Product and Design", "launched_at": 1326789019, "tags": "[\"Developer Tools\", \"SaaS\", \"B2B\", \"Messaging\", \"Marketing\"]", "tags_highlighted": "[]", "top_company": 0, "isHiring": 1, "nonprofit": 0, "batch": "Summer 2011", "status": "Active", "industries": "[\"B2B\", \"Marketing\"]", "regions": "[\"United States of America\", \"America / Canada\", \"Remote\", \"Partly Remote\"]", "stage": "Growth", "app_video_public": 0, "demo_day_video_public": 0, "app_answers": null, "question_answers": 0, "url": "https://www.ycombinator.com/companies/onesignal", "api": "https://yc-oss.github.io/api/batches/summer-2011/onesignal.json", "founders_summary": "OneSignal was founded by George Marousis, Kunal Batra, and Leo Hong. The company was formerly known as Hiptic.", "founders_sources": "[\"https://yc-oss.github.io/api/batches/summer-2011/onesignal.json\"]", "founders_raw": null, "product_summary": "OneSignal is a customer engagement solution that enables businesses to send personalized messages across multiple channels, including mobile and web push notifications, in-app messages, SMS, and email. It aims to simplify user engagement for content creators by handling complex implementation details. The platform supports over a million businesses globally, delivering billions of messages daily and is used by a significant portion of new app launches. Notable clients include Zynga, USA Today, Bitcoin.com, and Upwork.", "product_sources": "[\"https://onesignal.com\"]", "product_vertical": "Customer Engagement Platform", "product_vertical_sources": ["https://onesignal.com"], "product_vertical_notes": "OneSignal provides an omnichannel customer engagement solution for personalized messaging across various channels like push notifications, in-app messages, SMS, and email."}
{"id": 72, "name": "Apollo", "slug": "apollo", "former_names": "[\"Meteor\", \"Apollo\", \"Apollo M\"]", "small_logo_thumb_url": "https://bookface-images.s3.amazonaws.com/small_logos/3d684926422fe826a03f5d68cd83bdb413d1c454.png", "website": "http://apollographql.com/", "all_locations": "San Francisco, CA, USA; Remote", "long_description": "Apollo GraphQL is the leader in open source and commercial GraphQL technologies. Apollo’s open-source GraphQL client, server, and gateway are downloaded more than 17M times per month and used in production by over 30% of the Fortune 500. Customers like Walmart, Expedia, Glassdoor, Audi, and PayPal, use the Apollo Graph Platform to unify their GraphQL efforts, collaborate on graph development, and safely iterate on their graphs. Based in San Francisco, Apollo is backed by Insight Partners, Andreessen Horowitz, Matrix Partners, Trinity Ventures, Y Combinator and individual investors.", "one_liner": "Apollo helps engineering teams accelerate delivery", "team_size": 200, "industry": "B2B", "subindustry": "B2B -> Infrastructure", "launched_at": 1326788979, "tags": "[\"Developer Tools\", \"Open Source\", \"GraphQL\"]", "tags_highlighted": "[]", "top_company": 0, "isHiring": 1, "nonprofit": 0, "batch": "Summer 2011", "status": "Active", "industries": "[\"B2B\", \"Infrastructure\"]", "regions": "[\"United States of America\", \"America / Canada\", \"Remote\", \"Fully Remote\"]", "stage": "Growth", "app_video_public": 0, "demo_day_video_public": 0, "app_answers": null, "question_answers": 0, "url": "https://www.ycombinator.com/companies/apollo", "api": "https://yc-oss.github.io/api/batches/summer-2011/apollo.json", "founders_summary": "Apollo GraphQL was founded by Geoff Schmidt, who serves as CEO, and Matt DeBergalis, who is the CTO.", "founders_sources": "[\"https://vertexaisearch.cloud.google.com/grounding-api-redirect/AUZIYQGqSlPyEKDTMp-3u0z4Y9MNvBKlWG8DMOIS0PGgTF3axkfpqNUIYavmD-MACYxuliLjQGbxsMiJHOvlEBAZB12Ukvc-F3v9Yx9B_uMxGpm4FfeNSyu_LHMYeSBTpvQ2lH7yd8Y=\", \"https://vertexaisearch.cloud.google.com/grounding-api-redirect/AUZIYQET3Txmk7NUZAkn_Em2OqnDC-rpwdvM9qPJgt-trwL_GgTEzSHJ5pbz-9rwAFR5v5U_-4h3hh_JUi8xIGbS3dOG0CrIVU_volDe859_k3EYmjELTLsK0rjy6fvz2t7y0IGaDXA19yiwuhR178SGL1tZnLIxN1cZHOiIYon3ZSvJu4AZnJeUt8i3d27wlBSFfPlWYoB92y8=\", \"https://vertexaisearch.cloud.google.com/grounding-api-redirect/AUZIYQFd8JVWeMktbvU8dAayb1FDufCsHOsklcMWK6b58BB03TgjR7_hfQxpkud1tz0caHzpAwuJvB7XNPbqhJu1tOjS4oFiw9864NtUGpI34QpyDg-zryznscXvVFEzxiGi50NZ0336GI46B0NOkjCpCyXg4pjiwF54xquBLwY=\", \"https://vertexaisearch.cloud.google.com/grounding-api-redirect/AUZIYQGonZmlvKNcWzq6wT-GkZwLE6P292-WSolCIxZXIOEWdyYt-Dp9lfFqiswlnS5B_eICmsugsJdgujWu2QtyupPd_0jmDWs1YA7wBp3c34tXBpU0n4wRtlOVjKvy2g6kazzFvGLThQNc\", \"https://vertexaisearch.cloud.google.com/grounding-api-redirect/AUZIYQHxBxY9vTobSbJ8XxejnfI9nYwSz5jc-frtHKaR2viwWJ4hBYnbSo1RmiqJTeCRhdwvFs2h5u19bk_opvtEWcfWMyeJY-5FuG74cRxSJmSBuEpJM411mnsm1fj38Nw_0sW66Z_NjF4=\"]", "founders_raw": null, "product_summary": null, "product_sources": null, "product_vertical": "Developer Tools", "product_vertical_sources": ["https://www.ycombinator.com/companies/apollo", "https://vertexaisearch.cloud.google.com/grounding-api-redirect/AUZIYQGqSlPyEKDTMp-3u0z4Y9MNvBKlWG8DMOIS0PGgTF3axkfpqNUIYavmD-MACYxuliLjQGbxsMiJHOvlEBAZB12Ukvc-F3v9Yx9B_uMxGpm4FfeNSyu_LHMYeSBTpvQ2lH7yd8Y=", "https://vertexaisearch.cloud.google.com/grounding-api-redirect/AUZIYQFl-jTnGS118mlBl64iF6TxjrPEkUzagHpQEtUDz0ZQeenUiIWU3wkdbu79Vfvkds06GTJiGm79mxll2apsunIOm4Gt5wOehkWE-3hXn91YyruQdM2F9VCipQyW10PFoUkBYIAfZ0HbzIE=", "https://vertexaisearch.cloud.google.com/grounding-api-redirect/AUZIYQFaU6FGBVboY6qWaOCubeal5HD2cMdWLfsr5n_uwWXuOoTxWCRBj3ahnYJuvP4BObkfE2dR39k-qGpobqIt5PKaJpfzLDF9ghJG8t5ufuHoeoiUPEofPsQiawyMqy-LOjbUJy7sZAcy94UamDzzkW0m-Yk=", "https://vertexaisearch.cloud.google.com/grounding-api-redirect/AUZIYQG_f5kNVQEz28wOV3TLz2jpp7LPo4c-L6IgGKw-L3bQeXXuVgIqVKqGkGyIc7MhWjAofxbjBRJxTdSyeOJCWz5ovQC-TIbphn7xXWcj8b_FC_-Y0z1QZvrLdlkN