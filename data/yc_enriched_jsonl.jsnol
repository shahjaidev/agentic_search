{"id": 95, "name": "Zenbox", "slug": "zenbox", "former_names": "[]", "small_logo_thumb_url": "/company/thumb/missing.png", "website": "http://zenboxapp.com", "all_locations": "San Francisco, CA, USA", "long_description": "Zenbox is a browser extension that connects all of your SaaS services.Open an email, and Zenbox pulls in your customer information from dozens of services right into the sidebar.", "one_liner": "Brings dozens of SaaS's (Mailchimp, Stripe, Shopify, Salesforce,…", "team_size": 2, "industry": "B2B", "subindustry": "B2B -> Productivity", "launched_at": 1326789268, "tags": "[\"SaaS\", \"Productivity\", \"Email\"]", "tags_highlighted": "[]", "top_company": 0, "isHiring": 0, "nonprofit": 0, "batch": "Summer 2011", "status": "Inactive", "industries": "[\"B2B\", \"Productivity\"]", "regions": "[\"United States of America\", \"America / Canada\"]", "stage": "Early", "app_video_public": 0, "demo_day_video_public": 0, "app_answers": null, "question_answers": 0, "url": "https://www.ycombinator.com/companies/zenbox", "api": "https://yc-oss.github.io/api/batches/summer-2011/zenbox.json", "founders_summary": "Zenbox is a browser extension that connects all of your SaaS services, pulling customer information from various services into the sidebar when you open an email.", "founders_sources": ["https://yc-oss.github.io/api/batches/summer-2011/zenbox.json"], "founders_raw": null}
{"id": 107, "name": "Interstate", "slug": "interstate", "former_names": "[]", "small_logo_thumb_url": "/company/thumb/missing.png", "website": "http://interstateapp.com", "all_locations": "San Francisco, CA, USA", "long_description": "BakedCode create applications which help developers and businesses, focusing on making new solutions or improving on current solutions.", "one_liner": "Create & Share Product Roadmaps", "team_size": 2, "industry": "B2B", "subindustry": "B2B -> Productivity", "launched_at": 1326789402, "tags": "[\"Productivity\"]", "tags_highlighted": "[]", "top_company": 0, "isHiring": 0, "nonprofit": 0, "batch": "Summer 2011", "status": "Inactive", "industries": "[\"B2B\", \"Productivity\"]", "regions": "[\"United States of America\", \"America / Canada\"]", "stage": "Early", "app_video_public": 0, "demo_day_video_public": 0, "app_answers": null, "question_answers": 0, "url": "https://www.ycombinator.com/companies/interstate", "api": "https://yc-oss.github.io/api/batches/summer-2011/interstate.json", "founders_summary": "Interstate is a developer of a pre-confirmation protocol for cryptocurrency transactions, aiming to enhance security and integration across decentralized applications. Their network supports rollups, preconfirmations, validator attestations, and interoperability on Ethereum. The company was founded in 2022 and is headquartered in San Francisco, CA. Investors in Interstate include Bloccelerate, MH Ventures, Native Crypto, and YTWO Ventures.", "founders_sources": ["https://vertexaisearch.cloud.google.com/grounding-api-redirect/AUZIYQH1FYDspXE8e9P-U3k4xtOTBPkWpp-m2bt1k_rUYAidyPczPVvsQxxwJUR4KJjUDDsxC6WS1A4UZz2DNOalYnkOWOMcZoH4_EqpwjZHDfApxHRLrsvoeibWzFpw9zxpnzu46UOO3zrGpRomnw=="], "founders_raw": null}
{"id": 46, "name": "BarSense", "slug": "barsense", "former_names": "[\"Kyte\"]", "small_logo_thumb_url": "/company/thumb/missing.png", "website": "http://kytephone.com", "all_locations": "Mountain View, CA, USA", "long_description": "Kyte is an easy parental control application that can be downloaded to any Android phone, activated, and then given to a child.\n\nThis app allows the child to make pre-approved phone calls and play only authorized games. The child will be unable to leave the app to access the rest of the Android phone’s features. Parents have full control over the applications from the browser and can also track the phone’s GPS online.\n\nIt has other features that enable parents to turn off SMS and Facebook during school hours, ban apps and games during school and bed time hours, monitor internet usage, prevent the usage of third party browsers, set time limits on games, check call history, track location in real-time, receive email reports about what their child has been doing, and full remote control from their phone, tablet or PC.", "one_liner": "Kid's first smartphone with web-based parental controls.", "team_size": 0, "industry": "Consumer", "subindustry": "Consumer -> Home and Personal", "launched_at": 1322045902, "tags": "[\"Kids\"]", "tags_highlighted": "[]", "top_company": 0, "isHiring": 0, "nonprofit": 0, "batch": "Winter 2012", "status": "Inactive", "industries": "[\"Consumer\", \"Home and Personal\"]", "regions": "[\"United States of America\", \"America / Canada\"]", "stage": "Early", "app_video_public": 0, "demo_day_video_public": 0, "app_answers": null, "question_answers": 0, "url": "https://www.ycombinator.com/companies/barsense", "api": "https://yc-oss.github.io/api/batches/winter-2012/barsense.json", "founders_summary": "", "founders_sources": [], "founders_raw": null}
